---
import { langOf, link } from '../i18n';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { tours } from '../lib/schema';
import { storefront } from '../lib/shopify';
import { TICKET, TICKETS_BETALEN } from '../lib/shop';
import kris from '../assets/foto/bp-brouwer.jpg';
import Gesloten from '../components/Gesloten.astro';
import gesloten from '../data/gesloten.json';

const lang = langOf(Astro.url);
const en = lang === 'en';
const tr = (nl: string, enText: string) => (en ? enText : nl);
const L = (href: string) => link(lang, href);

// Every Sunday tour is a variant of the Shopify product "rondleiding" (Datum + Rondleiding),
// each with 25 places. The page loads them at build time and refreshes them live in the browser.
type Slot = { id: string; datum: string; uur: string; taal: 'en' | 'nl'; vrij: number };
const QUERY = `query { product(handle: "${TICKET}") { variants(first: 250) { nodes { id availableForSale quantityAvailable selectedOptions { name value } } } } }`;
let slots: Slot[] = [];
try {
  const data = await storefront<{ product: { variants: { nodes: any[] } } | null }>(QUERY);
  slots = (data.product?.variants.nodes ?? []).map((v) => {
    const opt = (n: string) => v.selectedOptions.find((o: any) => o.name === n)?.value ?? '';
    const r = opt('Rondleiding');
    return { id: v.id, datum: opt('Datum'), uur: r.slice(0, 5), taal: r.includes('Engels') ? 'en' : 'nl', vrij: v.availableForSale ? v.quantityAvailable ?? 25 : 0 };
  });
} catch (e) {
  console.warn('Rondleidingen niet geladen', e);
}
---

<Base
  title={tr('Rondleiding boeken | Brouwerij De Dolle Brouwers, Esen, Diksmuide', 'Book a brewery tour | De Dolle Brouwers, Esen, Belgium')}
  description={tr(
    'Boek je rondleiding bij brouwerij De Dolle Brouwers in Esen, Diksmuide. Elke zondag om 14u (Engels) of 15u (Nederlands), met Kris Herteleer als gids en drie proevertjes van het vat. €10 per persoon.',
    'Book your brewery tour at De Dolle Brouwers in Esen, Belgium. Every Sunday at 2 pm in English (3 pm in Dutch), with Kris Herteleer as your guide and three tastings from the cask. €10 per person.',
  )}
  image={kris}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(tours(lang))} />
  </Fragment>

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="hand">{tr('Rondleiding · elke zondag', 'Brewery tour · every Sunday')}</p>
        <h1>{tr('Boek je zondag bij De Dolle Brouwers.', 'Book your Sunday at De Dolle Brouwers.')}</h1>
        <p class="lead">
          {
            tr(
              'Drie kwartier door een werkende brouwerij, met Kris Herteleer zelf, brouwer en oprichter, als gids. Nadien proef je drie bieren rechtstreeks van het vat.',
              'Forty-five minutes through a working brewery, with Kris Herteleer himself, brewer and founder, as your guide. Afterwards you taste three beers straight from the cask.',
            )
          }
        </p>
        <ul class="facts">
          <li><b>45'</b> {tr('rondleiding', 'tour')}</li>
          <li><b>3×</b> {tr('proevertje van het vat', 'tasting from the cask')}</li>
          <li><b>€10</b> {tr('per persoon', 'per person')}</li>
        </ul>
      </div>
      <Image src={kris} alt={tr('Brouwer aan het werk bij de roerkuip', 'Brewer at work by the mash tun')} width={700} class="hero-img" loading="eager" />
    </div>
    <div class="edge-bottom"></div>
  </section>

  <section class="section">
    <div class="wrap">
      <form class="card boek" id="boek" data-slots={JSON.stringify(slots)} data-betalen={TICKETS_BETALEN ? '1' : ''} data-gesloten={JSON.stringify(gesloten.map((g) => g.datum))}>
        <Gesloten />
        <fieldset>
          <legend><span class="num">1</span>{tr('Kies een zondag', 'Pick a Sunday')}</legend>
          <div class="dagen" id="dagen"></div>
          <p class="hint">{tr('Zondagen tijdens onze kerstsluiting (22 december – 18 januari) worden niet getoond.', 'Sundays during our Christmas closure (22 December – 18 January) are not shown.')}</p>
        </fieldset>

        <fieldset>
          <legend><span class="num">2</span>{tr('Kies je rondleiding', 'Pick your tour')}</legend>
          <div class="uren">
            <label class="uur">
              <input type="radio" name="taal" value="en" />
              <span>
                <b>{tr('14u · Engels', '2 pm · English')}</b>
                <small data-vrij="en"></small>
              </span>
            </label>
            <label class="uur">
              <input type="radio" name="taal" value="nl" />
              <span>
                <b>{tr('15u · Nederlands', '3 pm · Dutch')}</b>
                <small data-vrij="nl"></small>
              </span>
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend><span class="num">3</span>{tr('Met hoeveel kom je?', 'How many of you?')}</legend>
          <div class="aantal">
            <button type="button" data-stap="-1" aria-label={tr('Eén minder', 'One less')}>−</button>
            <output id="aantal">2</output>
            <button type="button" data-stap="1" aria-label={tr('Eén meer', 'One more')}>+</button>
            <span class="pp">× €10</span>
          </div>
          {
            !TICKETS_BETALEN && (
              <div class="velden">
                <label>
                  {tr('Naam', 'Name')}
                  <input name="naam" autocomplete="name" required />
                </label>
                <label>
                  {tr('E-mailadres', 'Email address')}
                  <input name="email" type="email" autocomplete="email" required />
                </label>
              </div>
            )
          }
        </fieldset>

        <div class="totaal">
          <p id="samenvatting">{tr('Kies eerst een zondag en een rondleiding.', 'First pick a Sunday and a tour.')}</p>
          <p class="prijs" id="prijs">€20</p>
        </div>
        <button class="btn dark groot" type="submit" id="knop" disabled>
          {TICKETS_BETALEN ? tr('Betaal en boek →', 'Pay and book →') : tr('Reserveer mijn plaats →', 'Reserve my spot →')}
        </button>
        <p class="status" id="status" role="status"></p>

        <ul class="kleine-lettertjes">
          {
            TICKETS_BETALEN ? (
              <li>{tr('Je betaalt meteen online en krijgt een bevestiging per e-mail.', 'You pay online right away and get a confirmation by email.')}</li>
            ) : (
              <li>{tr('Je reserveert met een e-mail naar de brouwerij en betaalt ter plaatse in de Oerbar.', 'You reserve with an email to the brewery and pay on the spot in the Oerbar.')}</li>
            )
          }
          <li>{tr('Geen terugbetaling bij annulering of als je niet komt.', 'No refunds for cancellations or no-shows.')}</li>
          <li>{tr('Liever niet boeken? Kom gewoon af en koop ter plaatse een ticket, zolang er plaats is.', "Rather not book? Just turn up and buy a ticket on the spot, while there's room.")}</li>
          <li>
            {tr('Kom je met 20 of meer? Laat het ons even weten via', 'Coming with 20 or more? Let us know at')}{' '}
            <a href="mailto:info@dedollebrouwers.be">info@dedollebrouwers.be</a>{tr(', dan regelen we het.', " and we'll sort it out.")}
          </li>
        </ul>
      </form>
      <p class="meer">
        {tr('Nog vragen?', 'More questions?')} <a href={L('/faq')}>{tr('Bekijk de veelgestelde vragen', 'Read the FAQ')}</a>{' '}
        {tr('of', 'or')}{' '} <a href={L('/brouwerij')}>{tr('lees alles over je bezoek', 'read all about your visit')}</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  import { addToCart, getCart } from '../lib/cart';
  import { storefront } from '../lib/shopify';

  type Slot = { id: string; datum: string; uur: string; taal: 'en' | 'nl'; vrij: number };
  const EN = document.documentElement.lang === 'en';
  const form = document.getElementById('boek') as HTMLFormElement;
  const dagen = document.getElementById('dagen')!;
  const aantalEl = document.getElementById('aantal')!;
  const samenvatting = document.getElementById('samenvatting')!;
  const prijs = document.getElementById('prijs')!;
  const knop = document.getElementById('knop') as HTMLButtonElement;
  const status = document.getElementById('status')!;
  const betalen = !!form.dataset.betalen;
  const dicht: string[] = JSON.parse(form.dataset.gesloten || '[]');
  let slots: Slot[] = JSON.parse(form.dataset.slots || '[]').map((s: Slot) => (dicht.includes(s.datum) ? { ...s, vrij: 0 } : s));
  let datum = '';
  let aantal = 2;

  // Booking closes on the Sunday itself at noon (Brussels time).
  const nuBrussel = () =>
    new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Brussels', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' })
      .format(new Date())
      .replace(',', '');
  const open = (d: string) => `${d} 12:00` > nuBrussel();
  const lokaal = (d: string, opts: Intl.DateTimeFormatOptions) => new Date(`${d}T12:00:00`).toLocaleDateString(EN ? 'en-GB' : 'nl-BE', opts);
  const slot = (d: string, taal: string) => slots.find((s) => s.datum === d && s.taal === taal);
  const taal = () => (form.querySelector<HTMLInputElement>('input[name="taal"]:checked')?.value ?? '') as 'en' | 'nl' | '';

  const tekenDagen = () => {
    const lijst = [...new Set(slots.filter((s) => open(s.datum)).map((s) => s.datum))].sort().slice(0, 10);
    if (!lijst.includes(datum)) datum = lijst.find((d) => slots.some((s) => s.datum === d && s.vrij > 0)) ?? '';
    dagen.innerHTML = lijst.length
      ? lijst
          .map((d) => {
            const vrij = slots.filter((s) => s.datum === d).reduce((n, s) => n + s.vrij, 0);
            return `<button type="button" class="dag${d === datum ? ' on' : ''}" data-datum="${d}" ${vrij ? '' : 'disabled'}>
              <small>${lokaal(d, { weekday: 'short' })}</small><b>${lokaal(d, { day: 'numeric' })}</b><small>${lokaal(d, { month: 'short' })}</small>
              ${vrij ? '' : `<em>${dicht.includes(d) ? (EN ? 'closed' : 'gesloten') : EN ? 'full' : 'volzet'}</em>`}</button>`;
          })
          .join('')
      : `<p class="hint">${EN ? 'Online booking is not available right now. Just come by on Sunday, or email info@dedollebrouwers.be.' : 'Online boeken lukt nu even niet. Kom gewoon af op zondag, of mail naar info@dedollebrouwers.be.'}</p>`;
  };

  const teken = () => {
    form.querySelectorAll<HTMLInputElement>('input[name="taal"]').forEach((r) => {
      const s = slot(datum, r.value);
      const vrij = s?.vrij ?? 0;
      r.disabled = !vrij;
      if (!vrij && r.checked) r.checked = false;
      const label = form.querySelector(`[data-vrij="${r.value}"]`)!;
      label.textContent = !s ? '' : vrij ? (EN ? `${vrij} places left` : `nog ${vrij} plaatsen`) : dicht.includes(datum) ? (EN ? 'Closed' : 'Gesloten') : EN ? 'Full' : 'Volzet';
    });
    const s = taal() ? slot(datum, taal()) : undefined;
    const max = Math.min(s?.vrij ?? 25, 19);
    aantal = Math.max(1, Math.min(aantal, max));
    aantalEl.textContent = String(aantal);
    prijs.textContent = `€${aantal * 10}`;
    if (s && datum) {
      const dag = lokaal(datum, { weekday: 'long', day: 'numeric', month: 'long' });
      const wie = EN ? `${aantal} ${aantal === 1 ? 'person' : 'people'}` : `${aantal} ${aantal === 1 ? 'persoon' : 'personen'}`;
      samenvatting.innerHTML = EN
        ? `<b>${dag}</b>, ${s.taal === 'en' ? '2 pm in English' : '3 pm in Dutch'} · ${wie}`
        : `<b>${dag}</b>, ${s.taal === 'en' ? '14u in het Engels' : '15u in het Nederlands'} · ${wie}`;
      knop.disabled = false;
    } else {
      samenvatting.textContent = EN ? 'First pick a Sunday and a tour.' : 'Kies eerst een zondag en een rondleiding.';
      knop.disabled = true;
    }
  };

  dagen.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-datum]');
    if (!b) return;
    datum = b.dataset.datum!;
    dagen.querySelectorAll('.dag').forEach((x) => x.classList.toggle('on', x === b));
    teken();
  });
  form.addEventListener('change', teken);
  form.querySelectorAll<HTMLButtonElement>('[data-stap]').forEach((b) =>
    b.addEventListener('click', () => {
      aantal += Number(b.dataset.stap);
      teken();
    }),
  );

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const s = slot(datum, taal());
    if (!s) return;
    const dag = lokaal(datum, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const uur = s.taal === 'en' ? (EN ? '2 pm (English)' : '14u (Engels)') : EN ? '3 pm (Dutch)' : '15u (Nederlands)';
    if (!betalen) {
      const v = (n: string) => (form.elements.namedItem(n) as HTMLInputElement).value.trim();
      if (!v('naam') || !v('email')) {
        status.textContent = EN ? 'Please fill in your name and email.' : 'Vul je naam en e-mailadres in.';
        return;
      }
      const onderwerp = EN ? `Tour booking ${dag} ${uur}` : `Boeking rondleiding ${dag} ${uur}`;
      const tekst = EN
        ? `Hello,\n\nI would like to book a brewery tour:\n\nDate: ${dag}\nTime: ${uur}\nNumber of people: ${aantal}\n\nName: ${v('naam')}\nEmail: ${v('email')}\n\nSee you then!`
        : `Hallo,\n\nIk wil graag een rondleiding boeken:\n\nDatum: ${dag}\nUur: ${uur}\nAantal personen: ${aantal}\n\nNaam: ${v('naam')}\nE-mail: ${v('email')}\n\nTot dan!`;
      location.href = `mailto:info@dedollebrouwers.be?subject=${encodeURIComponent(onderwerp)}&body=${encodeURIComponent(tekst)}`;
      return;
    }
    knop.disabled = true;
    status.textContent = EN ? 'One moment…' : 'Even geduld…';
    try {
      await addToCart(s.id, aantal, [
        { key: 'Rondleiding', value: `${dag}, ${uur}` },
        { key: 'Aantal personen', value: String(aantal) },
      ]);
      const cart = getCart()!;
      location.href = EN ? cart.checkoutUrl + (cart.checkoutUrl.includes('?') ? '&' : '?') + 'locale=en' : cart.checkoutUrl;
    } catch {
      status.textContent = EN
        ? 'That did not work, maybe the tour just filled up. Please try another time.'
        : 'Dat lukte niet, misschien is de rondleiding net volzet. Probeer een ander moment.';
      knop.disabled = false;
      verversen();
    }
  });

  // Places can be booked after the site was built: fetch the live numbers.
  const verversen = () =>
    storefront<{ product: { variants: { nodes: any[] } } | null }>(
      `query { product(handle: "rondleiding") { variants(first: 250) { nodes { id availableForSale quantityAvailable selectedOptions { name value } } } } }`,
    )
      .then((data) => {
        const live = new Map((data.product?.variants.nodes ?? []).map((v) => [v.id, v.availableForSale ? v.quantityAvailable ?? 25 : 0]));
        slots = slots.map((s) => ({ ...s, vrij: dicht.includes(s.datum) ? 0 : live.get(s.id) ?? s.vrij }));
        tekenDagen();
        teken();
      })
      .catch(() => {});

  tekenDagen();
  teken();
  verversen();
</script>

<style>
  .hero {
    position: relative;
    background: var(--yellow) var(--grain);
    padding: clamp(36px, 6vw, 70px) 0 clamp(60px, 8vw, 100px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 0.95;
    margin: 6px 0 18px;
  }
  .hero .lead {
    max-width: 32em;
  }
  .facts {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .facts li {
    background: var(--paper-light);
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.35em 0.9em;
    font-size: 0.95rem;
  }
  .facts b {
    font-family: var(--font-display);
    margin-right: 4px;
  }
  .hero :global(.hero-img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
    transform: rotate(2deg);
  }

  .boek {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(22px, 4vw, 40px);
    display: grid;
    gap: 28px;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }
  legend {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 1.6em;
    height: 1.6em;
    border-radius: 50%;
    background: var(--yellow);
    border: 2px solid var(--ink);
    font-size: 0.9rem;
  }
  .hint {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .dagen {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(78px, 1fr));
    gap: 8px;
  }
  .dagen :global(.dag) {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 10px 4px;
    border: 2px solid var(--ink);
    border-radius: 12px;
    background: var(--paper);
    font: inherit;
    cursor: pointer;
    color: var(--ink);
  }
  .dagen :global(.dag b) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
  }
  .dagen :global(.dag small) {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .dagen :global(.dag em) {
    font-size: 0.7rem;
    color: #b3261e;
    font-style: normal;
    font-weight: 700;
  }
  .dagen :global(.dag.on) {
    background: var(--yellow);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .dagen :global(.dag:disabled) {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .uren {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .uur input {
    position: absolute;
    opacity: 0;
  }
  .uur span {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 2px solid var(--ink);
    border-radius: 12px;
    background: var(--paper);
    cursor: pointer;
  }
  .uur b {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .uur small {
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .uur input:checked + span {
    background: var(--yellow);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .uur input:focus-visible + span {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .uur input:disabled + span {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .aantal {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .aantal button {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--paper-light);
    font: inherit;
    font-size: 1.4rem;
    font-weight: 700;
    cursor: pointer;
  }
  .aantal output {
    font-family: var(--font-display);
    font-size: 2rem;
    min-width: 1.5em;
    text-align: center;
  }
  .pp {
    color: var(--ink-soft);
  }
  .velden {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 6px;
  }
  .velden label {
    display: grid;
    gap: 5px;
    font-weight: 600;
    font-size: 0.85rem;
  }
  .velden input {
    font: inherit;
    font-weight: 400;
    padding: 0.6em 0.8em;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--paper);
    min-width: 0;
  }
  .totaal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    background: var(--ink);
    color: var(--paper-light);
    border-radius: 14px;
    padding: 16px 20px;
  }
  .totaal p {
    margin: 0;
  }
  .totaal .prijs {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--yellow);
  }
  .groot {
    width: 100%;
    font-size: 1.1rem;
    padding: 0.9em;
  }
  .groot:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }
  .status {
    margin: -14px 0 0;
    font-weight: 600;
    min-height: 1.2em;
  }
  .kleine-lettertjes {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 4px;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .meer {
    text-align: center;
    margin-top: 28px;
  }
  @media (max-width: 760px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero :global(.hero-img) {
      max-width: 360px;
    }
  }
  @media (max-width: 520px) {
    .uren,
    .velden {
      grid-template-columns: 1fr;
    }
  }
</style>
