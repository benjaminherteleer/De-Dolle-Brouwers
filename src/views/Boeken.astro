---
import { langOf, link } from '../i18n';
import { tours } from '../lib/schema';
import Base from '../layouts/Base.astro';
const lang = langOf(Astro.url);
const en = lang === 'en';
const tr = (nl: string, enText: string) => (en ? enText : nl);
const L = (href: string) => link(lang, href);
---

<Base title={tr("Rondleiding boeken | Brouwerij De Dolle Brouwers, Esen, Diksmuide", "Book a brewery tour | De Dolle Brouwers, Esen, Belgium")} description={tr("Boek een rondleiding bij brouwerij De Dolle Brouwers in Esen, Diksmuide. Elke zondag om 14u (Engels) of 15u (Nederlands), gegeven door brouwer en oprichter Kris Herteleer. €10 per persoon, ter plaatse te betalen.", "Book a brewery tour at De Dolle Brouwers in Esen, Belgium. Every Sunday at 2 pm in English (3 pm in Dutch), given by brewer and founder Kris Herteleer. €10 per person, paid on the spot.")}>
<Fragment slot="head">
<script type="application/ld+json" is:inline set:html={JSON.stringify(tours(lang))} />

</Fragment>

<header class="page-hero">
  <div class="wrap">
    <span class="kicker-hand">{tr("Rondleiding", "Brewery tour")}</span>
    <h1>{tr("Boek je zondag bij De Dolle Brouwers.", "Book your Sunday at De Dolle Brouwers.")}</h1>
    <p>{tr("Drie kwartier door een werkende brouwerij, met Kris Herteleer zelf — brouwer en oprichter — als gids. Nadien proef je drie glaasjes rechtstreeks van het vat. Kies hieronder je datum en taal.", "Forty-five minutes through a working brewery, with Kris Herteleer himself — brewer and founder — as your guide. Afterwards you taste three glasses straight from the cask. Pick your date and language below.")}</p>
  </div>
</header>

<section>
  <div class="wrap">

    <div class="info-grid">
      <div class="info-card"><span class="num">45'</span><h4>{tr("Duur", "Duration")}</h4><p>{tr("Ongeveer drie kwartier, door de volledige brouwerij.", "About 45 minutes, through the whole brewery.")}</p></div>
      <div class="info-card"><span class="num">Kris</span><h4>{tr("Je gids", "Your guide")}</h4><p>{tr("Gegeven door de brouwer en oprichter zelf.", "Given by the brewer and founder himself.")}</p></div>
      <div class="info-card"><span class="num">3×</span><h4>{tr("Proeverij", "Tasting")}</h4><p>{tr("Drie tasting-glaasjes, rechtstreeks van het vat.", "Three tasting glasses, straight from the cask.")}</p></div>
      <div class="info-card"><span class="num">€10</span><h4>{tr("Per persoon", "Per person")}</h4><p>{tr("Ter plaatse te betalen — nu nog niets afrekenen.", "Paid on the spot — nothing to pay now.")}</p></div>
    </div>

    <span class="step-label">{tr("Stap 1 — Kies een zondag", "Step 1 — Pick a Sunday")}</span>
    <p style="font-size:13px; color:#6b5a3a; margin:-8px 0 16px;">{tr("Zondagen tijdens onze kerstsluiting (22 december – 18 januari) worden hier niet getoond.", "Sundays during our Christmas closure (22 December – 18 January) are not shown.")}</p>
    <div class="date-grid" id="dateGrid"></div>

    <span class="step-label">{tr("Stap 2 — Kies je rondleiding", "Step 2 — Pick your tour")}</span>
    <div class="time-grid">
      <div class="time-card" data-time="14:00" data-lang="Engels" onclick="selectTime(this)">
        <span class="flag">🇬🇧</span>
        <h3>{tr("14:00 — Engels", "2 pm — English")}</h3>
        <p>{tr("Rondleiding in het Engels, ideaal voor internationale bezoekers.", "Tour in English, ideal for international visitors.")}</p>
      </div>
      <div class="time-card" data-time="15:00" data-lang="Nederlands" onclick="selectTime(this)">
        <span class="flag">🇧🇪</span>
        <h3>{tr("15:00 — Nederlands", "3 pm — Dutch")}</h3>
        <p>{tr("Rondleiding in het Nederlands, onze standaard zondagse rondleiding.", "Tour in Dutch, our regular Sunday tour.")}</p>
      </div>
    </div>

    <span class="step-label">{tr("Stap 3 — Jouw gegevens", "Step 3 — Your details")}</span>
    <div class="form-grid">
      <div class="form-field">
        <label for="naam">{tr("Naam", "Name")}</label>
        <input type="text" id="naam" placeholder={tr("Voor- en achternaam", "First and last name")}>
      </div>
      <div class="form-field">
        <label for="email">{tr("E-mailadres", "Email address")}</label>
        <input type="email" id="email" placeholder={tr("jij@email.be", "you@email.com")}>
      </div>
      <div class="form-field">
        <label for="aantal">{tr("Aantal personen", "Number of people")}</label>
        <input type="number" id="aantal" min="1" max="19" value="2">
      </div>
      <div class="form-field">
        <label for="telefoon">{tr("Telefoonnummer (optioneel)", "Phone number (optional)")}</label>
        <input type="tel" id="telefoon" placeholder={tr("04xx xx xx xx", "+44 …")}>
      </div>
    </div>

    <div class="summary-bar">
      <div class="summary-text" id="summaryText">{tr("Kies hierboven eerst een datum en een rondleiding.", "First pick a date and a tour above.")}</div>
      <div class="price" id="summaryPrice">—</div>
    </div>

    <button class="book-btn" id="bookBtn" disabled onclick="submitBooking()">{tr("Kies eerst een datum en rondleiding", "First pick a date and tour")}</button>
    <p class="pay-note">{tr("Dit reserveert je plaats via e-mail naar de brouwerij — je betaalt pas ter plaatse, in de Oerbar. Groepen vanaf 20 personen: mail rechtstreeks naar", "This reserves your spot with an email to the brewery — you only pay on the spot, in the Oerbar. Groups of 20 or more: email")} <a href="mailto:info@dedollebrouwers.be" style="font-weight:700; border-bottom:1px solid var(--ink);">info@dedollebrouwers.be</a>.</p>

  </div>
</section>



<script is:inline>
  const EN = document.documentElement.lang === 'en';
  const maanden = EN
    ? ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
    : ["jan","feb","mrt","apr","mei","jun","jul","aug","sep","okt","nov","dec"];
  const dagen = ["zo","ma","di","wo","do","vr","za"];

  let selectedDate = null;
  let selectedTime = null;
  let selectedLang = null;

  function isClosedDate(d){
    const month = d.getMonth(); // 0 = jan, 11 = dec
    const day = d.getDate();
    if(month === 11 && day >= 22) return true; // 22-31 december
    if(month === 0 && day <= 18) return true;  // 1-18 januari
    return false;
  }

  function buildDates(){
    const grid = document.getElementById('dateGrid');
    const today = new Date();
    let count = 0;
    let d = new Date(today);
    let safety = 0;
    while(count < 8 && safety < 400){
      d.setDate(d.getDate() + 1);
      safety++;
      if(d.getDay() === 0 && !isClosedDate(d)){ // Sunday, niet tijdens kerstsluiting
        const chip = document.createElement('div');
        chip.className = 'date-chip';
        chip.innerHTML = `<span class="dow">${EN ? 'Sunday' : 'zondag'}</span><span class="dom">${d.getDate()}</span><span class="mon">${maanden[d.getMonth()]}</span>`;
        const dateCopy = new Date(d);
        chip.onclick = () => selectDate(chip, dateCopy);
        grid.appendChild(chip);
        count++;
      }
    }
  }

  function selectDate(chip, dateObj){
    document.querySelectorAll('.date-chip').forEach(c => c.classList.remove('selected'));
    chip.classList.add('selected');
    selectedDate = dateObj;
    updateSummary();
  }

  function selectTime(card){
    document.querySelectorAll('.time-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    selectedTime = card.dataset.time;
    selectedLang = EN ? (card.dataset.lang === 'Engels' ? 'English' : 'Dutch') : card.dataset.lang;
    updateSummary();
  }

  function formatDate(d){
    return EN ? `Sunday ${d.getDate()} ${maanden[d.getMonth()]} ${d.getFullYear()}` : `zondag ${d.getDate()} ${maanden[d.getMonth()]} ${d.getFullYear()}`;
  }

  function updateSummary(){
    const btn = document.getElementById('bookBtn');
    const text = document.getElementById('summaryText');
    const price = document.getElementById('summaryPrice');
    const aantal = document.getElementById('aantal').value || 1;

    if(selectedDate && selectedTime){
      text.innerHTML = EN
        ? `Tour on <strong>${formatDate(selectedDate)}</strong> — ${selectedTime} (${selectedLang}), for ${aantal} ${aantal == 1 ? 'person' : 'people'}.`
        : `Rondleiding op <strong>${formatDate(selectedDate)}</strong> — ${selectedTime} (${selectedLang}), voor ${aantal} perso(o)n(en).`;
      price.textContent = `€${10 * aantal}`;
      btn.disabled = false;
      btn.textContent = EN ? 'Confirm your booking' : 'Bevestig je boeking';
    } else {
      text.textContent = EN ? 'First pick a date and a tour above.' : 'Kies hierboven eerst een datum en een rondleiding.';
      price.textContent = '—';
      btn.disabled = true;
      btn.textContent = EN ? 'First pick a date and tour' : 'Kies eerst een datum en rondleiding';
    }
  }

  document.getElementById('aantal').addEventListener('input', updateSummary);

  function submitBooking(){
    if(!selectedDate || !selectedTime) return;
    const naam = document.getElementById('naam').value || (EN ? '(no name given)' : '(naam niet ingevuld)');
    const email = document.getElementById('email').value || (EN ? '(no email given)' : '(email niet ingevuld)');
    const aantal = document.getElementById('aantal').value || 1;
    const telefoon = document.getElementById('telefoon').value || '-';

    const subject = EN ? `Tour booking ${formatDate(selectedDate)} — ${selectedTime}` : `Boeking rondleiding ${formatDate(selectedDate)} — ${selectedTime}`;
    const body = EN
      ? `Hello,\n\nI would like to book a brewery tour:\n\nDate: ${formatDate(selectedDate)}\nTime: ${selectedTime} (${selectedLang})\nNumber of people: ${aantal}\n\nName: ${naam}\nEmail: ${email}\nPhone: ${telefoon}\n\nSee you then!`
      : `Hallo,\n\nIk wil graag een rondleiding boeken:\n\nDatum: ${formatDate(selectedDate)}\nUur: ${selectedTime} (${selectedLang})\nAantal personen: ${aantal}\n\nNaam: ${naam}\nE-mail: ${email}\nTelefoon: ${telefoon}\n\nTot dan!`;

    window.location.href = `mailto:info@dedollebrouwers.be?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  }

  buildDates();
</script>
</Base>

<style is:global>
  header.page-hero{background:var(--yellow); padding:56px 0;}
  header.page-hero .tag{font-size:13.5px; font-weight:700; color:var(--ink); display:block; margin-bottom:12px;}
  header.page-hero h1{font-size:clamp(32px,4.5vw,50px); max-width:640px;}
  header.page-hero p{font-size:16px; max-width:560px; margin-top:16px; color:#3a2c10;}
  section{padding:56px 0;}
  .info-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-bottom:56px;}
  .info-card{background:var(--white); border-radius:16px; padding:24px 20px;}
  .info-card .num{font-family:var(--font-display); font-style:italic; color:var(--rust); font-size:22px; display:block; margin-bottom:8px;}
  .info-card h4{font-size:14.5px; margin-bottom:6px;}
  .info-card p{font-size:13px; color:#6b5a3a; margin:0;}
@media(max-width:760px){
  .info-grid{grid-template-columns:repeat(2,1fr);}
  }
  .step-label{font-size:13.5px; font-weight:700; color:var(--rust); display:block; margin-bottom:14px;}
  .date-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:48px;}
  .date-chip{
    background:var(--white); border:2px solid transparent; border-radius:14px; padding:16px 8px;
    text-align:center; cursor:pointer; font-family:var(--font-body); transition:border-color .15s ease;
  }
  .date-chip .dow{display:block; font-size:12px; font-weight:700; color:#6b5a3a; text-transform:uppercase; letter-spacing:0.4px;}
  .date-chip .dom{display:block; font-family:var(--font-display); font-weight:700; font-size:24px; margin-top:4px;}
  .date-chip .mon{display:block; font-size:11.5px; color:#6b5a3a;}
  .date-chip:hover{border-color:var(--yellow-deep);}
  .date-chip.selected{background:var(--ink); border-color:var(--ink);}
  .date-chip.selected .dow, .date-chip.selected .mon{color:#cbbe97;}
  .date-chip.selected .dom{color:var(--yellow);}
@media(max-width:700px){
  .date-grid{grid-template-columns:repeat(3,1fr);}
  }
@media(max-width:460px){
  .date-grid{grid-template-columns:repeat(2,1fr);}
  }
  .time-grid{display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:48px;}
  .time-card{
    background:var(--white); border:2px solid transparent; border-radius:16px; padding:26px; cursor:pointer;
    transition:border-color .15s ease;
  }
  .time-card:hover{border-color:var(--yellow-deep);}
  .time-card.selected{border-color:var(--ink); background:var(--yellow-pale);}
  .time-card .flag{font-size:26px; margin-bottom:10px; display:block;}
  .time-card h3{font-size:20px; margin-bottom:6px;}
  .time-card p{font-size:13.5px; color:#6b5a3a; margin:0;}
@media(max-width:600px){
  .time-grid{grid-template-columns:1fr;}
  }
  .form-grid{display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px;}
  .form-field{display:flex; flex-direction:column; gap:6px;}
  .form-field label{font-size:13px; font-weight:600; color:#6b5a3a;}
  .form-field input{
    border:2px solid #e4d9bd; border-radius:10px; padding:12px 14px; font-size:15px;
    font-family:var(--font-body); background:var(--white); color:var(--ink);
  }
  .form-field input:focus{outline:none; border-color:var(--yellow-deep);}
  .form-field.full{grid-column:1/-1;}
@media(max-width:600px){
  .form-grid{grid-template-columns:1fr;}
  }
  .summary-bar{
    background:var(--ink); color:var(--yellow-pale); border-radius:16px; padding:26px 30px;
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; margin-bottom:24px;
  }
  .summary-bar .summary-text{font-size:14.5px; line-height:1.5;}
  .summary-bar .summary-text strong{color:var(--yellow); font-family:var(--font-display); font-size:17px;}
  .summary-bar .price{font-family:var(--font-display); font-size:26px; font-weight:700; color:var(--yellow); white-space:nowrap;}
  .book-btn{
    display:inline-block; width:100%; text-align:center; background:var(--rust); color:var(--white);
    text-decoration:none; padding:17px 30px; border-radius:30px; font-weight:700; font-size:16px;
    border:none; cursor:pointer; font-family:var(--font-body);
  }
  .book-btn:disabled{background:#d8cdae; color:#a99a72; cursor:not-allowed;}
  .pay-note{text-align:center; font-size:13px; color:#6b5a3a; margin-top:14px;}

  /* new look */
  header.page-hero{background:var(--yellow) var(--grain); padding:clamp(48px,7vw,90px) 0;}
  header.page-hero h1{font-size:clamp(2.8rem,6.5vw,5.2rem); max-width:14em;}
  .kicker-hand, .section-tag{ display:block; font-family:var(--font-hand); font-size:1.6rem; color:var(--rust); transform:rotate(-2deg); width:fit-content; margin-bottom:10px;}
  header.page-hero .kicker-hand{color:var(--ink);}
  header.page-hero p{font-size:1.15rem; color:var(--ink);}
  section p{font-size:1.02rem; color:var(--ink-soft);}
  .value-card, details.faq-item, .contact-card{background:var(--paper-light); border:var(--line); box-shadow:var(--shadow);}
  details.faq-item summary{font-family:var(--font-display); font-weight:800; font-size:1.2rem;}
  details.faq-item summary::after{font-family:var(--font-hand); font-size:1.8rem; line-height:.8;}
  .wrap{max-width:var(--wrap);}
</style>
