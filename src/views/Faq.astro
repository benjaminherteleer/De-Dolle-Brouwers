---
import { langOf, link } from '../i18n';
import Base from '../layouts/Base.astro';
const lang = langOf(Astro.url);
const en = lang === 'en';
const tr = (nl: string, enText: string) => (en ? enText : nl);
const L = (href: string) => link(lang, href);
const vragen = [
  { q: tr("Moet ik op voorhand reserveren voor een rondleiding?", "Do I need to book a tour in advance?"), a: tr("Dat hoeft niet. Voor de zondagse rondleiding (14u Engels, 15u Nederlands) kan je <a href=\"/rondleiding-boeken\" style=\"font-weight:700; border-bottom:1px solid var(--ink);\">hier op de site boeken</a>, of je komt gewoon af en koopt ter plaatse een ticket. Kom je met een grote groep op zondag, laat het ons dan liefst even weten.", "No need. For the Sunday tour (2 pm English, 3 pm Dutch) you can <a href=\"/en/book-a-tour\" style=\"font-weight:700; border-bottom:1px solid var(--ink);\">book here on the site</a>, or just turn up and buy a ticket on the spot. Coming with a big group on a Sunday? Please let us know beforehand.") },
  { q: tr("Mogen honden mee?", "Can I bring my dog?"), a: tr("Honden zijn hier altijd welkom, in de Oerbar en op het terras. Er lopen hier eigenlijk altijd wel een paar hondjes rond. Alleen tijdens de rondleiding door de brouwerij mogen ze niet mee.", "Dogs are always welcome here, in the Oerbar and on the terrace. There are pretty much always a few dogs around. Only during the brewery tour they can't come along.") },
  { q: tr("Is de brouwerij toegankelijk voor kinderen?", "Can children come along?"), a: tr("Kinderen zijn welkom in de Oerbar en op het terras. De rondleiding zelf gaat door een werkende brouwerij met trappen en smalle doorgangen, dus hou daar rekening mee met jonge kinderen.", "Children are welcome in the Oerbar and on the terrace. The tour itself goes through a working brewery with stairs and narrow passages, so keep that in mind with young children.") },
  { q: tr("Hoe kan ik betalen in de Oerbar?", "How can I pay in the Oerbar?"), a: tr("Cash of met Payconiq.", "Cash or with Payconiq.") },
  { q: tr("We komen met een grote groep — kan dat?", "We're coming with a large group — is that possible?"), a: tr("Groepen vanaf 20 personen boeken we op afspraak, ook doordeweeks. Mail naar info@dedollebrouwers.be met de gewenste datum en groepsgrootte, dan bekijken we de mogelijkheden.", "Groups of 20 or more are booked by appointment, also on weekdays. Email info@dedollebrouwers.be with the date you'd like and the size of your group, and we'll see what's possible.") },
  { q: tr("Kan ik bier kopen om mee naar huis te nemen?", "Can I buy beer to take home?"), a: tr("Ja, in de Oerbar kan je flessen van het volledige gamma kopen, inclusief de Reserva-bieren zolang de voorraad strekt. Je vindt er ook onze glazen en merchandise, zoals truien, T-shirts, petten en het Oerbier-mannetje. Handig als je nog een leuk cadeautje zoekt, bijvoorbeeld voor Vaderdag.", "Yes, in the Oerbar you can buy bottles of the whole range, including the Reserva beers while stocks last. You'll also find our glasses and merchandise, like hoodies, T-shirts, caps and the Oerbier figure. Handy if you're looking for a nice gift, for Father's Day for example.") },
  { q: tr("Zijn rondleidingen ook in het Engels mogelijk?", "Are tours available in English?"), a: tr("Zeker. Elke zondag is er een rondleiding om 14u in het Engels en om 15u in het Nederlands. Er komen altijd veel internationale bezoekers naar de brouwerij.", "Absolutely. Every Sunday there's a tour at 2 pm in English and at 3 pm in Dutch. Lots of international visitors come to the brewery.") },
];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: vragen.map((v) => ({ '@type': 'Question', name: v.q, acceptedAnswer: { '@type': 'Answer', text: v.a.replace(/<[^>]+>/g, '') } })),
};
---

<Base title={tr("Veelgestelde vragen over je bezoek | De Dolle Brouwers, Esen", "FAQ: visiting the brewery | De Dolle Brouwers, Esen, Belgium")} description={tr("Antwoorden op veelgestelde vragen over een bezoek aan De Dolle Brouwers in Esen: rondleidingen, honden, kinderen, groepen en betalen.", "Answers to frequently asked questions about visiting De Dolle Brouwers in Esen, Belgium: tours in English, dogs, children, groups and payment.")}>
<Fragment slot="head">
<script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />

</Fragment>

<header class="page-hero">
  <div class="wrap">
    <span class="kicker-hand">{tr("Veelgestelde vragen", "Frequently asked questions")}</span>
    <h1>{tr("Alles wat je wil weten voor je langskomt.", "Everything you want to know before you come.")}</h1>
    <p>{tr("Staat je vraag er niet bij? Mail gerust naar", "Question not listed? Feel free to email")} <a href="mailto:info@dedollebrouwers.be" style="font-weight:700; border-bottom:2px solid var(--ink);">info@dedollebrouwers.be</a>.</p>
  </div>
</header>

<section>
  <div class="wrap" style="max-width:760px;">
    {vragen.map((v) => <details class="faq-item"><summary>{v.q}</summary><p set:html={v.a} /></details>)}
  </div>
</section>
</Base>

<style is:global>
  header.page-hero{background:var(--yellow); padding:64px 0;}
  header.page-hero .tag{font-size:13.5px; font-weight:700; color:var(--ink); display:block; margin-bottom:12px;}
  header.page-hero h1{font-size:clamp(36px,5vw,58px); max-width:680px;}
  header.page-hero p{font-size:16.5px; max-width:560px; margin-top:18px; color:#3a2c10;}
  section{padding:76px 0;}
  .section-tag{font-size:13.5px; font-weight:700; color:var(--rust); display:block; margin-bottom:12px;}
  section h2{font-size:clamp(26px,3.2vw,38px); max-width:640px; margin-bottom:18px;}
  section p{font-size:15.5px; color:#413623; max-width:640px;}
  .split{display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center;}
  .split img{width:100%; border-radius:20px; display:block;}
@media(max-width:800px){
  .split{grid-template-columns:1fr;}
  }
  .timeline{border-left:1.5px solid var(--yellow-deep); margin-left:6px; padding-left:40px;}
  .tl-item{position:relative; padding-bottom:44px;}
  .tl-item:last-child{padding-bottom:0;}
  .tl-item::before{content:""; position:absolute; left:-46px; top:4px; width:11px; height:11px; border-radius:50%; background:var(--rust); border:2px solid var(--cream); outline:1.5px solid var(--yellow-deep);}
  .tl-year{font-family:var(--font-display); font-style:italic; font-size:20px; color:var(--ink); margin-bottom:6px; display:block;}
  .tl-item p{max-width:560px; font-size:15px; color:#3f3225; margin:0;}
  .value-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:32px; margin-top:12px;}
  .value-card{background:var(--white); border-radius:16px; padding:30px;}
  .value-card h3{font-size:18px; margin-bottom:10px;}
  .value-card p{font-size:14.5px; color:#413623; margin:0;}
@media(max-width:800px){
  .value-grid{grid-template-columns:1fr;}
  }
  .process-step{display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; padding:60px 0; border-bottom:1px solid rgba(32,22,7,0.12);}
  .process-step:last-child{border-bottom:none;}
  .process-step.reverse .split-img{order:2;}
  .process-step .split-img img{width:100%; border-radius:20px;}
  .process-step .step-num{font-family:var(--font-display); font-style:italic; color:var(--rust); font-size:15px; margin-bottom:10px; display:block;}
@media(max-width:800px){
  .process-step{grid-template-columns:1fr; gap:24px; padding:36px 0;}
  .process-step.reverse .split-img{order:0;}
  }
  details.faq-item{background:var(--white); border-radius:14px; padding:22px 26px; margin-bottom:14px;}
  details.faq-item summary{font-family:var(--font-display); font-weight:700; font-size:16.5px; cursor:pointer; list-style:none;}
  details.faq-item summary::-webkit-details-marker{display:none;}
  details.faq-item summary::after{content:"+"; float:right; font-size:20px; color:var(--rust);}
  details.faq-item[open] summary::after{content:"–";}
  details.faq-item p{margin-top:14px; font-size:14.5px; color:#413623;}
  .contact-grid{display:grid; grid-template-columns:1fr 1fr; gap:56px;}
  .contact-card{background:var(--white); border-radius:20px; padding:38px;}
  .contact-card h3{font-size:13.5px; color:var(--rust); font-weight:700; margin-bottom:14px;}
  .contact-card p{font-size:15px; color:#413623; margin:6px 0;}
  .contact-card a.big-link{display:block; font-family:var(--font-display); font-size:20px; font-weight:700; color:var(--ink); text-decoration:none; border-bottom:2px solid var(--yellow); padding-bottom:2px; margin-top:10px; width:fit-content;}
  #contact-map{width:100%; height:320px; border-radius:20px; border:2px solid var(--ink);}
@media(max-width:800px){
  .contact-grid{grid-template-columns:1fr;}
  }
  .link{display:inline-block; margin-top:6px; font-weight:700; text-decoration:none; color:var(--ink); border-bottom:2px solid var(--yellow);}

  /* new look */
  header.page-hero{background:var(--yellow) var(--grain); padding:clamp(48px,7vw,90px) 0;}
  header.page-hero h1{font-size:clamp(2.8rem,6.5vw,5.2rem); max-width:14em;}
  .kicker-hand, .section-tag{ display:block; font-family:var(--font-hand); font-size:1.6rem; color:var(--rust); transform:rotate(-2deg); width:fit-content; margin-bottom:10px;}
  header.page-hero .kicker-hand{color:var(--ink);}
  header.page-hero p{font-size:1.15rem; color:var(--ink);}
  section p{font-size:1.02rem; color:var(--ink-soft);}
  .value-card, details.faq-item, .contact-card{background:var(--paper-light); border:var(--line); box-shadow:var(--shadow);}
  details.faq-item summary{font-family:var(--font-display); font-weight:800; font-size:1.2rem;}
  details.faq-item summary::after{font-family:var(--font-hand); font-size:1.8rem; line-height:.8;}
  .wrap{max-width:var(--wrap);}
</style>
