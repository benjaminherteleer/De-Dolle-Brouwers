---
import { langOf, link } from '../i18n';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Krantkop from '../components/nieuws/Krantkop.astro';
import { edities, maand, kleuren } from '../lib/nieuws';

const lang = langOf(Astro.url);
const en = lang === 'en';
const tr = (nl: string, enText: string) => (en ? enText : nl);
const L = (href: string) => link(lang, href);
const { slug } = Astro.props as { slug: string };
const lijst = await edities(lang);
const i = lijst.findIndex((e) => e.id === slug);
const editie = lijst[i];
const vorige = lijst[i - 1];
const volgende = lijst[i + 1];
const base = L('/nieuws');
const { data } = editie;
const { Content } = await render(editie);
const kleur = kleuren[data.kleur];
const url = `https://www.dedollebrouwers.be${base}/${editie.id}`;
const titelZonderPunt = data.titel.replace(/[.\s❄]+$/u, '');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titelZonderPunt,
  description: data.lead,
  datePublished: data.datum.toISOString(),
  inLanguage: en ? 'en' : 'nl-BE',
  url,
  isPartOf: { '@type': 'Blog', name: 'Oerbier Fake Nieuws', url: `https://www.dedollebrouwers.be${base}` },
  author: { '@type': 'Organization', name: 'De Dolle Brouwers' },
  publisher: { '@type': 'Organization', name: 'De Dolle Brouwers', url: 'https://www.dedollebrouwers.be' },
};
---

<Base title={`${titelZonderPunt} | Oerbier Fake Nieuws ${maand(data.datum, lang)} | De Dolle Brouwers`} description={data.lead} image={data.foto}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${titelZonderPunt} | Oerbier Fake Nieuws`} />
    <meta property="og:description" content={data.lead} />
    <meta property="article:published_time" content={data.datum.toISOString()} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
  </Fragment>

  <section class="section editie-wrap">
    <div class="wrap">
      <a class="terug" href={base}>{tr("← Alle edities", "← All editions")}</a>
      <article class="krant">
        <Krantkop regel={`${tr('Editie', 'Edition')} ${editie.nummer} · ${maand(data.datum, lang)}`} />

        <div class="voorpagina" style={`--kleur:${kleur.bg}; --op:${kleur.on}`}>
          {data.kicker && <p class="kicker">{data.kicker}</p>}
          {data.stempel && <p class="stempel">{data.stempel}</p>}
          <h1>{data.titel}</h1>
          <p class="lead">{data.lead}</p>
          <a class="btn dark" href={L('/brouwerij')}>{tr("Kom langs in Esen", "Visit us in Esen")}</a>
        </div>
        <Image src={data.foto} alt={data.fotoAlt} width={1200} class="hoofdfoto" loading="eager" />

        <Content />
      </article>

      <nav class="bladeren" aria-label={tr("Andere edities", "Other editions")}>
        {vorige ? <a href={`${base}/${vorige.id}`}>← {maand(vorige.data.datum, lang)}</a> : <span />}
        {volgende ? <a href={`${base}/${volgende.id}`}>{maand(volgende.data.datum, lang)} →</a> : <span />}
      </nav>
    </div>
  </section>
</Base>

<style>
  .editie-wrap {
    padding-top: clamp(24px, 4vw, 48px);
  }
  .terug {
    display: inline-block;
    margin-bottom: 20px;
    font-weight: 700;
    text-decoration: none;
  }
  .krant {
    max-width: 920px;
    margin: 0 auto;
    background: var(--paper-light);
    border: var(--line);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .voorpagina {
    background: var(--kleur) var(--grain);
    color: var(--op);
    padding: clamp(30px, 5vw, 56px) clamp(20px, 5vw, 56px);
    border-top: 2px solid var(--ink);
  }
  .kicker {
    font-family: var(--font-display);
    font-style: italic;
    margin: 0 0 8px;
  }
  .stempel {
    display: inline-block;
    margin: 0 0 10px;
    padding: 4px 12px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: #d6232a;
    color: #fbf5ea;
    font-weight: 700;
    font-size: 0.85rem;
    rotate: -2deg;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    line-height: 0.95;
    margin: 0 0 16px;
  }
  .lead {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    max-width: 34em;
    margin: 0 0 24px;
  }
  .krant :global(.hoofdfoto) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 560px;
    object-fit: cover;
    border-top: 2px solid var(--ink);
  }
  .bladeren {
    max-width: 920px;
    margin: 28px auto 0;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-display);
    font-weight: 700;
  }
  .bladeren a {
    text-decoration: none;
  }
</style>
