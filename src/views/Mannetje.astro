---
import { langOf, link } from '../i18n';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Polaroid from '../components/Polaroid.astro';
import { getProducts } from '../lib/shopify';

// Variant ids for the cart: the plain yellow figurine and the personalised one.
let plainId = '';
let customId = '';
// Surcharges for extra work, as variants of the hidden product 'mannetje-extra' (prices are set in Shopify)
const extras: Record<string, { id: string; price: number }> = {};
try {
  const products = await getProducts();
  plainId = products.find((p) => p.handle === 'oerbier-mannetje')?.variants.nodes[0]?.id ?? '';
  customId = products.find((p) => p.handle === 'oerbier-mannetje-op-maat')?.variants.nodes[0]?.id ?? '';
  for (const v of products.find((p) => p.handle === 'mannetje-extra')?.variants.nodes ?? []) {
    extras[v.title] = { id: v.id, price: Math.round(+v.price.amount) };
  }
} catch {}
// Prices shown when the surcharge product is missing (ordering those options is then blocked)
const toeslag = {
  kleur: extras['Extra kleur']?.price ?? 5,
  strepen: extras['Strepen']?.price ?? 10,
  vlag: extras['Vlag']?.price ?? 10,
  camo: extras['Camo']?.price ?? 20,
  logo: extras['Logo']?.price ?? 15,
};

const lang = langOf(Astro.url);
const en = lang === 'en';
const tr = (nl: string, enText: string) => (en ? enText : nl);
const L = (href: string) => link(lang, href);
const examples = import.meta.glob<{ default: ImageMetadata }>('../assets/mannetjes/*.jpg', { eager: true });
const gallery = Object.entries(examples)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([file, mod], i) => ({
    src: mod.default,
    name: file.split('/').pop()!.replace('.jpg', ''),
    tilt: [-2.5, 2, -1, 3, -3, 1.5][i % 6],
  }));

const palette = [
  ['Oerbier-geel', '#f6bf1c'],
  ['Citroengeel', '#fbe14a'],
  ['Oranje', '#f28c28'],
  ['Rood', '#d93a2b'],
  ['Bordeaux', '#7d1f2b'],
  ['Roze', '#f3a7c3'],
  ['Fuchsia', '#d6337f'],
  ['Lila', '#c9b3e8'],
  ['Paars', '#8a6bc8'],
  ['Donkerblauw', '#1f3c88'],
  ['Blauw', '#3d7bd4'],
  ['Hemelsblauw', '#8fc3ec'],
  ['Turkoois', '#2bb3a8'],
  ['Groen', '#2f7f45'],
  ['Lichtgroen', '#8cc84b'],
  ['Kaki', '#8a8a4a'],
  ['Bruin', '#6b4226'],
  ['Beige', '#e3cfa6'],
  ['Wit', '#f7f6f1'],
  ['Grijs', '#8c8c8c'],
  ['Zwart', '#1f1b17'],
  ['Zilver', '#c4c8ce'],
  ['Goud', '#c9a13b'],
  ['Brons', '#a86a2c'],
];

const parts = [
  { id: 'alles', label: tr("Alles", "Everything") },
  { id: 'hoofd', label: tr("Hoofd", "Head") },
  { id: 'lichaam', label: tr("Lichaam", "Body") },
  { id: 'armen', label: tr("Armen", "Arms") },
  { id: 'voeten', label: tr("Voetjes", "Feet") },
  { id: 'glas', label: tr("Glas", "Glass") },
  { id: 'sjaal', label: tr("Sjaal", "Scarf") },
];

const flags = [
  { id: 'be', label: tr("België", "Belgium") },
  { id: 'nl', label: tr("Nederland", "Netherlands") },
  { id: 'fr', label: tr("Frankrijk", "France") },
  { id: 'de', label: tr("Duitsland", "Germany") },
  { id: 'it', label: tr("Italië", "Italy") },
  { id: 'es', label: tr("Spanje", "Spain") },
  { id: 'pt', label: tr("Portugal", "Portugal") },
  { id: 'ie', label: tr("Ierland", "Ireland") },
  { id: 'gb', label: tr("Verenigd Koninkrijk", "United Kingdom") },
  { id: 'at', label: tr("Oostenrijk", "Austria") },
  { id: 'dk', label: tr("Denemarken", "Denmark") },
  { id: 'se', label: tr("Zweden", "Sweden") },
  { id: 'no', label: tr("Noorwegen", "Norway") },
  { id: 'us', label: tr("Verenigde Staten", "United States") },
  { id: 'jp', label: tr("Japan", "Japan") },
];

// Flag artwork in a 200 x 165 box over the visible part of the body (below the head)
const W = 200;
const H = 165;
const v3 = (a: string, b: string, c: string) =>
  `<rect width="${W / 3 + 1}" height="${H}" fill="${a}"/><rect x="${W / 3}" width="${W / 3 + 1}" height="${H}" fill="${b}"/><rect x="${(2 * W) / 3}" width="${W / 3}" height="${H}" fill="${c}"/>`;
const h3 = (a: string, b: string, c: string) =>
  `<rect width="${W}" height="${H / 3 + 1}" fill="${a}"/><rect y="${H / 3}" width="${W}" height="${H / 3 + 1}" fill="${b}"/><rect y="${(2 * H) / 3}" width="${W}" height="${H / 3}" fill="${c}"/>`;
const nordic = (bg: string, cross: string, inner?: string) =>
  `<rect width="${W}" height="${H}" fill="${bg}"/><rect x="58" width="32" height="${H}" fill="${cross}"/><rect y="66" width="${W}" height="32" fill="${cross}"/>` +
  (inner ? `<rect x="66" width="16" height="${H}" fill="${inner}"/><rect y="74" width="${W}" height="16" fill="${inner}"/>` : '');
const usStripes = Array.from({ length: 13 }, (_, i) => `<rect y="${(i * H) / 13}" width="${W}" height="${H / 13 + 0.5}" fill="${i % 2 ? '#fff' : '#b22234'}"/>`).join('');
const usStars = Array.from({ length: 30 }, (_, i) => `<circle cx="${8 + (i % 6) * 13 + (Math.floor(i / 6) % 2) * 6}" cy="${9 + Math.floor(i / 6) * 17}" r="2.6" fill="#fff"/>`).join('');
const flagArt: Record<string, string> = {
  be: v3('#1f1b17', '#f7cf1c', '#d93a2b'),
  fr: v3('#1f4ea3', '#ffffff', '#d93a2b'),
  it: v3('#1d8a46', '#ffffff', '#d93a2b'),
  ie: v3('#1d8a46', '#ffffff', '#f28c28'),
  nl: h3('#ae1c28', '#ffffff', '#21468b'),
  de: h3('#1f1b17', '#d93a2b', '#f7cf1c'),
  at: h3('#d93a2b', '#ffffff', '#d93a2b'),
  es: `<rect width="${W}" height="${H}" fill="#c60b1e"/><rect y="${H / 4}" width="${W}" height="${H / 2}" fill="#ffc400"/>`,
  pt: `<rect width="${W}" height="${H}" fill="#d93a2b"/><rect width="80" height="${H}" fill="#1d6b2e"/><circle cx="80" cy="${H / 2}" r="26" fill="#f7cf1c"/>`,
  se: nordic('#1f5fa8', '#f7cf1c'),
  dk: nordic('#c8102e', '#ffffff'),
  no: nordic('#ba0c2f', '#ffffff', '#00205b'),
  jp: `<rect width="${W}" height="${H}" fill="#ffffff"/><circle cx="${W / 2}" cy="${H / 2}" r="42" fill="#bc002d"/>`,
  us: `${usStripes}<rect width="86" height="${(7 * H) / 13}" fill="#3c3b6e"/>${usStars}`,
  gb: `<rect width="${W}" height="${H}" fill="#012169"/><path d="M0 0L${W} ${H}M${W} 0L0 ${H}" stroke="#fff" stroke-width="32"/><path d="M0 0L${W} ${H}M${W} 0L0 ${H}" stroke="#c8102e" stroke-width="10"/><rect x="${W / 2 - 18}" width="36" height="${H}" fill="#fff"/><rect y="${H / 2 - 18}" width="${W}" height="36" fill="#fff"/><rect x="${W / 2 - 11}" width="22" height="${H}" fill="#c8102e"/><rect y="${H / 2 - 11}" width="${W}" height="22" fill="#c8102e"/>`,
};
---

<Base
  title={tr("Jouw eigen Oerbier-mannetje | De Dolle Brouwers", "Design your own Oerbier figure | De Dolle Brouwers")}
  description={tr("Stel je eigen Oerbier-mannetje samen: kleur per lichaamsdeel, een vlag, je eigen logo en tekst op de sjaal. Met de hand beschilderd, €90. Het gewone gele mannetje kost €60.", "Design your own Oerbier figure: a colour for every part, a flag, your own logo and text on the scarf. Hand-painted, €90. The regular yellow figure is €60.")}
>
  <Fragment slot="head">
    <meta property="og:title" content={tr("Jouw eigen Oerbier-mannetje", "Your own Oerbier figure")} />
  </Fragment>

  <section class="intro">
    <div class="wrap">
      <a class="back" href={L('/oershop')}>{tr("← Oershop", "← Shop")}</a>
      <h1>{tr("Jouw eigen", "Your own")}<br /><em>{tr("Oerbier-mannetje.", "Oerbier figure.")}</em></h1>
      <p class="lead">
        {tr("Elk mannetje wordt met de hand beschilderd. Geef elk stukje een eigen kleur, zet er een vlag of je logo op en kies wat er op de sjaal staat. Of verzin zelf iets: we hebben al voetbalshirts, namen, trouwdata en clublogo's gedaan.", "Every figure is painted by hand. Give each part its own colour, add a flag or your logo and choose what goes on the scarf. Or come up with something yourself: we've done football shirts, names, wedding dates and club logos.")}
      </p>
      <p class="kris">
        {tr("Kris maakt elk mannetje zelf, met de hand. Hij volgt je ontwerp, maar schildert het zoals hij het ziet. Zo wordt elk ventje een beetje anders, en net daardoor uniek.", "Kris makes every figure himself, by hand. He follows your design, but paints it the way he sees it. So every figure turns out a little different, and that's exactly what makes it unique.")}
      </p>
      <ul class="prices">
        <li><strong>€60</strong> {tr("het gewone gele", "the regular yellow one")}</li>
        <li><strong>€90</strong> {tr("gepersonaliseerd", "personalised")}</li>
      </ul>
    </div>
  </section>

  <section class="maker">
    <div class="wrap maker-grid">
      <div class="preview">
        <svg viewBox="0 0 320 340" role="img" aria-label={tr("Voorbeeld van jouw Oerbier-mannetje", "Preview of your Oerbier figure")} id="man">
          <defs>
            <clipPath id="clip-body">
              <ellipse cx="160" cy="215" rx="92" ry="86"></ellipse>
            </clipPath>
            <clipPath id="clip-all">
              <ellipse cx="62" cy="192" rx="42" ry="24" transform="rotate(-25 62 192)"></ellipse>
              <ellipse cx="236" cy="142" rx="22" ry="44" transform="rotate(35 236 142)"></ellipse>
              <ellipse cx="160" cy="215" rx="92" ry="86"></ellipse>
              <circle cx="160" cy="110" r="58"></circle>
            </clipPath>
            <pattern id="pat-strepen" width="24" height="24" patternUnits="userSpaceOnUse">
              <rect width="24" height="11" fill="#fbfaf5"></rect>
            </pattern>
            <pattern id="pat-camo" width="90" height="90" patternUnits="userSpaceOnUse">
              <path d="M5 12 q12-14 26-2 t22 6 q4 14-14 12 t-22 4 q-16-6-12-20z" fill="rgba(0,0,0,.28)"></path>
              <path d="M52 50 q14-10 26 0 t6 18 q-12 10-24 2 t-8-20z" fill="rgba(255,255,255,.35)"></path>
              <path d="M8 62 q10-8 20 2 q6 12-8 14 q-16-2-12-16z" fill="rgba(0,0,0,.2)"></path>
              <path d="M60 4 q10 2 12 12 q-6 8-16 2z" fill="rgba(255,255,255,.3)"></path>
            </pattern>
            {
              flags.map((f) => (
                <pattern id={`pat-${f.id}`} x="60" y="140" width={W} height={H} patternUnits="userSpaceOnUse"><Fragment set:html={flagArt[f.id]} /></pattern>
              ))
            }
            <path id="sash-line" d="M92 150 L244 274"></path>
          </defs>

          <ellipse cx="160" cy="322" rx="110" ry="12" fill="rgba(33,23,12,.12)"></ellipse>

          <g stroke="#21170c" stroke-width="3">
            <ellipse cx="122" cy="296" rx="34" ry="27" data-part="voeten"></ellipse>
            <ellipse cx="198" cy="296" rx="34" ry="27" data-part="voeten"></ellipse>
            <ellipse cx="62" cy="192" rx="42" ry="24" transform="rotate(-25 62 192)" data-part="armen"></ellipse>
            <ellipse cx="236" cy="142" rx="22" ry="44" transform="rotate(35 236 142)" data-part="armen"></ellipse>
            <ellipse cx="160" cy="215" rx="92" ry="86" data-part="lichaam"></ellipse>
          </g>
          <rect x="0" y="0" width="320" height="340" clip-path="url(#clip-body)" class="pattern" fill="none"></rect>
          <image class="logo" x="96" y="214" width="62" height="62" preserveAspectRatio="xMidYMid meet" clip-path="url(#clip-body)"></image>
          <circle cx="160" cy="110" r="58" stroke="#21170c" stroke-width="3" data-part="hoofd"></circle>
          <ellipse cx="138" cy="76" rx="18" ry="10" fill="rgba(255,255,255,.4)" transform="rotate(-30 138 76)"></ellipse>

          <g stroke="#21170c" stroke-width="3" stroke-linejoin="round">
            <path d="M226 36 H296 Q294 98 261 102 Q228 98 226 36 Z" data-part="glas"></path>
            <path d="M226 36 H296 L294 50 H228 Z" fill="#fbfaf5"></path>
          </g>

          <g>
            <ellipse cx="142" cy="100" rx="14" ry="16" fill="#fff" stroke="#21170c" stroke-width="3"></ellipse>
            <ellipse cx="178" cy="100" rx="14" ry="16" fill="#fff" stroke="#21170c" stroke-width="3"></ellipse>
            <circle cx="147" cy="104" r="7.5" fill="#21170c"></circle>
            <circle cx="183" cy="104" r="7.5" fill="#21170c"></circle>
            <path d="M138 128 Q160 150 182 128" fill="none" stroke="#21170c" stroke-width="3.5" stroke-linecap="round"></path>
          </g>

          <g class="extra extra-bril" stroke="#21170c" stroke-width="3">
            <rect x="122" y="88" width="34" height="24" rx="9" fill="#21170c"></rect>
            <rect x="164" y="88" width="34" height="24" rx="9" fill="#21170c"></rect>
            <path d="M156 98 H164" fill="none"></path>
            <path d="M126 92 L136 92" stroke="rgba(255,255,255,.5)" stroke-width="3" stroke-linecap="round"></path>
          </g>

          <g clip-path="url(#clip-all)">
            <path d="M76 168 L104 136 L262 260 L234 292 Z" data-part="sjaal" stroke="#21170c" stroke-width="3"></path>
          </g>
          <text class="sash-text" font-size="24" dy="8">
            <textPath href="#sash-line" startOffset="50%" text-anchor="middle" id="sash-text">oerbier</textPath>
          </text>

          <g class="extra extra-strik" stroke="#21170c" stroke-width="3" stroke-linejoin="round">
            <path d="M160 168 L128 152 L128 186 Z" class="strik"></path>
            <path d="M160 168 L192 152 L192 186 Z" class="strik"></path>
            <circle cx="160" cy="168" r="7" class="strik"></circle>
          </g>
        </svg>
        <p class="price-tag"><span id="price">€60</span> <small id="price-note">{tr("het gewone gele", "the regular yellow one")}</small></p>
        <p class="price-extra" id="price-extra" hidden></p>
      </div>

      <form class="controls" id="maker" data-plain={plainId} data-custom={customId} data-extras={JSON.stringify(extras)}>
        <fieldset>
          <legend>{tr("1. Kleuren", "1. Colours")}</legend>
          <p class="hint">{tr(`Kies eerst wat je kleurt, daarna de kleur. Twee eigen kleuren zitten in de prijs, elke kleur meer kost €${toeslag.kleur} (we kopen die verf apart). Maximum vijf eigen kleuren.`, `First pick what to colour, then the colour. Two colours of your own are included, every extra colour is €${toeslag.kleur} (we buy that paint separately). Five colours of your own at most.`)}</p>
          <p class="hint warn" id="kleur-max" hidden>{tr("Dat is het maximum van vijf eigen kleuren. Meer nodig? Beschrijf het bij je idee onderaan, dan bekijken we het samen.", "That's the maximum of five colours of your own. Need more? Describe it in your idea at the bottom and we'll look at it together.")}</p>
          <div class="pills parts">
            {
              parts.map((p, i) => (
                <label>
                  <input type="radio" name="deel" value={p.id} checked={i === 0} />
                  <span>
                    {p.id !== 'alles' && <i data-dot={p.id} />}
                    {p.label}
                  </span>
                </label>
              ))
            }
          </div>
          <div class="swatches">
            {palette.map(([name, hex]) => <button type="button" class="sw" data-hex={hex} title={name} aria-label={name} style={`--c:${hex}`} />)}
            <label class="sw custom" title={tr("Eigen kleur", "Your own colour")}>
              <input type="color" id="eigen" value="#4aa3a0" aria-label={tr("Eigen kleur kiezen", "Pick your own colour")} />
              <span>+</span>
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend>{tr("2. Op het lijf", "2. On the body")}</legend>
          <p class="hint">{tr(`Effen zit in de prijs. Strepen +€${toeslag.strepen}, een vlag +€${toeslag.vlag}, camo +€${toeslag.camo}: daar kruipt veel schilderwerk in.`, `Plain is included. Stripes +€${toeslag.strepen}, a flag +€${toeslag.vlag}, camo +€${toeslag.camo}: those take a lot of painting.`)}</p>
          <div class="pills">
            <label><input type="radio" name="patroon" value="effen" checked /><span>{tr("Effen", "Plain")}</span></label>
            <label><input type="radio" name="patroon" value="strepen" /><span>{tr("Strepen", "Stripes")}</span></label>
            <label><input type="radio" name="patroon" value="camo" /><span>Camo</span></label>
          </div>
          <p class="sub">{tr("Of een vlag", "Or a flag")}</p>
          <div class="pills flags">
            {
              flags.map((f) => (
                <label>
                  <input type="radio" name="patroon" value={f.id} />
                  <span>{f.label}</span>
                </label>
              ))
            }
          </div>
          <p class="hint">{tr("Ander land? Zet het bij je idee onderaan.", "Another country? Add it to your idea at the bottom.")}</p>
        </fieldset>

        <fieldset>
          <legend>3. Logo</legend>
          <label class="upload">
            <input type="file" id="logo" accept="image/*" />
            <span class="btn light">{tr("Logo kiezen", "Choose a logo")}</span>
            <em id="logo-name">{tr("Nog geen logo", "No logo yet")}</em>
          </label>
          <button type="button" class="link" id="logo-weg" hidden>{tr("Logo weghalen", "Remove logo")}</button>
          <label class="field logo-size" id="logo-size-wrap" hidden>
            {tr("Grootte", "Size")}
            <input type="range" id="logo-size" min="30" max="120" value="62" />
          </label>
          <p class="hint">{tr(`Een logo kost +€${toeslag.logo}. Sleep het op het mannetje naar de plek waar je het wilt. Heel gedetailleerde logo's vereenvoudigt Kris een beetje, zodat ze met de hand mooi blijven. We bewaren je logo bij je bestelling.`, `A logo is +€${toeslag.logo}. Drag it on the figure to where you want it. Very detailed logos are simplified a little by Kris, so they still look good painted by hand. We keep your logo with your order.`)}</p>
        </fieldset>

        <fieldset>
          <legend>4. Extra</legend>
          <div class="pills">
            <label><input type="checkbox" name="bril" /><span>{tr("Zonnebril", "Sunglasses")}</span></label>
            <label><input type="checkbox" name="strik" /><span>{tr("Strikje", "Bow tie")}</span></label>
          </div>
        </fieldset>

        <fieldset>
          <legend>{tr("5. De sjaal", "5. The scarf")}</legend>
          <label class="field">
            {tr("Wat staat erop?", "What does it say?")}
            <input type="text" name="tekst" value="oerbier" maxlength="16" autocomplete="off" />
          </label>
          <p class="hint">{tr("De kleur van de sjaal kies je bij 1. Kleuren.", "You pick the scarf colour under 1. Colours.")}</p>
        </fieldset>

        <fieldset>
          <legend>{tr("6. Nog een idee?", "6. Any other idea?")}</legend>
          <label class="field">
            {tr("Een ander land, een clubshirt, een datum… Beschrijf het hier.", "Another country, a club shirt, a date… Describe it here.")}
            <textarea name="idee" rows="3" placeholder={tr("Bv. in de kleuren van mijn voetbalclub, met 'Proficiat Jan' op de sjaal", "E.g. in the colours of my football club, with 'Happy birthday Jan' on the scarf")}></textarea>
          </label>
        </fieldset>

        <button class="btn dark" type="submit" id="bestel">{tr("In mijn mandje →", "Add to my cart →")}</button>
        <p class="note">{tr("Kris beschildert elk mannetje met de hand, op zijn manier: het kan dus altijd wat afwijken van het voorbeeld, en geen twee zijn hetzelfde. We laten je weten wanneer het klaar is om te verzenden of af te halen in de Oerbar.", "Kris paints every figure by hand, his way: it can always differ a little from the preview, and no two are the same. We'll let you know when it's ready to ship or to pick up in the Oerbar.")}</p>
      </form>
    </div>
  </section>

  <section class="section inspo">
    <div class="wrap">
      <h2>{tr("Wat anderen al bedachten.", "What others came up with.")}</h2>
      <div class="inspo-grid">
        {
          gallery.map((g) => (
            <Polaroid src={g.src} alt={tr(`Gepersonaliseerd Oerbier-mannetje: ${g.name.replace(/-/g, ' ')}`, `Personalised Oerbier figure: ${g.name.replace(/-/g, ' ')}`)} tilt={g.tilt} ratio="1 / 1" width={420} />
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ palette, toeslag }}>
  const EN = document.documentElement.lang === 'en';
  const form = document.getElementById('maker');
  const svg = document.getElementById('man');
  const sashText = document.getElementById('sash-text');
  const price = document.getElementById('price');
  const priceNote = document.getElementById('price-note');
  const logoImg = svg.querySelector('.logo');
  const logoInput = document.getElementById('logo');
  const logoName = document.getElementById('logo-name');
  const logoWeg = document.getElementById('logo-weg');
  const logoSize = document.getElementById('logo-size');
  const logoSizeWrap = document.getElementById('logo-size-wrap');

  // The logo can be dragged over the body and resized; its centre stays on the body
  const logoPos = { x: 127, y: 245, size: 62 };
  const placeLogo = () => {
    const h = logoPos.size / 2;
    logoImg.setAttribute('x', String(logoPos.x - h));
    logoImg.setAttribute('y', String(logoPos.y - h));
    logoImg.setAttribute('width', String(logoPos.size));
    logoImg.setAttribute('height', String(logoPos.size));
  };
  const toSvg = (e) => {
    const pt = svg.createSVGPoint();
    pt.x = e.clientX;
    pt.y = e.clientY;
    return pt.matrixTransform(svg.getScreenCTM().inverse());
  };
  let drag = null;
  logoImg.addEventListener('pointerdown', (e) => {
    if (!logo) return;
    const p = toSvg(e);
    drag = { dx: logoPos.x - p.x, dy: logoPos.y - p.y };
    logoImg.setPointerCapture(e.pointerId);
    e.preventDefault();
  });
  logoImg.addEventListener('pointermove', (e) => {
    if (!drag) return;
    const p = toSvg(e);
    logoPos.x = Math.min(240, Math.max(80, p.x + drag.dx));
    logoPos.y = Math.min(290, Math.max(150, p.y + drag.dy));
    placeLogo();
  });
  const stopDrag = () => (drag = null);
  logoImg.addEventListener('pointerup', stopDrag);
  logoImg.addEventListener('pointercancel', stopDrag);
  logoSize.addEventListener('input', () => {
    logoPos.size = +logoSize.value;
    placeLogo();
  });
  // In words for Kris: where on the belly and how big
  const logoPlek = () => {
    const hor = logoPos.x < 135 ? 'links' : logoPos.x > 185 ? 'rechts' : 'midden';
    const ver = logoPos.y < 200 ? 'boven' : logoPos.y > 250 ? 'onder' : 'midden';
    return `${ver === hor ? 'midden' : `${ver} ${hor}`} op het lijf (vooraanzicht), grootte ${Math.round((logoPos.size / 62) * 100)}%`;
  };

  const DEFAULTS = { hoofd: '#f6bf1c', lichaam: '#f6bf1c', armen: '#f6bf1c', voeten: '#f6bf1c', glas: '#c8241c', sjaal: '#fbfaf5' };
  const colors = { ...DEFAULTS };
  let logo = null;

  const STANDAARD = { '#c8241c': 'Rood (standaard)', '#fbfaf5': 'Wit (standaard)' };
  const nameOf = (hex) => (palette.find(([, h]) => h === hex) || [STANDAARD[hex] || hex])[0];
  const ink = (hex) => {
    const n = parseInt(hex.slice(1), 16);
    const l = 0.299 * (n >> 16) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255);
    return l > 150 ? '#21170c' : '#fbfaf5';
  };
  const value = (name) => form.elements.namedItem(name).value;
  const on = (name) => form.elements.namedItem(name).checked;

  // Colours of your own: every part that isn't its standard colour, counted once per colour
  const MAX_KLEUREN = 5;
  const INBEGREPEN = 2;
  const eigenKleuren = (c) => new Set(Object.keys(DEFAULTS).filter((k) => c[k] !== DEFAULTS[k]).map((k) => c[k])).size;
  const kleurMax = document.getElementById('kleur-max');
  const paint = (hex) => {
    const deel = value('deel');
    const targets = deel === 'alles' ? ['hoofd', 'lichaam', 'armen', 'voeten'] : [deel];
    const next = { ...colors };
    targets.forEach((t) => (next[t] = hex));
    const teVeel = eigenKleuren(next) > MAX_KLEUREN;
    kleurMax.hidden = !teVeel;
    if (teVeel) return;
    Object.assign(colors, next);
    render();
  };

  const render = () => {
    Object.entries(colors).forEach(([part, hex]) => {
      svg.querySelectorAll(`[data-part="${part}"]`).forEach((el) => el.setAttribute('fill', hex));
      const dot = form.querySelector(`[data-dot="${part}"]`);
      if (dot) dot.style.background = hex;
    });
    svg.querySelector('.sash-text').setAttribute('fill', ink(colors.sjaal));
    svg.querySelectorAll('.strik').forEach((el) => el.setAttribute('fill', colors.sjaal === '#fbfaf5' ? '#c8241c' : colors.sjaal));

    const patroon = value('patroon');
    svg.querySelector('.pattern').setAttribute('fill', patroon === 'effen' ? 'none' : `url(#pat-${patroon})`);

    svg.querySelector('.extra-bril').classList.toggle('on', on('bril'));
    svg.querySelector('.extra-strik').classList.toggle('on', on('strik'));

    const tekst = form.elements.namedItem('tekst').value.trim();
    sashText.textContent = tekst || ' ';

    const idee = form.elements.namedItem('idee').value.trim();
    const plain =
      Object.keys(DEFAULTS).every((k) => colors[k] === DEFAULTS[k]) &&
      patroon === 'effen' &&
      !on('bril') &&
      !on('strik') &&
      !logo &&
      tekst.toLowerCase() === 'oerbier' &&
      !idee;
    // Surcharges for extra colours and patterns
    const extraKleuren = Math.max(0, eigenKleuren(colors) - INBEGREPEN);
    const patroonExtra = patroon === 'effen' ? null : patroon === 'strepen' ? 'Strepen' : patroon === 'camo' ? 'Camo' : 'Vlag';
    toeslagen = plain
      ? []
      : [
          ...(extraKleuren ? [{ naam: 'Extra kleur', aantal: extraKleuren, prijs: toeslag.kleur }] : []),
          ...(patroonExtra ? [{ naam: patroonExtra, aantal: 1, prijs: toeslag[patroonExtra === 'Strepen' ? 'strepen' : patroonExtra === 'Camo' ? 'camo' : 'vlag'] }] : []),
          ...(logo ? [{ naam: 'Logo', aantal: 1, prijs: toeslag.logo }] : []),
        ];
    const totaal = (plain ? 60 : 90) + toeslagen.reduce((s, t) => s + t.aantal * t.prijs, 0);
    isPlain = plain;
    price.textContent = `€${totaal}`;
    priceNote.textContent = plain ? (EN ? 'the regular yellow one' : 'het gewone gele') : EN ? 'personalised' : 'gepersonaliseerd';
    const uitleg = document.getElementById('price-extra');
    const woord = { 'Extra kleur': EN ? 'extra colour' : 'extra kleur', Strepen: EN ? 'stripes' : 'strepen', Camo: 'camo', Vlag: EN ? 'flag' : 'vlag', Logo: 'logo' };
    uitleg.hidden = !toeslagen.length;
    uitleg.textContent = `€90 + ` + toeslagen.map((t) => `${t.aantal > 1 ? t.aantal + ' × ' : ''}${woord[t.naam]}${t.aantal > 1 && !EN ? 'en' : t.aantal > 1 ? 's' : ''} €${t.aantal * t.prijs}`).join(' + ');
  };
  let toeslagen = [];
  let isPlain = true;

  form.querySelectorAll('.sw[data-hex]').forEach((b) => b.addEventListener('click', () => paint(b.dataset.hex)));
  document.getElementById('eigen').addEventListener('input', (e) => paint(e.target.value));
  form.addEventListener('input', render);
  form.addEventListener('change', render);

  logoInput.addEventListener('change', () => {
    const file = logoInput.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      logo = file.name;
      form.dataset.logo = reader.result;
      logoImg.setAttribute('href', reader.result);
      logoName.textContent = file.name;
      logoWeg.hidden = false;
      logoSizeWrap.hidden = false;
      placeLogo();
      render();
    };
    reader.readAsDataURL(file);
  });
  logoWeg.addEventListener('click', () => {
    logo = null;
    delete form.dataset.logo;
    logoInput.value = '';
    logoImg.removeAttribute('href');
    logoName.textContent = EN ? 'No logo yet' : 'Nog geen logo';
    logoWeg.hidden = true;
    logoSizeWrap.hidden = true;
    render();
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const patroon = form.querySelector('input[name="patroon"]:checked').closest('label').textContent.trim();
    const extra = [on('bril') && 'zonnebril', on('strik') && 'strikje'].filter(Boolean).join(', ') || 'geen';
    const attributes = [
      ['Hoofd', nameOf(colors.hoofd)],
      ['Lichaam', nameOf(colors.lichaam)],
      ['Armen', nameOf(colors.armen)],
      ['Voetjes', nameOf(colors.voeten)],
      ['Glas', nameOf(colors.glas)],
      ['Sjaal', `${nameOf(colors.sjaal)}, tekst "${form.elements.namedItem('tekst').value}"`],
      ['Op het lijf', patroon],
      ['Extra', extra],
      ['Idee', form.elements.namedItem('idee').value || '-'],
      ...(logo ? [['Logo plaats', logoPlek()]] : []),
    ].map(([key, value]) => ({ key, value }));
    // Picked up by the cart script below
    window.dispatchEvent(new CustomEvent('mannetje:bestel', { detail: { plain: isPlain, attributes, logoName: logo, toeslagen } }));
  });

  render();
</script>

<script>
  import { addToCart, openCart } from '../lib/cart';

  const EN = document.documentElement.lang === 'en';
  const form = document.getElementById('maker') as HTMLFormElement;
  const button = document.getElementById('bestel') as HTMLButtonElement;

  // Redraw the logo as PNG (max 800 px) before storing it; this also turns SVG files into plain images.
  const shrink = (dataUrl: string) =>
    new Promise<string>((resolve) => {
      const img = new Image();
      img.onload = () => {
        const scale = Math.min(1, 800 / Math.max(img.width, img.height));
        const canvas = document.createElement('canvas');
        canvas.width = Math.round(img.width * scale);
        canvas.height = Math.round(img.height * scale);
        canvas.getContext('2d')!.drawImage(img, 0, 0, canvas.width, canvas.height);
        resolve(canvas.toDataURL('image/png'));
      };
      img.onerror = () => resolve('');
      img.src = dataUrl;
    });

  // Draws the live preview (#man) as a PNG so the order carries a picture of the design
  const snapshot = () =>
    new Promise<string>((resolve) => {
      try {
        const src = document.getElementById('man') as unknown as SVGSVGElement;
        const clone = src.cloneNode(true) as SVGSVGElement;
        const from = src.querySelectorAll('*');
        const to = clone.querySelectorAll('*');
        const props = ['fill', 'stroke', 'stroke-width', 'opacity', 'font-size', 'font-weight', 'font-family', 'letter-spacing', 'display', 'visibility'];
        from.forEach((el, i) => {
          const cs = getComputedStyle(el);
          props.forEach((p) => (to[i] as SVGElement).style.setProperty(p, cs.getPropertyValue(p)));
        });
        clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
        clone.setAttribute('width', '640');
        clone.setAttribute('height', '680');
        const img = new Image();
        img.onload = () => {
          try {
            const canvas = document.createElement('canvas');
            canvas.width = 640;
            canvas.height = 680;
            const ctx = canvas.getContext('2d')!;
            ctx.fillStyle = '#fbf6e6';
            ctx.fillRect(0, 0, 640, 680);
            ctx.drawImage(img, 0, 0, 640, 680);
            resolve(canvas.toDataURL('image/png'));
          } catch {
            resolve('');
          }
        };
        img.onerror = () => resolve('');
        img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(new XMLSerializer().serializeToString(clone));
      } catch {
        resolve('');
      }
    });

  window.addEventListener('mannetje:bestel', async (e) => {
    const { plain, attributes, logoName, toeslagen } = (e as CustomEvent).detail as {
      plain: boolean;
      attributes: { key: string; value: string }[];
      logoName: string | null;
      toeslagen: { naam: string; aantal: number }[];
    };
    const extras = JSON.parse(form.dataset.extras || '{}') as Record<string, { id: string }>;
    if (toeslagen.some((t) => !extras[t.naam])) {
      alert(EN ? 'This design can’t be ordered online yet. Please email it to info@dedollebrouwers.be.' : 'Dit ontwerp kan je nog niet online bestellen. Mail het naar info@dedollebrouwers.be.');
      return;
    }
    const variant = plain ? form.dataset.plain : form.dataset.custom;
    if (!variant) {
      alert(EN ? 'The shop is unavailable right now. Please email your order to info@dedollebrouwers.be.' : 'De webshop is even niet bereikbaar. Mail je bestelling naar info@dedollebrouwers.be.');
      return;
    }
    button.disabled = true;
    const label = button.textContent;
    button.textContent = EN ? 'One moment…' : 'Even…';
    try {
      // One id per design ties the surcharge lines to this figure in the cart
      const ontwerp = Date.now().toString(36).toUpperCase();
      const lines = plain ? [] : [...attributes, ...(toeslagen.length ? [{ key: 'Ontwerp', value: ontwerp }] : [])];
      if (!plain && form.dataset.logo) {
        const res = await fetch('/api/logo', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data: await shrink(form.dataset.logo), name: logoName }),
        });
        if (!res.ok) throw new Error('logo');
        const { url } = await res.json();
        lines.push({ key: 'Logo', value: url });
      }
      if (!plain) {
        try {
          const data = await snapshot();
          if (data) {
            const res = await fetch('/api/logo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data, name: 'voorbeeld' }) });
            if (res.ok) lines.push({ key: 'Voorbeeld', value: (await res.json()).url });
          }
        } catch {}
      }
      await addToCart(variant, 1, lines);
      for (const t of toeslagen) await addToCart(extras[t.naam].id, t.aantal, [{ key: 'Ontwerp', value: ontwerp }]);
      openCart();
    } catch {
      alert(EN ? "That didn't work. Please try again later, or email info@dedollebrouwers.be." : 'Dat lukte niet. Probeer het straks nog eens, of mail naar info@dedollebrouwers.be.');
    } finally {
      button.disabled = false;
      button.textContent = label;
    }
  });
</script>

