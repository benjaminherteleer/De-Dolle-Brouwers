---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Polaroid from '../components/Polaroid.astro';
import Stamp from '../components/Stamp.astro';

import brouwer from '../assets/foto/bp-brouwer.jpg';
import koelschip from '../assets/foto/bp-koelschip.jpg';
import oerbar from '../assets/foto/oerbar-interieur.jpg';
import parasols from '../assets/foto/terras-parasols.jpg';
import taps from '../assets/foto/taphandles.jpg';
import gevel from '../assets/foto/brouwerij-gevel.jpg';
import poort from '../assets/foto/brouwerij-poort.jpg';
import rodeDeur from '../assets/foto/rode-deur.jpg';
import binnenkoer from '../assets/foto/binnenkoer.jpg';
import toast from '../assets/foto/historische-toast.jpg';
import signs from '../assets/foto/signs-photo.jpg';
import ketel from '../assets/foto/terras-ketel.jpg';
import mascot from '../assets/logo/logo-full.png';
import arRoerkuip from '../assets/archief/roerkuip-toen.jpg';
import arBrouwer from '../assets/archief/brouwer-jaren80.jpg';
import arKrant from '../assets/archief/krant-1990.jpg';
import arGevel from '../assets/archief/gevel-toen.jpg';
import arTractor from '../assets/archief/mout-tractor.jpg';
import arKinderen from '../assets/archief/kinderen-roerkuip.jpg';
import arBak from '../assets/archief/oerbierbak.jpg';
import arBezoek from '../assets/archief/bezoek-toen.jpg';

const route = 'https://www.google.com/maps/dir/?api=1&destination=De+Dolle+Brouwers,+Roeselarestraat+12B,+8600+Esen';

const stops = [
  {
    img: brouwer,
    alt: 'Brouwer aan het werk bij de roerkuip',
    title: 'Rondleiding',
    text: 'Een uur door het brouwhuis, langs de moutmolen, de roerkuip en de open gistkuipen. Met verhalen die je nergens anders hoort.',
    tilt: -3,
  },
  {
    img: koelschip,
    alt: 'Het koperen koelschip onder het dak',
    title: 'Het koelschip',
    text: 'Boven in het dak ligt het koelschip waar elk brouwsel afkoelt. Er zijn niet veel brouwerijen meer waar je dat nog ziet.',
    tilt: 2,
  },
  {
    img: oerbar,
    alt: 'Het interieur van de Oerbar',
    title: 'De Oerbar',
    text: 'Na de rondleiding proef je drie bieren van het vat. Daarna kan je het hele gamma bestellen, ook Oeral, dat je enkel hier drinkt.',
    tilt: -2,
  },
  {
    img: parasols,
    alt: 'Het terras met gele parasols',
    title: 'Het terras',
    text: 'Bij mooi weer zit je buiten, tussen de oude brouwerijgebouwen, met een De Dolle Brouwers-biertje in de zon.',
    tilt: 3,
  },
];

const history = [
  { year: '1835', text: 'Dokter Louis Nevejan sticht in Esen een brouwerij met stokerij. Het dorp telt er toen zes.' },
  { year: '1882', text: 'De familie Costenoble neemt over en brouwt er drie generaties lang. Begin jaren 80 valt de brouwerij stil.' },
  {
    year: "'70",
    text: 'Fietsclubje “De Dolle Dravers”: de broers Jo en Kris Herteleer, Dirk Coussée en Bernard Veranneman. Ze kennen elke helling, en elk café.',
  },
  { year: '1980', text: 'Na proeven in de wastobbe nemen ze de lege brouwerij over. Op 11 november brouwen ze het eerste Oerbier.' },
  { year: '1998', text: 'Kris legt het eerste Oerbier te slapen in oude sherryvaten. De Reserva is geboren.' },
  { year: 'Nu', text: 'Zo’n 1.200 hectoliter per jaar. Klein genoeg om alles zelf in het oog te houden.' },
];
---

<Base
  title="De brouwerij | Bezoek De Dolle Brouwers in Esen"
  description="Bezoek De Dolle Brouwers in Esen bij Diksmuide: rondleiding elke zondag (14u Engels, 15u Nederlands), Oerbar open op zaterdag en zondag. Ontdek het koelschip, de open gistkuipen en ons verhaal sinds 1980."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://www.oerbier.be/brouwerij" />
    <meta property="og:title" content="Kom langs bij De Dolle Brouwers in Esen" />
    <meta property="og:description" content="Rondleiding elke zondag, Oerbar open in het weekend. Sinds 1980 in Esen." />
    <meta property="og:locale" content="nl_BE" />
  </Fragment>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-copy">
      <p class="hand">Roeselarestraat 12B, Esen</p>
      <h1>Kom eens<br />langs.</h1>
      <p class="lead">
        Een brouwerij uit 1835, een koelschip in het dak, open koperen gistkuipen en een bar vol bier dat hier gebrouwen is.
        Elke zondag geven we een rondleiding, en in het weekend is de Oerbar open.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/rondleiding-boeken">Boek een rondleiding</a>
        <a class="btn light" href={route} target="_blank" rel="noopener">Route plannen ↗</a>
      </div>
      <dl class="hours">
        <div><dt>Zaterdag</dt><dd>Oerbar 14u – 19u</dd></div>
        <div><dt>Zondag</dt><dd>Oerbar 14u – 19u · Rondleiding 14u (EN) &amp; 15u (NL)</dd></div>
        <div><dt>Prijs</dt><dd>€10 pp, met drie proevertjes van het vat</dd></div>
      </dl>
      <p class="small">Gesloten tijdens de kerstvakantie. Check vooraf onze socials.</p>
    </div>
    <div class="hero-photo">
      <Image
        src={gevel}
        alt="De binnenkoer van De Dolle Brouwers met het smiley-mannetje op het dak en rode vensters"
        width={1200}
        class="hero-img"
        loading="eager"
      />
      <Polaroid src={koelschip} alt="Het koelschip onder het dak" caption="Het koelschip, boven in het dak" tilt={-4} ratio="4 / 3" width={500} class="hero-pol" />
    </div>
    <div class="edge-bottom"></div>
  </section>

  <!-- WAT JE ZIET -->
  <section class="section stops" id="bezoek">
    <div class="wrap">
      <div class="head">
        <h2>Wat je hier beleeft.</h2>
        <p class="hand">Reken op een namiddag ↓</p>
      </div>
      <ol class="stop-list">
        {
          stops.map((s, i) => (
            <li>
              <Polaroid src={s.img} alt={s.alt} tilt={s.tilt} ratio="4 / 5" width={600} taped={i % 2 === 0} />
              <span class="stop-num">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- PRAKTISCH -->
  <section class="section practical">
    <div class="edge-top"></div>
    <div class="wrap prac-grid">
      <div class="prac-copy">
        <h2>Praktisch.</h2>
        <div class="prac-cards">
          <div class="card">
            <h3>Rondleiding op zondag</h3>
            <p>Om 14u in het Engels en om 15u in het Nederlands. Ongeveer een uur, €10 per persoon, inclusief drie proevertjes van het vat.</p>
            <a class="btn" href="/rondleiding-boeken">Reserveer je plaats</a>
          </div>
          <div class="card">
            <h3>Met een groep?</h3>
            <p>
              Vanaf 20 personen plannen we een aparte rondleiding, ook in de week. Mail naar{' '}
              <a href="mailto:info@dedollebrouwers.be">info@dedollebrouwers.be</a>.
            </p>
          </div>
          <div class="card">
            <h3>Zo vind je ons</h3>
            <p>Roeselarestraat 12B, 8600 Esen. Net buiten Diksmuide, niet ver van de kust.</p>
            <a class="link" href={route} target="_blank" rel="noopener">Route in Google Maps ↗</a>
          </div>
        </div>
        <p class="faq">Nog vragen? <a href="/faq">Bekijk de veelgestelde vragen</a> of <a href="/contact">neem contact op</a>.</p>
      </div>
      <div class="prac-photos">
        <Polaroid src={poort} alt="De poort van de brouwerij in Esen" caption="Hier moet je zijn" tilt={3} ratio="3 / 4" taped />
        <Polaroid src={taps} alt="Tapkranen in de Oerbar" tilt={-4} ratio="1 / 1" width={500} class="small-pol" />
      </div>
    </div>
    <div class="edge-bottom"></div>
  </section>

  <!-- VERHAAL -->
  <section class="section story" id="verhaal">
    <div class="edge-top"></div>
    <div class="wrap">
      <div class="story-top">
        <div>
          <h2>Van fietsclub tot brouwerij.</h2>
          <p class="lead">
            De naam komt van de buurt. Toen een paar vrienden zonder ervaring een leegstaande brouwerij kochten, noemden ze hen
            gewoon “de dolle brouwers”. Die koppigheid zit nog altijd in elk bier.
          </p>
        </div>
        <Polaroid src={toast} alt="Zwart-witfoto van de eerste Dolle Brouwers die klinken" caption="Nat en straf, van bij het begin" tilt={-3} ratio="7 / 5" taped />
      </div>

      <ol class="timeline">
        {
          history.map((h) => (
            <li>
              <span class="year">{h.year}</span>
              <p>{h.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="story-photos">
        <Polaroid src={binnenkoer} alt="Doorkijk naar de binnenkoer van de brouwerij" tilt={-3} ratio="3 / 4" />
        <Polaroid src={signs} alt="Oude metalen uithangborden in de brouwerij" caption="De originele uithangborden" tilt={2} ratio="3 / 4" />
        <Polaroid src={rodeDeur} alt="Rode deur in een witte muur met hop" tilt={-2} ratio="3 / 4" />
        <Polaroid src={ketel} alt="Oude brouwketel op het terras" tilt={3} ratio="3 / 4" />
      </div>
    </div>
  </section>

  <!-- FOTOALBUM -->
  <section class="section album">
    <div class="wrap">
      <div class="head">
        <h2>Uit het fotoalbum.</h2>
        <p class="hand">Oude foto's uit de brouwerij</p>
      </div>
      <div class="album-grid">
        {
          [
            { src: arRoerkuip, alt: 'Zwart-witfoto van brouwers bij roerkuip nr. 1', caption: 'Aan de roerkuip, jaren geleden', tilt: -2, r: '4 / 3' },
            { src: arBrouwer, alt: 'Een jonge brouwer aan het werk in de brouwerij', caption: 'Aan het werk, begin jaren 80', tilt: 2, r: '3 / 4' },
            { src: arKrant, alt: 'Krantenknipsel van 20 april 1990 met een baby en een fles Oerbier', caption: 'De krant, 20 april 1990', tilt: -1.5, r: '3 / 4' },
            { src: arGevel, alt: 'De gevel met het smiley-mannetje, jaren geleden', caption: 'Het mannetje stond er toen ook al', tilt: 1.5, r: '4 / 3' },
            { src: arTractor, alt: 'Mout wordt van een tractor in de brouwerij gelost', caption: 'Mout leveren', tilt: -2.5, r: '3 / 4' },
            { src: arKinderen, alt: 'Kinderen in Oerbier-shirts roeren in de roerkuip', caption: 'Jong geleerd', tilt: 2, r: '4 / 3' },
            { src: arBak, alt: 'Een vrouw met een bak Oerbier voor een huis', caption: 'Een bak Oerbier', tilt: -1, r: '3 / 4' },
            { src: arBezoek, alt: 'Bezoekers aan de rode deur van de brouwerij', caption: 'Volk aan de deur', tilt: 2.5, r: '4 / 3' },
          ].map((p) => (
            <Polaroid src={p.src} alt={p.alt} caption={p.caption} tilt={p.tilt} ratio={p.r} width={600} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- FILOSOFIE -->
  <section class="section beliefs">
    <div class="wrap">
      <h2>Drie dingen waar we niet aan raken.</h2>
      <div class="belief-grid">
        <div class="card">
          <span class="big-num">1</span>
          <h3>Geduld</h3>
          <p>Open gisting, minstens twee maanden rijpen en hergisten op de fles. Dat kost weken, geen dagen. Sommige Reserva's liggen jaren op vat.</p>
        </div>
        <div class="card">
          <span class="big-num">2</span>
          <h3>Echt Belgisch</h3>
          <p>Hopbellen uit Poperinge, vijf mouten voor het Oerbier alleen al. Geen extracten, geen smaakstoffen. Graan, hop, water en gist.</p>
        </div>
        <div class="card">
          <span class="big-num">3</span>
          <h3>Karakter</h3>
          <p>Stevig bitter, licht zuur, flink wat alcohol. We brouwen niet om iedereen te plezieren. We brouwen wat wij zelf goed bier vinden.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="edge-top"></div>
    <div class="wrap cta-inner">
      <Image src={mascot} alt="" width={260} class="cta-mascot" />
      <div>
        <h2>Tot zondag?</h2>
        <p class="lead">Rondleiding om 14u (Engels) of 15u (Nederlands). Daarna is de Oerbar van jou.</p>
        <div class="hero-actions">
          <a class="btn dark" href="/rondleiding-boeken">Boek een rondleiding</a>
          <a class="btn light" href={route} target="_blank" rel="noopener">Route plannen ↗</a>
        </div>
      </div>
      <Stamp class="cta-stamp" ring="Oerbar open · Zaterdag & zondag · " center="14–19u" size={150} />
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    min-height: min(90vh, 860px);
    background: var(--ink) var(--grain);
    color: var(--paper-light);
    z-index: 2;
  }
  .hero-copy {
    padding: clamp(50px, 7vw, 100px) clamp(24px, 5vw, 70px) 80px max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero .hand {
    color: var(--yellow);
    background: none;
    padding: 0;
    margin-bottom: 10px;
  }
  .hero h1 {
    font-size: clamp(3.4rem, 8vw, 7rem);
    line-height: 0.92;
    margin-bottom: 22px;
  }
  .hero .lead {
    max-width: 32em;
    color: #efe3cf;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 22px;
  }
  .hours {
    margin: 40px 0 10px;
    display: grid;
    gap: 0;
    max-width: 520px;
    border-top: 1px solid rgba(244, 233, 215, 0.25);
  }
  .hours div {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(244, 233, 215, 0.25);
  }
  .hours dt {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--yellow);
  }
  .hours dd {
    margin: 0;
    color: #efe3cf;
  }
  .small {
    font-size: 0.9rem;
    color: #bfb19a;
    margin: 0;
  }
  .hero-photo {
    position: relative;
    min-height: 520px;
  }
  .hero-photo :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 35% 60%;
  }
  .hero-photo :global(.hero-pol) {
    position: absolute;
    width: min(260px, 42%);
    left: -60px;
    bottom: 60px;
    z-index: 2;
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
    flex-wrap: wrap;
    margin-bottom: 54px;
  }
  .head .hand {
    transform: rotate(-3deg);
  }

  /* STOPS */
  .stop-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 34px;
  }
  .stop-list li {
    position: relative;
  }
  .stop-num {
    position: absolute;
    top: -16px;
    left: -10px;
    z-index: 3;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--yellow);
    border: var(--line);
    box-shadow: 3px 3px 0 var(--ink);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.3rem;
  }
  .stop-list h3 {
    margin: 26px 0 8px;
  }
  .stop-list p {
    font-size: 1rem;
  }

  /* PRACTICAL */
  .practical {
    background: var(--yellow) var(--grain);
    z-index: 1;
  }
  .prac-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(36px, 6vw, 80px);
    align-items: center;
  }
  .prac-copy h2 {
    margin-bottom: 30px;
  }
  .prac-cards {
    display: grid;
    gap: 22px;
  }
  .prac-cards h3 {
    margin-bottom: 8px;
  }
  .prac-cards p {
    margin-bottom: 14px;
  }
  .prac-cards p:last-child {
    margin-bottom: 0;
  }
  .link {
    font-weight: 700;
  }
  .faq {
    margin-top: 26px;
    font-weight: 600;
  }
  .prac-photos {
    position: relative;
  }
  .prac-photos :global(.small-pol) {
    position: absolute;
    width: 46%;
    left: -12%;
    bottom: -8%;
  }

  /* STORY */
  .story {
    background: var(--paper-deep) var(--grain);
  }
  .story-top {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(30px, 6vw, 80px);
    align-items: center;
    margin-bottom: 60px;
  }
  .story-top h2 {
    margin-bottom: 20px;
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 70px;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 28px;
    left: 0;
    right: 0;
    border-top: 3px dashed var(--ink);
  }
  .timeline li {
    position: relative;
  }
  .year {
    display: inline-grid;
    place-items: center;
    min-width: 58px;
    height: 58px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--yellow);
    border: var(--line);
    box-shadow: 3px 3px 0 var(--ink);
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.2rem;
    margin-bottom: 14px;
  }
  .timeline p {
    font-size: 0.98rem;
  }
  .story-photos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
  }

  /* ALBUM */
  .album {
    background: #2a2118 var(--grain);
    color: var(--paper);
  }
  .album .hand {
    color: var(--yellow);
    background: none;
    padding: 0;
  }
  .album-grid {
    columns: 4 220px;
    column-gap: 26px;
  }
  .album-grid :global(.polaroid) {
    break-inside: avoid;
    margin-bottom: 30px;
  }

  /* BELIEFS */
  .beliefs h2 {
    margin-bottom: 44px;
    max-width: 12em;
  }
  .belief-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .belief-grid .card:nth-child(1) {
    transform: rotate(-1.5deg);
  }
  .belief-grid .card:nth-child(2) {
    transform: rotate(1deg);
    background: var(--yellow-soft);
  }
  .belief-grid .card:nth-child(3) {
    transform: rotate(-0.5deg);
  }
  .big-num {
    font-family: var(--font-hand);
    font-style: italic;
    font-size: 3.4rem;
    line-height: 1;
    color: var(--rust);
  }
  .belief-grid h3 {
    margin: 6px 0 10px;
  }

  /* CTA */
  .cta {
    position: relative;
    background: var(--yellow) var(--grain);
    padding: 70px 0 150px;
    margin-top: 40px;
  }
  .cta-inner {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    gap: 40px;
    align-items: center;
  }
  .cta :global(.cta-mascot) {
    width: 100%;
    animation: bob 4s ease-in-out infinite;
  }
  .cta h2 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    margin-bottom: 12px;
  }
  @keyframes bob {
    50% {
      transform: translateY(-8px) rotate(3deg);
    }
  }

  @media (max-width: 1000px) {
    .hero,
    .prac-grid,
    .story-top {
      grid-template-columns: 1fr;
    }
    .stop-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 24px;
    }
    .timeline {
      grid-template-columns: repeat(2, 1fr);
    }
    .timeline::before {
      display: none;
    }
    .story-photos {
      grid-template-columns: repeat(2, 1fr);
    }
    .belief-grid {
      grid-template-columns: 1fr;
    }
    .cta-inner {
      grid-template-columns: 120px 1fr;
    }
    .cta :global(.cta-stamp) {
      display: none;
    }
    .prac-photos {
      max-width: 420px;
      margin-left: auto;
    }
  }
  @media (max-width: 560px) {
    .stop-list {
      grid-template-columns: 1fr;
    }
    .timeline {
      grid-template-columns: 1fr;
    }
    .hero-photo :global(.hero-pol) {
      left: 16px;
      bottom: 40px;
    }
    .cta-inner {
      grid-template-columns: 1fr;
    }
    .cta :global(.cta-mascot) {
      width: 120px;
    }
  }
</style>
