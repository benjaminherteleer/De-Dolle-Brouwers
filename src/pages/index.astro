---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Polaroid from '../components/Polaroid.astro';
import Shop from '../components/Shop.astro';
import Stamp from '../components/Stamp.astro';
import BeerFx from '../components/BeerFx.astro';
import { vast, reserva, abv } from '../lib/bieren';

import toast from '../assets/foto/historische-toast.jpg';
import klinken from '../assets/foto/oerbar-tafel.jpg';
import koelschip from '../assets/foto/bp-koelschip.jpg';
import vergisting from '../assets/foto/bp-gisting.jpg';
import molen from '../assets/foto/bp-roerkuip.jpg';
import overzicht from '../assets/brouwproces/overzicht.jpg';
import toog from '../assets/foto/oerbar-toog.jpg';
import tap from '../assets/foto/oerbar-tap.jpg';
import proostBar from '../assets/foto/oerbar-proost.jpg';
import parasols from '../assets/foto/terras-parasols.jpg';
import oerbar from '../assets/foto/oerbar-interieur.jpg';
import gevel from '../assets/foto/brouwerij-gevel.jpg';
import vaten from '../assets/foto/vaten-rij.jpg';
import flesHop from '../assets/foto/fles-hop.jpg';
import mascot from '../assets/logo/logo-full.png';
import reservaLogo from '../assets/logo/reserva-logo.png';
import valArabier from '../assets/bieren/arabier.png';
import valBoskeun from '../assets/bieren/boskeun.png';
import valTeve from '../assets/bieren/dulle-teve.png';
import valNacht from '../assets/bieren/stille-nacht.png';
import valHoop from '../assets/bieren/dehoop-logo.png';
import vliegtuig from '../assets/bieren/oeral-vliegtuig.png';

// The Oeral plane flies over once and drops the bende next to the Oerbier-mannetje.
const bende = [
  { src: valArabier, slug: 'arabier' },
  { src: valNacht, slug: 'stille-nacht' },
  { src: valBoskeun, slug: 'boskeun' },
  { src: valTeve, slug: 'dulle-teve' },
  { src: valHoop, slug: 'lichtervelds-blond' },
];



---

<Base
  title="De Dolle Brouwers | Oerbier, gebrouwen in Esen sinds 1980"
  description="Ambachtelijke brouwerij in Esen bij Diksmuide, sinds 1980. Ongefilterd, hoog gegist bier: Oerbier, Arabier, Boskeun, Dulle Teve, Stille Nacht en de Reserva's. Rondleiding elke zondag, Oerbar open in het weekend."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://www.oerbier.be/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="De Dolle Brouwers | Oerbier uit Esen, sinds 1980" />
    <meta
      property="og:description"
      content="Ongefilterd, hoog gegist bier uit Esen. Kom proeven in de Oerbar of volg een rondleiding op zondag."
    />
    <meta property="og:locale" content="nl_BE" />
    <meta name="robots" content="index, follow" />
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Brewery",
        "name": "De Dolle Brouwers",
        "alternateName": "Oerbier",
        "url": "https://www.oerbier.be/",
        "description": "Ambachtelijke specialiteitsbrouwerij in Esen (Diksmuide), West-Vlaanderen, sinds 1980. Bekend van Oerbier, Arabier, Boskeun, Dulle Teve, Stille Nacht, Export Stout en Oeral.",
        "foundingDate": "1980",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Roeselarestraat 12B",
          "postalCode": "8600",
          "addressLocality": "Esen (Diksmuide)",
          "addressRegion": "West-Vlaanderen",
          "addressCountry": "BE"
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Saturday", "Sunday"],
            "opens": "14:00",
            "closes": "19:00"
          }
        ],
        "email": "info@dedollebrouwers.be"
      }
    </script>
  </Fragment>

  <!-- HERO -->
  <section class="hero">
    <div class="sky" aria-hidden="true">
      <Image src={vliegtuig} alt="" width={440} class="vliegtuig" loading="eager" />
    </div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="hand hero-note">Esen, West-Vlaanderen ↘</p>
        <h1>Nat<br />en straf.</h1>
        <p class="lead">
          Op 11 november 1980 brouwde een bende vrienden hun eerste Oerbier in een leegstaande brouwerij in Esen. We doen
          het vandaag nog altijd op dezelfde koppige manier: ongefilterd, hoog gegist en zonder haast.
        </p>
        <div class="hero-actions">
          <a class="btn dark" href="/brouwerij">Kom langs in Esen</a>
          <a class="btn light" href="#bieren">Ontdek de bende</a>
        </div>
      </div>

      <div class="hero-collage">
        <Polaroid
          src={toast}
          alt="Zwart-witfoto van de eerste Dolle Brouwers die klinken met Oerbier"
          caption="Begin jaren '80"
          tilt={-4}
          ratio="7 / 5"
          taped
          loading="eager"
          class="c-toast"
        />
        <Polaroid
          src={klinken}
          alt="Vrienden die klinken aan tafel in de Oerbar"
          caption="...en vandaag, in de Oerbar"
          tilt={3}
          ratio="3 / 2"
          loading="eager"
          class="c-proost"
        />
        <Stamp class="c-stamp" size={136} />
        <div class="bende-rij" id="bende-rij">
          <span class="gastheer">
            <Image src={mascot} alt="Het Oerbier-mannetje met brouwersvork en glas" height={240} class="c-mascot" loading="eager" />
          </span>
          {
            bende.map((b) => (
              <span class="lid" aria-hidden="true">
                <span class="val">
                <svg class="parachute" viewBox="0 0 120 92">
                  <path d="M60 60 L8 34 M60 60 L36 30 M60 60 L84 30 M60 60 L112 34" stroke="#21170c" stroke-width="2" fill="none" />
                  <path d="M6 34 Q8 2 60 2 Q112 2 114 34 Q101 25 87 34 Q74 25 60 34 Q46 25 33 34 Q19 25 6 34 Z" fill="#fbfaf5" stroke="#21170c" stroke-width="3" stroke-linejoin="round" />
                  <path d="M33 34 Q35 4 60 2 Q50 10 46 31 Z M87 34 Q85 4 60 2 Q70 10 74 31 Z" fill="#f7b500" />
                  <path d="M6 34 Q8 2 60 2 Q112 2 114 34 Q101 25 87 34 Q74 25 60 34 Q46 25 33 34 Q19 25 6 34 Z" fill="none" stroke="#21170c" stroke-width="3" stroke-linejoin="round" />
                </svg>
                <Image src={b.src} alt="" height={240} loading="eager" />
                </span>
              </span>
            ))
          }
        </div>
        <script is:inline>
          // Hide the bende before first paint when the drop will play (once per visit, not with reduced motion).
          try {
            if (!sessionStorage.getItem('bende-geland') && !matchMedia('(prefers-reduced-motion: reduce)').matches)
              document.getElementById('bende-rij').classList.add('wacht');
          } catch (e) {}
        </script>
      </div>
    </div>
    <div class="edge-bottom"></div>
  </section>

  <!-- TRADITIE -->
  <section class="section tradition">
    <div class="wrap trad-grid">
      <div class="trad-photos">
        <Polaroid src={koelschip} alt="Het koelschip onder het dak" caption="Het koelschip, daterend rond 1900" tilt={-2} ratio="3 / 4" class="t1" />
        <Polaroid src={vergisting} alt="Schuimende gist in een open gistkuip" caption="Open gisting" tilt={2} ratio="4 / 3" class="t2" />
        <Polaroid src={molen} alt="Roerkuip nr. 1 in het brouwhuis" caption="Roerkuip nr. 1, allicht nog ouder" tilt={-1.5} ratio="4 / 3" class="t3" />
      </div>
      <div class="trad-copy">
        <h2>Toen we begonnen, had niemand het over craft.</h2>
        <p class="lead">
          Wij noemden het gewoon bier brouwen zoals het hoort. Met een koelschip, open koperen gistkuipen, hop uit Poperinge en
          gist die zijn tijd krijgt. Het koelschip en de roerkuip dateren van rond 1900 en zijn nog altijd in gebruik. Gesloten
          tanks, filters en snelle recepten? Niet bij ons.
        </p>
        <ol class="years">
          <li><span class="pill">1835</span> Dokter Nevejan start een brouwerij in Esen.</li>
          <li><span class="pill">1980</span> De Dolle Brouwers nemen ze over. Eerste Oerbier op 11 november.</li>
          <li><span class="pill">1998</span> Het eerste Oerbier gaat in oude sherryvaten. De Reserva is geboren.</li>
          <li><span class="pill">Nu</span> Zelfde gebouw, zelfde koelschip, zelfde koppigheid.</li>
        </ol>
        <a class="btn" href="/verhaal">Lees ons verhaal</a>
      </div>
    </div>
  </section>

  <!-- BIEREN -->
  <section class="section beers" id="bieren">
    <div class="edge-top"></div>
    <div class="wrap">
      <div class="beers-head">
        <h2>De bende.</h2>
        <p class="hand">Elk bier een eigen kop, met de hand getekend ↓</p>
      </div>
      <ul class="beer-grid">
        {
          vast.map((b, i) => (
            <li style={`--c:${b.color}; --on:${b.onColor}; --tilt:${[-2, 1.5, -1, 2.5][i % 4]}deg`}>
              <a href={`/bieren/${b.slug}`} class="beer fx-host">
                <span class="beer-art">
                  <BeerFx slug={b.slug} />
                  <Image src={b.art} alt="" width={420} />
                </span>
                <span class="beer-name">{b.name}</span>
                <span class="beer-meta">
                  <strong>{abv(b)}</strong> {b.tagline}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- RESERVA -->
  <section class="section reserva" id="reserva">
    <div class="edge-top"></div>
    <div class="wrap res-grid">
      <div class="res-copy">
        <Image src={reservaLogo} alt="Het Oerbier-mannetje op een wijnvat" width={120} class="res-logo" />
        <h2>Reserva.<br />Geduld op vat.</h2>
        <p class="lead">
          In 1998 legde Kris het eerste Oerbier te slapen in oude sherryvaten. Vanaf dan is de Reserva geboren. Nu nog
          gaat af en toe een brouwsel voor minstens een jaar op rode wijnvaten. Beperkte, genummerde oplage. Op is op.
        </p>
        <ul class="res-list">
          {
            reserva.map((b) => (
              <li>
                <a href={`/bieren/${b.slug}`}>
                  <span>{b.name}</span>
                  <span class="res-abv">{abv(b)}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <Polaroid src={vaten} alt="Rij eiken wijnvaten in de kelder" tilt={3} ratio="4 / 5" taped />
    </div>
  </section>

  <!-- BROUWPROCES -->
  <section class="section process">
    <div class="wrap proc-grid">
      <div class="proc-copy">
        <h2>Van graan tot fles, in tien stappen.</h2>
        <p class="lead">
          Mout, molen, roerkuip, koelschip, open gistkuipen, twee maanden rust en dan nog eens hergisten op de fles. Ons
          Oerbier-mannetje loopt je er stap voor stap door.
        </p>
        <a class="btn dark" href="/brouwproces">Bekijk het brouwproces</a>
      </div>
      <a href="/brouwproces" class="proc-art" aria-label="Naar het brouwproces">
        <Image src={overzicht} alt="Getekende kaart van de tien brouwstappen, met het Oerbier-mannetje bij elke stap" width={900} />
      </a>
    </div>
  </section>

  <!-- BEZOEK -->
  <section class="section visit" id="bezoek">
    <div class="edge-top"></div>
    <div class="wrap">
      <div class="visit-head">
        <h2>Kom proeven waar het gebrouwen wordt.</h2>
        <p class="hand">Roeselarestraat 12B, Esen</p>
      </div>
      <div class="visit-grid">
        <div class="wall">
          <Polaroid src={toog} alt="De toog van de Oerbar met de koperen tapkranen" tilt={-2} ratio="3 / 4" class="w1" />
          <Polaroid src={tap} alt="De barman tapt een glas in de Oerbar" tilt={2} ratio="4 / 3" class="w2" />
          <Polaroid src={proostBar} alt="Een vrouw die lachend haar glas heft in de Oerbar" tilt={-1.5} ratio="4 / 5" class="w3" />
          <Polaroid src={parasols} alt="Het terras met gele parasols naast de brouwerij" tilt={2.5} ratio="4 / 5" class="w4" />
          <Polaroid src={oerbar} alt="De zaal van de Oerbar" tilt={1.5} ratio="4 / 3" class="w5" />
        </div>
        <div class="ticket">
          <div class="ticket-top">
            <span class="tag">Elke zondag</span>
            <h3>Rondleiding met proeverij</h3>
          </div>
          <dl>
            <div><dt>14u</dt><dd>in het Engels</dd></div>
            <div><dt>15u</dt><dd>in het Nederlands</dd></div>
            <div><dt>€10</dt><dd>inclusief drie proevertjes van het vat</dd></div>
          </dl>
          <p>Groepen vanaf 20 personen kunnen ook in de week, op afspraak.</p>
          <div class="ticket-actions">
            <a class="btn" href="/rondleiding-boeken">Boek je plaats</a>
            <a class="ticket-link" href="/brouwerij#bezoek">Meer over je bezoek →</a>
          </div>
          <div class="ticket-foot">
            <strong>Oerbar</strong> open op zaterdag en zondag van 14u tot 19u. Gesloten tijdens de kerstvakantie.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OERSHOP -->
  <Shop />

  <!-- VERKOOPPUNTEN -->
  <section class="section extra" id="verkooppunten">
    <div class="wrap">
      <div class="card where">
        <Polaroid src={flesHop} alt="Een fles Oerbier tussen verse hop" tilt={4} ratio="1 / 1" width={500} class="where-photo" />
        <div>
          <h3>Ook te vinden ver buiten Esen</h3>
          <p>Van Café Pardaf in Antwerpen tot een bierbar in Rome. Kijk waar je in de buurt een De Dolle Brouwers-biertje kan drinken.</p>
          <a class="btn" href="/verkooppunten-kaart">Open de kaart</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // The Oeral plane crosses the hero once; as it passes each spot it drops a member of the bende,
  // who floats down on a parachute and lands next to the Oerbier-mannetje.
  const rij = document.getElementById('bende-rij');
  const plane = document.querySelector<HTMLElement>('.sky .vliegtuig');
  const sky = document.querySelector<HTMLElement>('.sky');

  const drop = () => {
    if (!rij || !plane || !sky) return;
    try {
      sessionStorage.setItem('bende-geland', '1');
    } catch {}
    const skyBox = sky.getBoundingClientRect();
    const pw = plane.offsetWidth;
    const flight = 14000;
    const start = skyBox.width + 20;
    const end = -pw - 40;
    plane.style.visibility = 'visible';
    plane.animate(
      [
        { transform: `translateX(${start}px) rotate(-2deg)` },
        { transform: `translateX(${(start + end) / 2}px) rotate(2deg)` },
        { transform: `translateX(${end}px) rotate(-2deg)` },
      ],
      { duration: flight, easing: 'linear', fill: 'forwards' },
    ).onfinish = () => (plane.style.visibility = 'hidden');

    const leden = [...rij.querySelectorAll<HTMLElement>('.lid')];
    leden.forEach((lid) => {
      const box = lid.getBoundingClientRect();
      const centre = box.left + box.width / 2 - skyBox.left;
      // When the cockpit (about a fifth into the plane) is right above this spot
      const at = ((start - (centre - pw * 0.2)) / (start - end)) * flight;
      const height = box.top - skyBox.top - plane.offsetHeight * 0.5;
      const fall = 5600;
      const chute = lid.querySelector<SVGElement>('.parachute')!;
      const val = lid.querySelector<HTMLElement>('.val')!;
      setTimeout(() => {
        lid.style.visibility = 'visible';
        val.animate(
          [
            { transform: `translateY(${-height}px) rotate(-6deg)`, offset: 0 },
            { transform: `translateY(${-height * 0.62}px) rotate(7deg)`, offset: 0.3 },
            { transform: `translateY(${-height * 0.3}px) rotate(-5deg)`, offset: 0.62 },
            { transform: 'translateY(0) rotate(2deg)', offset: 0.9 },
            { transform: 'translateY(0) scale(1.06, 0.92)', offset: 0.95 },
            { transform: 'none', offset: 1 },
          ],
          { duration: fall, easing: 'cubic-bezier(.3,.1,.6,1)' },
        );
        chute.animate(
          [
            { opacity: 0, transform: 'scale(0.3)', offset: 0 },
            { opacity: 1, transform: 'scale(1)', offset: 0.12 },
            { opacity: 1, transform: 'scale(1)', offset: 0.86 },
            { opacity: 0, transform: 'translateY(20px) scale(0.9, 0.3)', offset: 1 },
          ],
          { duration: fall + 300, easing: 'ease-out' },
        );
      }, at);
    });
  };

  if (rij?.classList.contains('wacht')) {
    rij.querySelectorAll<HTMLElement>('.lid').forEach((l) => (l.style.visibility = 'hidden'));
    rij.classList.remove('wacht');
    // Wait until the figures have their size, then a short beat before the plane comes in.
    const go = () => setTimeout(drop, 600);
    document.readyState === 'complete' ? go() : addEventListener('load', go, { once: true });
  }
</script>

<style>
  /* HERO */
  .hero {
    background: var(--yellow) var(--grain);
    position: relative;
    padding: clamp(40px, 6vw, 80px) 0 clamp(70px, 8vw, 110px);
    z-index: 2;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(30px, 5vw, 70px);
    align-items: center;
  }
  .hero-note {
    margin-bottom: 6px;
    transform: rotate(-3deg);
    width: fit-content;
  }
  .hero h1 {
    font-size: clamp(4rem, 12vw, 9.5rem);
    line-height: 0.86;
    margin-bottom: 26px;
  }
  .hero .lead {
    max-width: 30em;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 26px;
  }
  .hero-collage {
    position: relative;
    min-height: 640px;
    /* Feet on the bottom edge of the yellow, where the paper tears off */
    --grond: calc(-1 * clamp(70px, 8vw, 110px) + 4px);
  }
  .hero-collage :global(.c-toast) {
    position: absolute;
    width: 70%;
    top: 0;
    left: 0;
  }
  .hero-collage :global(.c-proost) {
    position: absolute;
    width: 66%;
    right: 0;
    top: 46%;
    z-index: 1;
  }
  .hero-collage :global(.c-mascot) {
    transform-origin: 50% 100%;
    animation: bob 4s ease-in-out infinite;
  }
  .hero-collage :global(.c-stamp) {
    position: absolute;
    right: 4%;
    top: -14px;
  }
  @keyframes bob {
    50% {
      transform: rotate(2.5deg);
    }
  }
  .hero-grid {
    position: relative;
    z-index: 1;
  }
  .sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 3;
  }
  .sky :global(.vliegtuig) {
    position: absolute;
    top: 14px;
    left: 0;
    width: clamp(190px, 19vw, 280px);
    height: auto;
    visibility: hidden;
    filter: drop-shadow(3px 5px 0 rgba(33, 23, 12, 0.2));
  }
  .bende-rij {
    position: absolute;
    left: -10%;
    right: -6%;
    bottom: var(--grond);
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    pointer-events: none;
  }
  .lid,
  .gastheer {
    position: relative;
    display: block;
  }
  .val {
    display: block;
  }
  .lid :global(img),
  .gastheer :global(img) {
    display: block;
    height: clamp(64px, 6.6vw, 100px);
    width: auto;
    filter: drop-shadow(3px 5px 0 rgba(33, 23, 12, 0.22));
  }
  .parachute {
    position: absolute;
    left: 50%;
    bottom: 78%;
    width: 140%;
    translate: -50% 0;
    transform-origin: 50% 100%;
    opacity: 0;
  }
  .bende-rij.wacht .lid {
    visibility: hidden;
  }

  /* TRADITION */
  .trad-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(36px, 6vw, 90px);
    align-items: center;
  }
  .trad-photos {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 26px 22px;
    align-items: start;
  }
  .trad-photos :global(.t1) {
    grid-row: 1 / 3;
    align-self: center;
  }
  .trad-photos :global(.t3) {
    margin-left: -18px;
  }
  .trad-copy h2 {
    margin-bottom: 22px;
  }
  .years {
    list-style: none;
    padding: 0;
    margin: 28px 0 32px;
    display: grid;
    gap: 14px;
  }
  .years li {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 14px;
    align-items: center;
  }
  .years .pill {
    text-align: center;
  }

  /* BEERS */
  .beers {
    background: var(--paper-deep) var(--grain);
  }
  .beers-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 44px;
  }
  .beers-head .hand {
    transform: rotate(-2deg);
  }
  .beer-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px 26px;
  }
  .beer {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--paper-light);
    border: var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transform: rotate(var(--tilt));
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    height: 100%;
  }
  .beer:hover {
    transform: rotate(0deg) translateY(-6px);
    box-shadow: 10px 12px 0 var(--ink);
  }
  .beer-art {
    background: var(--c);
    border-bottom: var(--line);
    aspect-ratio: 1;
    padding: 18px;
  }
  .beer-art {
    position: relative;
    overflow: hidden;
    container-type: size;
  }
  .beer-art :global(img) {
    position: absolute;
    inset: 18px;
    width: calc(100% - 36px);
    height: calc(100% - 36px);
    object-fit: contain;
    z-index: 1;
    transition: transform 0.25s ease;
