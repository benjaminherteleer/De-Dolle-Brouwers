<style is:global>
  :root{
    --yellow:#F7B500;
    --yellow-deep:#E0A200;
    --yellow-pale:#FDE9AE;
    --ink:#201607;
    --moss:#1C130A;
    --moss-deep:#120C05;
    --rust:#B5451B;
    --cream:#FBF6E9;
    --white:#FFFDF7;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0; background:var(--cream); color:var(--ink);
    font-family:'Public Sans', sans-serif; font-size:16px; line-height:1.55;
  }
  h1,h2,h3{font-family:'Fraunces', serif; font-weight:700; margin:0; color:var(--ink); line-height:1.08;}
  a{color:inherit;}
  .wrap{max-width:1180px; margin:0 auto; padding:0 32px;}
  img.ph{display:block;}

  /* ===== Nav ===== */
  nav{position:sticky; top:0; z-index:50; background:var(--cream); border-bottom:2px solid var(--ink);}
  nav .wrap{display:flex; align-items:center; justify-content:space-between; padding:16px 32px;}
  .brandmark{display:flex; align-items:center; gap:10px; font-family:'Fraunces', serif; font-weight:700; font-size:19px; text-decoration:none; color:var(--ink);}
  .brandmark .glyph{
    width:40px; height:40px;
    display:flex; align-items:center; justify-content:center;
  }
  .brandmark .glyph img{width:100%; height:100%; object-fit:contain;}
  .brandmark .wordmark{height:46px; width:auto; display:block;}
  nav ul{list-style:none; display:flex; gap:22px; margin:0; padding:0;}
  .nav-toggle{display:none;}
  .nav-burger{display:none; flex-direction:column; gap:5px; cursor:pointer; width:28px; padding:4px; background:none; border:none;}
  .nav-burger span{display:block; height:3px; background:var(--ink); border-radius:2px;}
  .nav-menu{display:flex; align-items:center; gap:22px;}
  @media(max-width:860px){
    nav .wrap{position:relative;}
    .nav-burger{display:flex;}
    .nav-menu{
      display:none; position:absolute; top:100%; left:0; right:0; background:var(--cream);
      flex-direction:column; align-items:flex-start; padding:20px 32px 26px; border-bottom:2px solid var(--ink);
      gap:6px; z-index:100;
    }
    .nav-menu ul{flex-direction:column; align-items:flex-start; gap:4px; width:100%;}
    .nav-menu ul li{width:100%;}
    .nav-menu .nav-link{display:block; padding:10px 0; width:100%;}
    .nav-toggle:checked ~ .nav-menu{display:flex;}
  }
  nav a.nav-link{text-decoration:none; color:var(--ink); font-size:14.5px; font-weight:600;}
  nav a.nav-link:hover{color:var(--rust);}
  nav .cta{background:var(--ink); color:var(--yellow); text-decoration:none; padding:10px 20px; border-radius:30px; font-size:14px; font-weight:700;}

  /* ===== Hero ===== */
  header.hero{background:var(--yellow); position:relative; overflow:hidden; padding:70px 0;}
  .hero-inner{position:relative; z-index:2; display:grid; grid-template-columns:1.05fr 0.95fr; gap:56px; align-items:center; text-align:left;}
  .hero-photo{position:relative;}
  .hero-photo img{width:100%; border-radius:16px; border:3px solid var(--ink); display:block; filter:grayscale(1) contrast(1.05);}
  .hero-photo .hero-photo-badge{position:absolute; bottom:-18px; left:-18px; background:var(--ink); color:var(--yellow); font-family:'Fraunces',serif; font-weight:700; font-size:14px; padding:12px 18px; border-radius:30px; box-shadow:0 4px 10px rgba(0,0,0,0.25);}
  @media(max-width:860px){.hero-inner{grid-template-columns:1fr; text-align:center;} .hero-photo{max-width:420px; margin:0 auto;}}
  .hero-kicker{font-size:14.5px; font-weight:700; letter-spacing:0.3px; color:var(--ink);}
  .hero-title{
    font-size:clamp(56px, 10vw, 128px); line-height:0.92; font-weight:900;
    color:var(--ink); margin-top:14px; letter-spacing:-1px;
  }
  .hero-sub{font-size:17px; max-width:440px; margin:22px auto 0; color:#3a2c10;}
  .hero-cta{
    display:inline-block; margin-top:30px; background:var(--ink); color:var(--yellow);
    text-decoration:none; padding:15px 30px; border-radius:30px; font-weight:700; font-size:15px;
  }
  .hero-actions{display:flex; align-items:center; gap:24px; flex-wrap:wrap;}
  .btn-ghost-dark{color:var(--ink); text-decoration:none; border-bottom:2px solid var(--ink); font-weight:700; font-size:14.5px; padding-bottom:2px;}
  .hero-bottles{
    display:flex; justify-content:center; align-items:flex-end; gap:0;
    margin-top:56px; padding-bottom:0;
  }
  .bottle{width:64px; height:170px; flex-shrink:0;}
  .bottle:nth-child(2n){transform:translateY(-14px);}
  .bottle:nth-child(3n){transform:translateY(10px);}

  /* ===== Beer showcase ===== */
  section{padding:100px 0;}
  .section-head{text-align:center; max-width:560px; margin:0 auto 56px;}
  .section-head .tag{font-size:13.5px; font-weight:700; color:var(--rust); display:block; margin-bottom:10px;}
  .section-head h2{font-size:clamp(30px,3.6vw,44px);}

  .beer-grid{
    display:grid; grid-template-columns:repeat(4, 1fr); gap:8px;
  }
  .beer-card{
    text-align:center; text-decoration:none; color:var(--ink);
    padding:28px 14px; border-radius:16px; transition:background .15s ease;
    display:flex; flex-direction:column;
  }
  .beer-card:hover{background:var(--yellow-pale);}
  .beer-card .bottle-wrap{height:280px; display:flex; align-items:center; justify-content:center; margin-bottom:18px;}
  .beer-card .bottle-wrap img{height:225px; width:auto; max-width:100%; object-fit:contain;}
  .beer-card h3{font-size:19px; font-weight:700;}
  .beer-card .abv{font-size:13px; color:#6b5a3a; margin-top:4px;}
  .beer-card .keywords{display:block; font-size:11.5px; color:var(--rust); margin-top:6px; font-weight:600; letter-spacing:0.2px; min-height:28px;}
  .beer-card .arrow{
    display:inline-block; width:26px; height:26px; border-radius:50%;
    border:1.5px solid var(--ink); font-size:13px; line-height:23px; text-align:center;
    align-self:center; margin-top:auto; margin-bottom:0;
  }
  @media(max-width:900px){.beer-grid{grid-template-columns:repeat(2,1fr);}}

  /* ===== Reserva ===== */
  .reserva{background:var(--white);}
  .reserva-head{
    display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:end; margin-bottom:52px;
  }
  .reserva-head .tag{font-size:13.5px; font-weight:700; color:var(--rust); display:block; margin-bottom:10px;}
  .reserva-head h2{font-size:clamp(30px,3.6vw,44px); max-width:460px;}
  .reserva-head p{color:#413623; font-size:15px; max-width:420px;}
  @media(max-width:800px){.reserva-head{grid-template-columns:1fr; gap:20px;}}

  .reserva-grid{display:grid; grid-template-columns:repeat(3, 1fr); gap:24px;}
  .reserva-card{
    background:var(--moss-deep); color:var(--yellow-pale); border-radius:20px; padding:34px 28px;
    display:flex; flex-direction:column;
  }
  .reserva-card .barrel{
    width:44px; height:44px; border-radius:50%; background:var(--rust);
    display:flex; align-items:center; justify-content:center; margin-bottom:22px;
    font-family:'Fraunces',serif; font-style:italic; color:var(--white); font-size:13px;
    overflow:hidden;
  }
  .reserva-card .barrel img{width:85%; height:85%; object-fit:contain;}
  .reserva-card h3{color:var(--yellow-pale); font-size:20px; margin-bottom:8px;}
  .reserva-card .abv{font-size:13px; color:#c9a24a; margin-bottom:14px;}
  .reserva-card p{font-size:14px; color:#e3d6b0; margin:0;}
  @media(max-width:900px){.reserva-grid{grid-template-columns:1fr;}}

  .photo-strip{width:100%; max-height:420px; overflow:hidden;}
  .photo-strip img{width:100%; height:420px; object-fit:cover; display:block;}
  @media(max-width:760px){.photo-strip img{height:240px;}}

  /* ===== Bold band ===== */
  .band{background:var(--moss); color:var(--yellow-pale); text-align:center; padding:110px 0;}
  .band h2{color:var(--yellow-pale); font-size:clamp(34px,5vw,58px); line-height:1.05;}
  .band p{color:#e3d6b0; max-width:440px; margin:20px auto 0; font-size:15.5px;}
  .band .btn-outline{
    display:inline-block; margin-top:30px; border:1.5px solid var(--yellow); color:var(--yellow-pale);
    text-decoration:none; padding:13px 26px; border-radius:30px; font-weight:700; font-size:14.5px;
  }

  /* ===== Story split ===== */
  .story{display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center;}
  .story-img{
    aspect-ratio:4/3; background:var(--yellow-pale); border-radius:20px;
    display:flex; align-items:center; justify-content:center; color:var(--yellow-deep);
    font-family:'Fraunces',serif; font-style:italic; font-size:15px;
    overflow:hidden;
  }
  .story-img img{width:100%; height:100%; object-fit:cover; display:block;}
  .story-copy .tag{font-size:13.5px; font-weight:700; color:var(--rust); display:block; margin-bottom:12px;}
  .story-copy h2{font-size:clamp(28px,3.4vw,40px); margin-bottom:16px;}
  .story-copy p{color:#413623; font-size:15.5px; max-width:440px;}
  .story-copy .link{display:inline-block; margin-top:22px; font-weight:700; text-decoration:none; color:var(--ink); border-bottom:2px solid var(--yellow);}
  @media(max-width:800px){.story{grid-template-columns:1fr;}}

  /* ===== Visit ===== */
  .visit{background:var(--white);}
  .visit-inner{display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center;}
  .visit-inner.reverse .story-img{order:2;}
  @media(max-width:800px){.visit-inner{grid-template-columns:1fr;} .visit-inner.reverse .story-img{order:0;}}

  /* ===== Merch ===== */
  .merch-grid{display:grid; grid-template-columns:repeat(5,1fr); gap:22px;}
  .merch-card{text-align:left;}
  .merch-thumb{
    aspect-ratio:1; background:var(--yellow-pale); border-radius:16px; margin-bottom:14px;
    display:flex; align-items:center; justify-content:center; color:var(--yellow-deep); font-size:13px;
  }
  .merch-card h4{font-size:15px; font-weight:600; margin:0 0 4px;}
  .merch-card .price{font-size:14px; color:var(--rust); font-weight:700;}
  @media(max-width:900px){.merch-grid{grid-template-columns:repeat(3,1fr);}}
  @media(max-width:600px){.merch-grid{grid-template-columns:repeat(2,1fr);}}

  /* ===== News ===== */
  .news{background:var(--yellow-pale);}
  .news-inner{display:grid; grid-template-columns:0.9fr 1.1fr; gap:56px; align-items:center; background:var(--white); border-radius:24px; padding:48px; }
  .news-thumb{aspect-ratio:4/3; background:var(--yellow); border-radius:16px;}
  .news-copy .tag{font-size:13px; font-weight:700; color:var(--rust); display:block; margin-bottom:10px;}
  .news-copy h3{font-size:24px; margin-bottom:12px;}
  .news-copy p{font-size:14.5px; color:#413623;}
  .news-copy .link{display:inline-block; margin-top:16px; font-weight:700; text-decoration:none; border-bottom:2px solid var(--ink);}
  @media(max-width:800px){.news-inner{grid-template-columns:1fr; padding:28px;}}

  /* ===== Footer / newsletter ===== */
  footer{background:var(--moss-deep); color:#e3d6b0;}
  .foot-top{
    display:grid; grid-template-columns:1.1fr 1fr; gap:64px;
    padding:80px 0 56px; border-bottom:1px solid rgba(247,181,0,0.2);
  }
  .foot-top h3{color:var(--yellow); font-size:30px; max-width:420px;}
  .foot-top p{color:#cbbe97; font-size:14.5px; margin-top:14px; max-width:400px;}
  .newsletter-form{display:flex; margin-top:24px; max-width:400px; border-bottom:1.5px solid var(--yellow);}
  .newsletter-form input{flex:1; background:none; border:none; color:var(--white); font-size:15px; padding:10px 0;}
  .newsletter-form input::placeholder{color:#8a7a54;}
  .newsletter-form button{background:none; border:none; color:var(--yellow); font-weight:700; font-size:14px; cursor:pointer;}
  .foot-cols{display:flex; gap:56px; flex-wrap:wrap;}
  .foot-cols div span{display:block; font-size:13px; color:var(--yellow); font-weight:700; margin-bottom:14px;}
  .foot-cols a{display:block; text-decoration:none; color:#cbbe97; font-size:14px; padding:5px 0;}
  .social-row{display:flex; gap:12px; margin-top:4px;}
  .social-icon{width:40px; height:40px; border-radius:50%; background:var(--yellow); color:var(--ink); display:flex; align-items:center; justify-content:center; text-decoration:none; flex-shrink:0;}
  .social-icon svg{width:19px; height:19px;}
  .social-icon:hover{background:var(--cream);}
  .foot-bottom{display:flex; justify-content:space-between; padding:24px 0; font-size:12.5px; color:#7d6f52;}
  @media(max-width:800px){.foot-top{grid-template-columns:1fr;} .foot-cols{gap:32px;}}
</style>
