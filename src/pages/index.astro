---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Polaroid from '../components/Polaroid.astro';
import Stamp from '../components/Stamp.astro';
import BeerFx from '../components/BeerFx.astro';
import { vast, reserva, abv } from '../lib/bieren';

import toast from '../assets/foto/historische-toast.jpg';
import klinken from '../assets/foto/oerbar-klinken.jpg';
import koelschip from '../assets/foto/bp-koelschip.jpg';
import vergisting from '../assets/foto/bp-gisting.jpg';
import molen from '../assets/foto/bp-roerkuip.jpg';
import overzicht from '../assets/brouwproces/overzicht.jpg';
import parasols from '../assets/foto/terras-parasols.jpg';
import vaten from '../assets/foto/vaten-rij.jpg';
import toog from '../assets/foto/oerbar-toog.jpg';
import proostBar from '../assets/foto/oerbar-proost.jpg';
import kaarten from '../assets/foto/oerbar-kaarten.jpg';
import truien from '../assets/foto/shop-truien.jpg';
import tshirt from '../assets/foto/shop-tshirt.jpg';
import hoodie from '../assets/foto/shop-hoodie.jpg';
import reservaLogo from '../assets/logo/reserva-logo.png';

import handtekening from '../assets/kris/handtekening.png';
import aqToren from '../assets/kris/aquarel-toren.jpg';
import aqStraat from '../assets/kris/aquarel-straat.jpg';
import brugge from '../assets/kris/brugge.jpg';
import affOerbier from '../assets/affiches/oerbier.jpg';
import affArabier from '../assets/affiches/arabier.jpg';
import affBoskeun from '../assets/affiches/boskeun.jpg';
import affTeve from '../assets/affiches/dulle-teve.jpg';
import affNacht from '../assets/affiches/stille-nacht.jpg';

const affiches = [
  { src: affOerbier, alt: 'Affiche van Oerbier', tilt: -4 },
  { src: affArabier, alt: 'Affiche van Arabier', tilt: 3 },
  { src: affTeve, alt: 'Affiche van Dulle Teve', tilt: -2 },
  { src: affBoskeun, alt: 'Affiche van Boskeun', tilt: 4 },
  { src: affNacht, alt: 'Affiche van Stille Nacht', tilt: -3 },
];

---

<Base
  title="De Dolle Brouwers | Oerbier, gebrouwen in Esen sinds 1980"
  description="Ambachtelijke brouwerij in Esen bij Diksmuide, sinds 1980. Ongefilterd, hoog gegist bier: Oerbier, Arabier, Boskeun, Dulle Teve, Stille Nacht en de Reserva's. Rondleiding elke zondag, Oerbar open in het weekend."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://www.oerbier.be/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="De Dolle Brouwers | Oerbier uit Esen, sinds 1980" />
    <meta
      property="og:description"
      content="Ongefilterd, hoog gegist bier uit Esen. Kom proeven in de Oerbar of volg een rondleiding op zondag."
    />
    <meta property="og:locale" content="nl_BE" />
    <meta name="robots" content="index, follow" />
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Brewery",
        "name": "De Dolle Brouwers",
        "alternateName": "Oerbier",
        "url": "https://www.oerbier.be/",
        "description": "Ambachtelijke specialiteitsbrouwerij in Esen (Diksmuide), West-Vlaanderen, sinds 1980. Bekend van Oerbier, Arabier, Boskeun, Dulle Teve, Stille Nacht, Export Stout en Oeral.",
        "foundingDate": "1980",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Roeselarestraat 12B",
          "postalCode": "8600",
          "addressLocality": "Esen (Diksmuide)",
          "addressRegion": "West-Vlaanderen",
          "addressCountry": "BE"
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Saturday", "Sunday"],
            "opens": "14:00",
            "closes": "19:00"
          }
        ],
        "email": "info@dedollebrouwers.be"
      }
    </script>
  </Fragment>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-copy">
      <p class="hero-kicker">De Dolle Brouwers · Esen · sinds 1980</p>
      <h1>Nat<br />en straf.</h1>
      <p class="lead">Bier zoals wij het willen. Ongefilterd, hoog gegist en zonder haast.</p>
      <div class="hero-actions">
        <a class="btn dark" href="/brouwerij">Kom langs →</a>
        <a class="btn light" href="#bieren">Ontdek de bieren</a>
      </div>
    </div>
    <div class="hero-photo">
      <Image src={klinken} alt="Vrienden die klinken aan tafel in de Oerbar" width={1600} class="hero-img" loading="eager" />
      <Polaroid
        src={toast}
        alt="Zwart-witfoto van de eerste Dolle Brouwers die klinken met Oerbier"
        caption="Zo klonk het begin jaren '80"
        tilt={-4}
        ratio="7 / 5"
        width={600}
        taped
        loading="eager"
        class="hero-pol"
      />
      <Stamp class="hero-stamp" size={130} />
    </div>
    <div class="edge-bottom"></div>
  </section>

  <!-- TRADITIE -->
  <section class="section tradition">
    <div class="wrap trad-grid">
      <div class="trad-photos">
        <Polaroid src={koelschip} alt="Het koelschip onder het dak" caption="Het koelschip, sinds dag één" tilt={-2} ratio="3 / 4" class="t1" />
        <Polaroid src={vergisting} alt="Schuimende gist in een open gistkuip" caption="Open gisting" tilt={2} ratio="4 / 3" class="t2" />
        <Polaroid src={molen} alt="Roerkuip nr. 1 in het brouwhuis" caption="Roerkuip nr. 1" tilt={-1.5} ratio="4 / 3" class="t3" />
      </div>
      <div class="trad-copy">
        <h2>Toen we begonnen, had niemand het over craft.</h2>
        <p class="lead">
          Wij noemden het gewoon bier brouwen zoals het hoort. Met een koelschip, open koperen gistkuipen, hop uit Poperinge en
          gist die zijn tijd krijgt. Gesloten tanks, filters en snelle recepten? Niet bij ons.
        </p>
        <ol class="years">
          <li><span class="pill">1835</span> Dokter Nevejan start een brouwerij in Esen.</li>
          <li><span class="pill">1980</span> De Dolle Brouwers nemen ze over. Eerste Oerbier op 11 november.</li>
          <li><span class="pill">1998</span> Het eerste Oerbier gaat in oude sherryvaten. De Reserva is geboren.</li>
          <li><span class="pill">Nu</span> Zelfde gebouw, zelfde koelschip, zelfde koppigheid.</li>
        </ol>
        <a class="btn" href="/brouwerij#verhaal">Lees ons verhaal</a>
      </div>
    </div>
  </section>

  <!-- BIEREN -->
  <section class="section beers" id="bieren">
    <div class="edge-top"></div>
    <div class="wrap">
      <div class="beers-head">
        <h2>De bende.</h2>
        <p class="hand">Elk bier een eigen kop, met de hand getekend ↓</p>
      </div>
      <ul class="beer-grid">
        {
          vast.map((b, i) => (
            <li style={`--c:${b.color}; --on:${b.onColor}; --tilt:${[-2, 1.5, -1, 2.5][i % 4]}deg`}>
              <a href={`/bieren/${b.slug}`} class="beer fx-host">
                <span class="beer-art">
                  <BeerFx slug={b.slug} />
                  <Image src={b.art} alt="" width={420} />
                </span>
                <span class="beer-name">{b.name}</span>
                <span class="beer-meta">
                  <strong>{abv(b)}</strong> {b.tagline}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- RESERVA -->
  <section class="section reserva" id="reserva">
    <div class="edge-top"></div>
    <div class="wrap res-grid">
      <div class="res-copy">
        <Image src={reservaLogo} alt="Het Oerbier-mannetje op een wijnvat" width={120} class="res-logo" />
        <h2>Reserva.<br />Geduld op vat.</h2>
        <p class="lead">
          In 1998 legde Kris het eerste Oerbier te slapen in oude sherryvaten. Vanaf dan is de Reserva geboren. Nu nog
          gaat af en toe een brouwsel voor minstens een jaar op rode wijnvaten. Beperkte, genummerde oplage. Op is op.
        </p>
        <ul class="res-list">
          {
            reserva.map((b) => (
              <li>
                <a href={`/bieren/${b.slug}`}>
                  <span>{b.name}</span>
                  <span class="res-abv">{abv(b)}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <Polaroid src={vaten} alt="Rij eiken wijnvaten in de kelder" caption="Stil liggen en wachten" tilt={3} ratio="4 / 5" taped />
    </div>
  </section>

  <!-- BROUWPROCES -->
  <section class="section process">
    <div class="wrap proc-grid">
      <div class="proc-copy">
        <h2>Van graan tot fles, in tien stappen.</h2>
        <p class="lead">
          Mout, molen, roerkuip, koelschip, open gistkuipen, twee maanden rust en dan nog eens hergisten op de fles. Ons
          Oerbier-mannetje loopt je er stap voor stap door.
        </p>
        <a class="btn dark" href="/brouwproces">Bekijk het brouwproces</a>
      </div>
      <a href="/brouwproces" class="proc-art" aria-label="Naar het brouwproces">
        <Image src={overzicht} alt="Getekende kaart van de tien brouwstappen, met het Oerbier-mannetje bij elke stap" width={900} />
      </a>
    </div>
  </section>

  <!-- OERBAR -->
  <section class="section oerbar" id="bezoek">
    <div class="edge-top"></div>
    <div class="wrap">
      <div class="oerbar-head">
        <div>
          <p class="hero-kicker">Naast de brouwerij</p>
          <h2>De Oerbar.</h2>
        </div>
        <p class="lead">
          Hier drink je alles wat we brouwen, ook Oeral, dat je enkel hier van het vat krijgt. Een kaartje leggen mag. Haast
          hebben niet.
        </p>
      </div>

      <div class="oerbar-grid">
        <Polaroid src={toog} alt="De toog van de Oerbar met de koperen tapkranen" caption="De toog" tilt={-2} ratio="3 / 4" class="o1" />
        <Polaroid src={proostBar} alt="Een vrouw die lachend het glas heft in de Oerbar" tilt={2.5} ratio="4 / 5" class="o2" />
        <Polaroid src={kaarten} alt="Vrienden die kaarten aan een tafel in de Oerbar" caption="Zondagnamiddag" tilt={-1.5} ratio="4 / 5" class="o3" />
        <Polaroid src={parasols} alt="Het terras met gele parasols" caption="Het terras, bij mooi weer" tilt={2} ratio="4 / 3" class="o4" />

        <div class="ticket o5">
          <div class="ticket-top">
            <span class="tag">Open</span>
            <h3>Zaterdag &amp; zondag<br />14u – 19u</h3>
          </div>
          <dl>
            <div><dt>Zondag</dt><dd>Rondleiding om 14u (Engels) en 15u (Nederlands)</dd></div>
            <div><dt>€10</dt><dd>Inclusief drie proevertjes van het vat</dd></div>
            <div><dt>Groep?</dt><dd>Vanaf 20 personen, ook in de week, op afspraak</dd></div>
          </dl>
          <div class="ticket-actions">
            <a class="btn" href="/brouwerij">Plan je bezoek →</a>
          </div>
          <div class="ticket-foot">Roeselarestraat 12B, Esen. Gesloten tijdens de kerstvakantie.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- AFFICHES -->
  <section class="section posters">
    <div class="wrap">
      <div class="kris">
        <div class="kris-copy">
          <h2><a href="https://krisherteleer.com" target="_blank" rel="noopener" class="kris-link">Kris Herteleer ↗</a></h2>
          <Image src={handtekening} alt="Handtekening van Kris Herteleer" width={420} class="kris-sig" />
          <p class="lead">
            Brouwt mee sinds 1980 en tekent alles wat je van ons ziet: de etiketten, de affiches, het Oerbier-mannetje en de
            rest van de bende. Op zondag geeft hij zelf de rondleiding.
          </p>
          <p>Tussen twee brouwsels door schildert hij steden, gebouwen en mensen.</p>
        </div>
        <div class="kris-art">
          <Polaroid src={aqToren} alt="Aquarel van Kris Herteleer: een stad met een toren" tilt={-3} ratio="4 / 3" width={600} class="ka1" />
          <Polaroid src={aqStraat} alt="Aquarel van Kris Herteleer: een straat met gevels" tilt={2.5} ratio="3 / 4" width={500} class="ka2" />
          <Polaroid src={brugge} alt="Pentekening van Kris Herteleer: Brugge" tilt={-1.5} ratio="4 / 3" width={600} class="ka3" />
        </div>
      </div>
      <p class="posters-intro">En natuurlijk: elk bier zijn eigen affiche.</p>
      <div class="poster-row">
        {
          affiches.map((a) => (
            <figure class="poster" style={`--tilt:${a.tilt}deg`}>
              <Image src={a.src} alt={a.alt} width={420} />
            </figure>
          ))
        }
      </div>
      <p class="posters-more">
        <a class="btn light" href="https://krisherteleer.com" target="_blank" rel="noopener">Meer werk van Kris ↗</a>
      </p>
    </div>
  </section>

  <!-- OERSHOP -->
  <section class="section shop" id="shop">
    <div class="wrap">
      <div class="shop-head">
        <h2>Oershop.</h2>
        <p class="lead">
          Truien, T-shirts, glazen (€6,50) en borden met de bende erop. Te koop in de Oerbar, of mail naar{' '}
          <a href="mailto:boniface@dedollebrouwers.be">boniface@dedollebrouwers.be</a>. Een echte webshop is er (nog) niet.
        </p>
      </div>
      <div class="shop-grid">
        <figure class="shop-item">
          <Image src={truien} alt="Zwarte en grijze truien van De Dolle Brouwers aan een groen paneel" width={700} />
          <figcaption><b>Crewneck</b><span>€50</span></figcaption>
        </figure>
        <figure class="shop-item">
          <Image src={tshirt} alt="Wit T-shirt met de bende van De Dolle Brouwers op de toog" width={700} />
          <figcaption><b>T-shirt</b><span>€20</span></figcaption>
        </figure>
        <figure class="shop-item">
          <Image src={hoodie} alt="Rugkant van een zwarte hoodie met het De Dolle Brouwers-logo in goud" width={700} />
          <figcaption><b>Trui</b><span>€50 · met rits €60</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- VERKOOPPUNTEN -->
  <section class="where-strip" id="verkooppunten">
    <div class="wrap where-inner">
      <p>
        <b>Niet in Esen?</b> Je vindt ons bier in meer dan 40 cafés en winkels, van Antwerpen tot Rome en San Diego.
      </p>
      <a class="btn light" href="/verkooppunten-kaart">Bekijk de kaart →</a>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    min-height: min(86vh, 820px);
    background: var(--yellow) var(--grain);
    z-index: 2;
  }
  .hero-copy {
    padding: clamp(50px, 7vw, 100px) clamp(24px, 4vw, 60px) clamp(70px, 8vw, 110px)
      max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero h1 {
    font-size: clamp(4rem, 11vw, 9rem);
    line-height: 0.86;
    margin-bottom: 26px;
  }
  .hero .lead {
    max-width: 24em;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 26px;
  }
  .hero-photo {
    position: relative;
    min-height: 460px;
    border-left: var(--line);
  }
  .hero-photo :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 50%;
  }
  .hero-photo :global(.hero-pol) {
    position: absolute;
    width: min(330px, 46%);
    left: -70px;
    bottom: 70px;
    z-index: 2;
  }
  .hero-photo :global(.hero-stamp) {
    position: absolute;
    top: 28px;
    left: -64px;
    z-index: 3;
  }

  /* TRADITION */
  .trad-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(36px, 6vw, 90px);
    align-items: center;
  }
  .trad-photos {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 26px 22px;
    align-items: start;
  }
  .trad-photos :global(.t1) {
    grid-row: 1 / 3;
    align-self: center;
  }
  .trad-photos :global(.t3) {
    margin-left: -18px;
  }
  .trad-copy h2 {
    margin-bottom: 22px;
  }
  .years {
    list-style: none;
    padding: 0;
    margin: 28px 0 32px;
    display: grid;
    gap: 14px;
  }
  .years li {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 14px;
    align-items: center;
  }
  .years .pill {
    text-align: center;
  }

  /* BEERS */
  .beers {
    background: var(--paper-deep) var(--grain);
  }
  .beers-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 44px;
  }
  .beers-head .hand {
    transform: rotate(-2deg);
  }
  .beer-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px 26px;
  }
  .beer {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--paper-light);
    border: var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transform: rotate(var(--tilt));
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    height: 100%;
  }
  .beer:hover {
    transform: rotate(0deg) translateY(-6px);
    box-shadow: 10px 12px 0 var(--ink);
  }
  .beer-art {
    background: var(--c);
    border-bottom: var(--line);
    aspect-ratio: 1;
    padding: 18px;
  }
  .beer-art {
    position: relative;
    overflow: hidden;
    container-type: size;
  }
  .beer-art :global(img) {
    position: absolute;
    inset: 18px;
    width: calc(100% - 36px);
    height: calc(100% - 36px);
    object-fit: contain;
    z-index: 1;
    transition: transform 0.25s ease;
  }
  .beer:hover .beer-art :global(img) {
    transform: scale(1.06) rotate(-4deg);
  }
  .beer-name {
    font-family: var(--font-display);
    font-weight: 650;
    font-variation-settings: 'SOFT' 0, 'WONK' 0;
    font-size: 1.6rem;
    padding: 14px 18px 2px;
    line-height: 1.05;
  }
  .beer-meta {
    padding: 0 18px 18px;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  /* RESERVA */
  .reserva {
    background: #1d1812 var(--grain);
    color: var(--paper);
  }
  .res-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(36px, 6vw, 80px);
    align-items: center;
  }
  .res-copy :global(.res-logo) {
    width: 70px;
    margin-bottom: 18px;
  }
  .res-copy h2 {
    margin-bottom: 20px;
    color: var(--yellow);
  }
  .res-list {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    border-top: 2px dashed rgba(244, 233, 215, 0.35);
  }
  .res-list a {
    display: flex;
    justify-content: space-between;
    padding: 14px 4px;
    border-bottom: 2px dashed rgba(244, 233, 215, 0.35);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.35rem;
    transition:
      color 0.15s,
      padding 0.15s;
  }
  .res-list a:hover {
    color: var(--yellow);
    padding-left: 12px;
  }
  .res-abv {
    font-family: var(--font-hand);
    font-style: italic;
    font-weight: 400;
    font-size: 1.5rem;
    color: var(--yellow);
  }

  /* PROCESS */
  .proc-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(30px, 5vw, 70px);
    align-items: center;
  }
  .proc-copy h2 {
    margin-bottom: 20px;
  }
  .proc-copy .btn {
    margin-top: 10px;
  }
  .proc-art {
    display: block;
    transition: transform 0.25s ease;
  }
  .proc-art:hover {
    transform: rotate(-1deg) scale(1.01);
  }
  .proc-art :global(img) {
    width: 100%;
    border-radius: 20px;
  }

  /* POSTERS */
  .posters-head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 50px;
  }
  .posters-head h2 {
    margin-bottom: 18px;
  }
  .posters-head .lead {
    margin: 0 auto;
  }
  .poster-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
    align-items: center;
  }
  .poster {
    margin: 0;
    border: var(--line);
    box-shadow: var(--shadow);
    transform: rotate(var(--tilt));
    transition: transform 0.2s ease;
    background: #fff;
  }
  .poster:hover {
    transform: rotate(0) scale(1.06);
    z-index: 2;
  }
  .poster :global(img) {
    width: 100%;
    aspect-ratio: 5 / 7;
    object-fit: cover;
  }
  .posters-more {
    text-align: center;
    margin-top: 44px;
  }

  /* KRIS */
  .kris {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(30px, 6vw, 80px);
    align-items: center;
    margin-bottom: 80px;
  }
  .kris h2 {
    font-size: clamp(2.8rem, 6vw, 4.8rem);
  }
  .kris-link {
    text-decoration: none;
  }
  .kris-link:hover {
