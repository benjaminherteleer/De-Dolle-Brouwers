<Base title={'De Dolle Brouwers — Ambachtelijke brouwerij in Esen (West-Vlaanderen) | Oerbier'} description={'De Dolle Brouwers is een ambachtelijke brouwerij in Esen bij Diksmuide, West-Vlaanderen — sinds 1980. Ontdek Oerbier, Arabier, Boskeun, Dulle Teve, Stille Nacht en onze Reserva-bieren, of plan een brouwerijbezoek in de Oerbar.'} footer={false}>
<Fragment slot="head">
<link rel="canonical" href="https://www.oerbier.be/">
<meta property="og:type" content="website">
<meta property="og:title" content="De Dolle Brouwers — Ambachtelijke brouwerij in Esen, West-Vlaanderen">
<meta property="og:description" content="Ontdek Oerbier, Arabier, Boskeun, Dulle Teve, Stille Nacht en onze Reserva-bieren. Plan een brouwerijbezoek in Esen bij Diksmuide.">
<meta property="og:locale" content="nl_BE">
<meta name="robots" content="index, follow">
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Brewery",
  "name": "De Dolle Brouwers",
  "alternateName": "Oerbier",
  "url": "https://www.oerbier.be/",
  "description": "Ambachtelijke specialiteitsbrouwerij in Esen (Diksmuide), West-Vlaanderen, sinds 1980. Bekend van Oerbier, Arabier, Boskeun, Dulle Teve, Stille Nacht, Export Stout en Oeral.",
  "foundingDate": "1980",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Roeselarestraat 12B",
    "postalCode": "8600",
    "addressLocality": "Esen (Diksmuide)",
    "addressRegion": "West-Vlaanderen",
    "addressCountry": "BE"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday", "Sunday"],
      "opens": "14:00",
      "closes": "19:00"
    }
  ],
  "email": "info@dedollebrouwers.be"
}
</script>
</Fragment>

<header class="hero">
  <div class="wrap hero-inner">
    <div>
      <span class="hero-kicker">Ambachtelijke brouwerij in Esen, West-Vlaanderen — sinds 1980</span>
      <h1 class="hero-title">NAT EN STRAF</h1>
      <p class="hero-sub" style="margin-left:0;">Ongefilterd, hoog gegist en zonder haast gebrouwen bij De Dolle Brouwers in Esen (Diksmuide). Acht bieren, één koppige overtuiging: goed bier heeft tijd nodig.</p>
      <div class="hero-actions" style="justify-content:flex-start; margin-top:30px;">
        <a class="hero-cta" href="/rondleiding-boeken" style="margin-top:0;">Boek een rondleiding op zondag</a>
        <a class="btn-ghost-dark" href="#bieren">Ontdek de bieren</a>
      </div>
    </div>
    <div class="hero-photo">
      <img src="/images/historische-toast.jpg" alt="Historische foto van De Dolle Brouwers, met de originele Oerbier 'Nat en Straf'-pet">
      <span class="hero-photo-badge">Nat &amp; Straf, al sinds 1980</span>
    </div>
  </div>
</header>


<section id="bieren">
  <div class="wrap">
    <div class="section-head">
      <span class="tag">Het assortiment</span>
      <h2>Een assortiment met karakter.</h2>
      <p class="lead" style="margin:14px auto 0;">Van jaarrond klassiekers tot beperkte brouwsels die je grijpt wanneer het kan.</p>
    </div>
    <div class="beer-grid">
      <a class="beer-card" href="/bieren/oerbier">
        <div class="bottle-wrap">
          <img src="/images/oerbier.png" alt="Oerbier personage">
        </div>
        <h3>Oerbier</h3>
        <span class="abv">9% — donker hoog gegist</span>
        <span class="keywords">Poperinge Goldinghop · gerijpt op 8°C · Altamira-etiket</span>
        <span class="arrow">→</span>
      </a>
      <a class="beer-card" href="/bieren/arabier">
        <div class="bottle-wrap">
          <img src="/images/arabier.png" alt="Arabier personage">
        </div>
        <h3>Arabier</h3>
        <span class="abv">8% — blond, sterk gehopt</span>
        <span class="keywords">Droog gehopt · Nugget uit Poperinge</span>
        <span class="arrow">→</span>
      </a>
      <a class="beer-card" href="/bieren/stille-nacht">
        <div class="bottle-wrap">
          <img src="/images/stille-nacht.png" alt="Stille Nacht personage">
        </div>
        <h3>Stille Nacht</h3>
        <span class="abv">12% — winterbier</span>
        <span class="keywords">Urenlang gekookt · ideaal om te bewaren</span>
        <span class="arrow">→</span>
      </a>
      <a class="beer-card" href="/bieren/boskeun">
        <div class="bottle-wrap">
          <img src="/images/boskeun.png" alt="Boskeun personage">
        </div>
        <h3>Boskeun</h3>
        <span class="abv">8% — lentebier, beperkt</span>
        <span class="keywords">Gebrouwen met honing</span>
        <span class="arrow">→</span>
      </a>
      <a class="beer-card" href="/bieren/dulle-teve">
        <div class="bottle-wrap">
          <img src="/images/dulle-teve.png" alt="Dulle Teve personage">
        </div>
        <h3>Dulle Teve</h3>
        <span class="abv">10% — sterk, hoog gegist</span>
        <span class="keywords">Witte kandijsuiker · een naam met een verhaal</span>
        <span class="arrow">→</span>
      </a>
      <a class="beer-card" href="/bieren/lichtervelds-blond">
        <div class="bottle-wrap">
          <img src="/images/dehoop-logo.png" alt="Logo van brouwerij De Hoop, Lichtervelde" style="max-height:100%; max-width:100%; object-fit:contain;">
        </div>
        <h3>Lichtervelds Blond</h3>
        <span class="abv">8% — sterk goudblond, tripel-stijl</span>
        <span class="keywords">1x per 2 jaar gebrouwen · eigen schwenkerglas</span>
        <span class="arrow">→</span>
      </a>
      <a class="beer-card" href="/bieren/export-stout">
        <div class="bottle-wrap">
          <img src="/images/stout-logo.png" alt="Etiketstempel van Export Stout" style="max-height:100%; max-width:100%; object-fit:contain;">
        </div>
        <h3>Export Stout</h3>
        <span class="abv">9% — donker, geroosterd</span>
        <span class="keywords">Voor de Amerikaanse markt · 200 jaar oude stijl</span>
        <span class="arrow">→</span>
      </a>
      <a class="beer-card" href="/bieren/oeral">
        <div class="bottle-wrap">
