---
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Polaroid from '../components/Polaroid.astro';

const examples = import.meta.glob<{ default: ImageMetadata }>('../assets/mannetjes/*.jpg', { eager: true });
const gallery = Object.entries(examples)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([file, mod], i) => ({
    src: mod.default,
    name: file.split('/').pop()!.replace('.jpg', ''),
    tilt: [-2.5, 2, -1, 3, -3, 1.5][i % 6],
  }));

const colors = [
  { id: 'geel', label: 'Oerbier-geel', hex: '#f6bf1c' },
  { id: 'wit', label: 'Wit', hex: '#f7f6f1' },
  { id: 'roze', label: 'Roze', hex: '#f3a7c3' },
  { id: 'rood', label: 'Rood', hex: '#d93a2b' },
  { id: 'oranje', label: 'Oranje', hex: '#f28c28' },
  { id: 'blauw', label: 'Blauw', hex: '#3d7bd4' },
  { id: 'groen', label: 'Groen', hex: '#2f7f45' },
  { id: 'paars', label: 'Paars', hex: '#8a6bc8' },
  { id: 'zwart', label: 'Zwart', hex: '#1f1b17' },
  { id: 'zilver', label: 'Zilver', hex: '#c4c8ce' },
  { id: 'brons', label: 'Brons', hex: '#a86a2c' },
];
const patterns = [
  { id: 'effen', label: 'Effen' },
  { id: 'strepen', label: 'Strepen' },
  { id: 'stippen', label: 'Stippen' },
  { id: 'hartjes', label: 'Hartjes' },
  { id: 'bloemen', label: 'Bloemetjes' },
  { id: 'camo', label: 'Camo' },
  { id: 'belgie', label: 'België' },
];
const extras = [
  { id: 'geen', label: 'Niets' },
  { id: 'pet', label: 'Petje' },
  { id: 'kroon', label: 'Kroontje' },
  { id: 'strik', label: 'Strikje' },
  { id: 'bril', label: 'Zonnebril' },
];
const sashes = [
  { id: 'wit', label: 'Wit', hex: '#fbfaf5', ink: '#21170c' },
  { id: 'zwart', label: 'Zwart', hex: '#1f1b17', ink: '#fbfaf5' },
  { id: 'geel', label: 'Geel', hex: '#f7b500', ink: '#21170c' },
  { id: 'rood', label: 'Rood', hex: '#d93a2b', ink: '#fbfaf5' },
];
---

<Base
  title="Jouw eigen Oerbier-mannetje | De Dolle Brouwers"
  description="Stel je eigen Oerbier-mannetje samen: kies een kleur, een patroon, een accessoire en wat er op de sjerp staat. Met de hand beschilderd, €90. Het gewone gele mannetje kost €60."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://www.oerbier.be/oerbier-mannetje" />
    <meta property="og:title" content="Jouw eigen Oerbier-mannetje" />
    <meta property="og:locale" content="nl_BE" />
  </Fragment>

  <section class="intro">
    <div class="wrap">
      <a class="back" href="/#shop">← Oershop</a>
      <h1>Jouw eigen<br /><em>Oerbier-mannetje.</em></h1>
      <p class="lead">
        Elk mannetje wordt met de hand beschilderd. Kies een kleur, een patroon, iets op zijn hoofd en wat er op de sjerp
        moet staan. Of verzin zelf iets: we hebben al vlaggen, voetbalshirts, namen, trouwdata en kroontjes gedaan.
      </p>
      <ul class="prices">
        <li><strong>€60</strong> het gewone gele</li>
        <li><strong>€90</strong> gepersonaliseerd</li>
      </ul>
    </div>
  </section>

  <section class="maker">
    <div class="wrap maker-grid">
      <div class="preview">
        <svg viewBox="0 0 320 340" role="img" aria-label="Voorbeeld van jouw Oerbier-mannetje" id="man">
          <defs>
            <clipPath id="body-clip">
              <ellipse cx="62" cy="192" rx="42" ry="24" transform="rotate(-25 62 192)"></ellipse>
              <ellipse cx="236" cy="142" rx="22" ry="44" transform="rotate(35 236 142)"></ellipse>
              <ellipse cx="160" cy="215" rx="92" ry="86"></ellipse>
              <circle cx="160" cy="110" r="58"></circle>
            </clipPath>
            <pattern id="p-strepen" width="24" height="24" patternUnits="userSpaceOnUse">
              <rect width="24" height="11" fill="#fbfaf5"></rect>
            </pattern>
            <pattern id="p-stippen" width="26" height="26" patternUnits="userSpaceOnUse">
              <circle cx="6" cy="6" r="4.5" fill="#fbfaf5"></circle>
              <circle cx="19" cy="19" r="4.5" fill="#fbfaf5"></circle>
            </pattern>
            <pattern id="p-hartjes" width="34" height="30" patternUnits="userSpaceOnUse">
              <path d="M9 10 c0-4 6-5 6 0 c0-5 6-4 6 0 c0 4-6 7-6 9 c0-2-6-5-6-9z" fill="#d93a2b"></path>
              <path d="M26 25 c0-3 5-4 5 0 c0-4 5-3 5 0 c0 3-5 6-5 7 c0-1-5-4-5-7z" fill="#fbfaf5"></path>
            </pattern>
            <pattern id="p-bloemen" width="40" height="40" patternUnits="userSpaceOnUse">
              <g fill="#fbfaf5">
                <circle cx="10" cy="6" r="4"></circle><circle cx="14" cy="10" r="4"></circle><circle cx="10" cy="14" r="4"></circle><circle
                  cx="6"
                  cy="10"
                  r="4"></circle>
              </g>
              <circle cx="10" cy="10" r="3" fill="#f7b500"></circle>
              <g fill="#f3a7c3">
                <circle cx="30" cy="26" r="3.5"></circle><circle cx="34" cy="30" r="3.5"></circle><circle cx="30" cy="34" r="3.5"></circle><circle
                  cx="26"
                  cy="30"
                  r="3.5"></circle>
              </g>
              <circle cx="30" cy="30" r="2.5" fill="#f7b500"></circle>
            </pattern>
            <pattern id="p-camo" width="90" height="90" patternUnits="userSpaceOnUse">
              <path d="M5 12 q12-14 26-2 t22 6 q4 14-14 12 t-22 4 q-16-6-12-20z" fill="rgba(0,0,0,.28)"></path>
              <path d="M52 50 q14-10 26 0 t6 18 q-12 10-24 2 t-8-20z" fill="rgba(255,255,255,.35)"></path>
              <path d="M8 62 q10-8 20 2 q6 12-8 14 q-16-2-12-16z" fill="rgba(0,0,0,.2)"></path>
              <path d="M60 4 q10 2 12 12 q-6 8-16 2z" fill="rgba(255,255,255,.3)"></path>
            </pattern>
            <linearGradient id="p-belgie" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" stop-color="#1f1b17"></stop><stop offset=".333" stop-color="#1f1b17"></stop>
              <stop offset=".333" stop-color="#f7cf1c"></stop><stop offset=".666" stop-color="#f7cf1c"></stop>
              <stop offset=".666" stop-color="#d93a2b"></stop><stop offset="1" stop-color="#d93a2b"></stop>
            </linearGradient>
            <path id="sash-line" d="M92 150 L244 274"></path>
          </defs>

          <ellipse cx="160" cy="322" rx="110" ry="12" fill="rgba(33,23,12,.12)"></ellipse>

          <!-- feet -->
          <g class="feet" stroke="#21170c" stroke-width="3">
            <ellipse cx="122" cy="296" rx="34" ry="27" class="foot"></ellipse>
            <ellipse cx="198" cy="296" rx="34" ry="27" class="foot"></ellipse>
          </g>

          <!-- body: base colour, then pattern on top, clipped to the body -->
          <g stroke="#21170c" stroke-width="3">
            <ellipse cx="62" cy="192" rx="42" ry="24" transform="rotate(-25 62 192)" class="skin"></ellipse>
            <ellipse cx="236" cy="142" rx="22" ry="44" transform="rotate(35 236 142)" class="skin"></ellipse>
            <ellipse cx="160" cy="215" rx="92" ry="86" class="skin"></ellipse>
            <circle cx="160" cy="110" r="58" class="skin"></circle>
          </g>
          <rect x="0" y="0" width="320" height="340" clip-path="url(#body-clip)" class="pattern" fill="none"></rect>
          <g fill="none" stroke="#21170c" stroke-width="3">
            <circle cx="160" cy="110" r="58"></circle>
          </g>
          <ellipse cx="138" cy="76" rx="18" ry="10" fill="rgba(255,255,255,.4)" transform="rotate(-30 138 76)"></ellipse>

          <!-- glass -->
          <g stroke="#21170c" stroke-width="3" stroke-linejoin="round">
            <path d="M226 36 H296 Q294 98 261 102 Q228 98 226 36 Z" fill="#c8241c"></path>
            <path d="M226 36 H296 L294 50 H228 Z" fill="#fbfaf5"></path>
          </g>

          <!-- face -->
          <g class="face">
            <ellipse cx="142" cy="100" rx="14" ry="16" fill="#fff" stroke="#21170c" stroke-width="3"></ellipse>
            <ellipse cx="178" cy="100" rx="14" ry="16" fill="#fff" stroke="#21170c" stroke-width="3"></ellipse>
            <circle cx="147" cy="104" r="7.5" fill="#21170c"></circle>
            <circle cx="183" cy="104" r="7.5" fill="#21170c"></circle>
            <path d="M138 128 Q160 150 182 128" fill="none" stroke="#21170c" stroke-width="3.5" stroke-linecap="round"></path>
          </g>

          <!-- sash -->
          <g clip-path="url(#body-clip)">
            <path d="M76 168 L104 136 L262 260 L234 292 Z" class="sash" stroke="#21170c" stroke-width="3"></path>
          </g>
          <text class="sash-text" font-size="24" dy="8">
            <textPath href="#sash-line" startOffset="50%" text-anchor="middle" id="sash-text">oerbier</textPath>
          </text>

          <!-- extras -->
          <g class="extra extra-pet" stroke="#21170c" stroke-width="3" stroke-linejoin="round">
            <path d="M104 92 Q106 44 160 42 Q214 44 216 92 Q160 76 104 92 Z" fill="#c8241c"></path>
            <path d="M206 86 L256 94 Q254 106 244 108 L204 100 Z" fill="#c8241c"></path>
            <circle cx="160" cy="44" r="5" fill="#c8241c"></circle>
          </g>
          <g class="extra extra-kroon" stroke="#21170c" stroke-width="3" stroke-linejoin="round">
            <path d="M126 64 L132 26 L148 48 L160 18 L172 48 L188 26 L194 64 Z" fill="#f28c28"></path>
            <circle cx="132" cy="24" r="5" fill="#f28c28"></circle><circle cx="160" cy="16" r="5" fill="#f28c28"></circle><circle
              cx="188"
              cy="24"
              r="5"
              fill="#f28c28"></circle>
          </g>
          <g class="extra extra-strik" stroke="#21170c" stroke-width="3" stroke-linejoin="round">
            <path d="M160 168 L128 152 L128 186 Z" fill="#c8241c"></path>
            <path d="M160 168 L192 152 L192 186 Z" fill="#c8241c"></path>
            <circle cx="160" cy="168" r="7" fill="#c8241c"></circle>
          </g>
          <g class="extra extra-bril" stroke="#21170c" stroke-width="3">
            <rect x="122" y="88" width="34" height="24" rx="9" fill="#21170c"></rect>
            <rect x="164" y="88" width="34" height="24" rx="9" fill="#21170c"></rect>
            <path d="M156 98 H164" fill="none"></path>
          </g>
        </svg>
        <p class="price-tag"><span id="price">€60</span> <small id="price-note">het gewone gele</small></p>
      </div>

      <form class="controls" id="maker">
        <fieldset>
          <legend>1. Kleur</legend>
          <div class="chips">
            {
              colors.map((c, i) => (
                <label class="swatch" title={c.label}>
                  <input type="radio" name="kleur" value={c.id} data-hex={c.hex} checked={i === 0} />
                  <span style={`--c:${c.hex}`} />
                  <em>{c.label}</em>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend>2. Patroon</legend>
          <div class="pills">
            {
              patterns.map((p, i) => (
                <label>
                  <input type="radio" name="patroon" value={p.id} checked={i === 0} />
                  <span>{p.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend>3. Iets extra</legend>
          <div class="pills">
            {
              extras.map((p, i) => (
                <label>
                  <input type="radio" name="extra" value={p.id} checked={i === 0} />
                  <span>{p.label}</span>
                </label>
              ))
            }
          </div>
          <label class="check"><input type="checkbox" name="goud" /> Gouden voetjes</label>
        </fieldset>

        <fieldset>
          <legend>4. De sjerp</legend>
          <label class="field">
            Wat staat erop?
            <input type="text" name="tekst" value="oerbier" maxlength="16" autocomplete="off" />
          </label>
          <div class="pills sash-colors">
            {
              sashes.map((s, i) => (
                <label>
                  <input type="radio" name="sjerp" value={s.id} data-hex={s.hex} data-ink={s.ink} checked={i === 0} />
                  <span>
                    <i style={`background:${s.hex}`} />
                    {s.label}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend>5. Nog een idee?</legend>
          <label class="field">
            Een vlag, een logo, een datum, een voetbalshirt… Beschrijf het hier.
            <textarea name="idee" rows="3" placeholder="Bv. in de kleuren van mijn voetbalclub, met 'Proficiat Jan' op de sjerp"></textarea>
          </label>
        </fieldset>

        <button class="btn dark" type="submit">Bestel dit mannetje →</button>
        <p class="note">Je bestelling komt binnen via mail. We laten je weten wanneer je mannetje klaar staat in de Oerbar.</p>
      </form>
    </div>
  </section>

  <section class="section inspo">
    <div class="wrap">
      <h2>Wat anderen al bedachten.</h2>
      <div class="inspo-grid">
        {
          gallery.map((g) => (
            <Polaroid src={g.src} alt={`Gepersonaliseerd Oerbier-mannetje: ${g.name.replace(/-/g, ' ')}`} tilt={g.tilt} ratio="1 / 1" width={420} />
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('maker') as HTMLFormElement;
  const svg = document.getElementById('man') as unknown as SVGSVGElement;
  const sashText = document.getElementById('sash-text')!;
  const price = document.getElementById('price')!;
  const priceNote = document.getElementById('price-note')!;
  const value = (name: string) => (form.elements.namedItem(name) as RadioNodeList).value;
  const checked = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)!;

  const render = () => {
    const kleur = checked('kleur').dataset.hex!;
    svg.querySelectorAll<SVGElement>('.skin').forEach((el) => el.setAttribute('fill', kleur));
    const gold = (form.elements.namedItem('goud') as HTMLInputElement).checked;
    svg.querySelectorAll<SVGElement>('.foot').forEach((el) => el.setAttribute('fill', gold ? '#c9a13b' : kleur));

    const patroon = value('patroon');
    const pat = svg.querySelector<SVGElement>('.pattern')!;
    pat.setAttribute('fill', patroon === 'effen' ? 'none' : `url(#p-${patroon})`);
    if (patroon === 'belgie') {
      pat.setAttribute('x', '60');
      pat.setAttribute('width', '200');
    } else {
      pat.setAttribute('x', '0');
      pat.setAttribute('width', '320');
    }

    const extra = value('extra');
    svg.querySelectorAll<SVGElement>('.extra').forEach((el) => el.classList.toggle('on', el.classList.contains(`extra-${extra}`)));

    const sjerp = checked('sjerp');
    svg.querySelector('.sash')!.setAttribute('fill', sjerp.dataset.hex!);
    svg.querySelector('.sash-text')!.setAttribute('fill', sjerp.dataset.ink!);
    const tekst = (form.elements.namedItem('tekst') as HTMLInputElement).value.trim() || ' ';
    sashText.textContent = tekst;

    const idee = (form.elements.namedItem('idee') as HTMLTextAreaElement).value.trim();
    const plain =
      value('kleur') === 'geel' && patroon === 'effen' && extra === 'geen' && !gold && value('sjerp') === 'wit' && tekst.toLowerCase() === 'oerbier' && !idee;
    price.textContent = plain ? '€60' : '€90';
    priceNote.textContent = plain ? 'het gewone gele' : 'gepersonaliseerd';
  };

  form.addEventListener('input', render);
  form.addEventListener('change', render);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const label = (name: string) => checked(name).closest('label')!.textContent!.trim();
    const lines = [
      'Hallo,',
      '',
      'Ik wil graag dit Oerbier-mannetje bestellen:',
      '',
      `Kleur: ${label('kleur')}`,
      `Patroon: ${label('patroon')}`,
      `Extra: ${label('extra')}`,
      `Gouden voetjes: ${(form.elements.namedItem('goud') as HTMLInputElement).checked ? 'ja' : 'nee'}`,
      `Sjerp: ${label('sjerp')}, met de tekst "${(form.elements.namedItem('tekst') as HTMLInputElement).value}"`,
      `Idee: ${(form.elements.namedItem('idee') as HTMLTextAreaElement).value || '-'}`,
      '',
      `Prijs: ${price.textContent}`,
      '',
      'Groeten,',
    ];
    location.href = `mailto:boniface@dedollebrouwers.be?subject=${encodeURIComponent('Oerbier-mannetje bestellen')}&body=${encodeURIComponent(lines.join('\n'))}`;
  });
  render();
</script>

<style>
  .intro {
    padding: clamp(36px, 5vw, 70px) 0 30px;
  }
  .back {
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 20px;
  }
  .intro h1 {
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    margin-bottom: 20px;
  }
  .intro h1 em {
    font-weight: 400;
  }
  .prices {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: flex;
    gap: 34px;
    flex-wrap: wrap;
  }
  .prices li {
    display: grid;
    color: var(--ink-soft);
  }
  .prices strong {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--ink);
  }

  .maker {
    padding: 20px 0 clamp(60px, 8vw, 100px);
  }
  .maker-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(30px, 5vw, 70px);
    align-items: start;
  }
  .preview {
    position: sticky;
    top: 100px;
    background: var(--yellow-soft) var(--grain);
    border: var(--line);
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
    padding: 30px 30px 20px;
  }
  .preview svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .sash-text {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .extra {
    display: none;
  }
  .extra.on {
    display: inline;
  }
  .price-tag {
    text-align: center;
    margin: 6px 0 0;
    font-family: var(--font-display);
  }
  .price-tag span {
    font-size: 2rem;
    font-weight: 650;
  }
  .price-tag small {
    font-style: italic;
    font-size: 1rem;
    color: var(--ink-soft);
    margin-left: 6px;
  }

  .controls {
    display: grid;
    gap: 22px;
  }
  fieldset {
    border: var(--line);
    border-radius: 16px;
    background: var(--paper-light);
    padding: 16px 20px 18px;
    margin: 0;
  }
  legend {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.15rem;
    padding: 0 8px;
  }
  input[type='radio'] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .swatch {
    position: relative;
    cursor: pointer;
  }
  .swatch span {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--c);
    border: 2.5px solid var(--ink);
    transition: transform 0.15s;
  }
  .swatch em {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .swatch input:checked + span {
    box-shadow:
      0 0 0 3px var(--paper-light),
      0 0 0 6px var(--ink);
    transform: scale(1.05);
  }
  .swatch input:focus-visible + span {
    outline: 3px solid var(--yellow);
    outline-offset: 6px;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pills label {
    position: relative;
    cursor: pointer;
  }
  .pills span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
    background: var(--paper);
    transition: background 0.15s;
  }
  .pills span i {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
  }
  .pills input:checked + span {
    background: var(--yellow);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .pills input:focus-visible + span {
    outline: 3px solid var(--yellow);
    outline-offset: 2px;
  }
  .check {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin-top: 12px;
    font-weight: 600;
    cursor: pointer;
  }
  .check input {
    width: 18px;
    height: 18px;
    accent-color: var(--ink);
  }
  .field {
    display: grid;
    gap: 6px;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .field input,
  .field textarea {
    font: inherit;
    color: var(--ink);
    padding: 0.6em 0.8em;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--paper);
  }
  .field input:focus,
  .field textarea:focus {
    outline: 3px solid var(--yellow);
    outline-offset: 1px;
  }
  .sash-colors {
    margin-top: 12px;
  }
  .controls .btn {
    justify-self: start;
    font-size: 1.1rem;
  }
  .note {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: -8px 0 0;
  }

  .inspo h2 {
    margin-bottom: 40px;
  }
  .inspo-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .maker-grid {
