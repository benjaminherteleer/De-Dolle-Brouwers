---
import Base from '../layouts/Base.astro';
---

<Base title={'Verkooppunten wereldwijd — De Dolle Brouwers'} description={'Vind De Dolle Brouwers en Oerbier bij cafés, bierwinkels en verdelers over de hele wereld — van West-Vlaanderen tot Kaunas, Rome en Portland.'} back={{ href: '/#verkooppunten', label: '&larr; Terug naar de homepage' }}>
<Fragment slot="head">

</Fragment>

<header>
  <div class="wrap">
    <span class="tag">Verkrijgbaar bij</span>
    <h1>Onze bieren, over de hele wereld.</h1>
    <p>Van cafés in West-Vlaanderen tot bierwinkels in Kaunas, Rome en Portland — sleep om te draaien, scroll om te zoomen, en klik op een gele stip voor de naam.</p>
    <div class="stats">
      <div>40+<span>verkooppunten</span></div>
      <div>10+<span>landen</span></div>
      <div>1980<span>sinds</span></div>
    </div>
  </div>
</header>

<div class="wrap">
  <div id="globeWrap">
    <canvas id="globeCanvas"></canvas>
    <div class="globe-loading" id="globeLoading">De wereldbol wordt geladen …</div>
    <span class="globe-hint">🖱️ Sleep om te draaien · scroll om te zoomen</span>
    <div class="globe-label" id="globeLabel"></div>
  </div>
  <p class="map-note">Locaties bij benadering — check openingsuren en assortiment vooraf bij de zaak zelf. Volledige lijst hieronder.</p>

  <div class="venue-list" id="venueList"></div>

  <div class="suggest-box">
    <span class="tag" style="font-size:13px; font-weight:700; color:var(--rust); display:block; margin-bottom:10px;">Ontbreekt er een café?</span>
    <h2>Ken je een plek waar ons bier te vinden is?</h2>
    <p>Deze lijst is verre van compleet — we weten zelf niet overal waar onze bieren getapt of verkocht worden. Ken je een café, winkel of bar die er niet bij staat? Laat het ons weten, dan zetten we 'm erbij.</p>
    <div class="suggest-grid">
      <div class="suggest-field">
        <label for="sugNaam">Naam van het café / de winkel</label>
        <input type="text" id="sugNaam" placeholder="Bv. Café De Gouden Leeuw">
      </div>
      <div class="suggest-field">
        <label for="sugPlaats">Stad &amp; land</label>
        <input type="text" id="sugPlaats" placeholder="Bv. Gent, België">
      </div>
      <div class="suggest-field">
        <label for="sugJouwNaam">Jouw naam (optioneel)</label>
        <input type="text" id="sugJouwNaam" placeholder="Voor- en achternaam">
      </div>
      <div class="suggest-field">
        <label for="sugEmail">Je e-mailadres (optioneel)</label>
        <input type="email" id="sugEmail" placeholder="jij@email.be">
      </div>
    </div>
    <button class="suggest-btn" onclick="suggestVenue()">Stel dit café voor</button>
  </div>

  <script is:inline>
    function suggestVenue(){
      var naam = document.getElementById('sugNaam').value || '(niet ingevuld)';
      var plaats = document.getElementById('sugPlaats').value || '(niet ingevuld)';
      var jouwNaam = document.getElementById('sugJouwNaam').value || '-';
      var email = document.getElementById('sugEmail').value || '-';
      var subject = 'Verkooppunt-tip: ' + naam;
      var body = 'Hallo,%0D%0A%0D%0AIk wil een café/winkel voorstellen voor de verkooppuntenkaart:%0D%0A%0D%0ANaam: ' + naam + '%0D%0AStad %26 land: ' + plaats + '%0D%0A%0D%0AMijn naam: ' + jouwNaam + '%0D%0AMijn e-mail: ' + email + '%0D%0A%0D%0AGroeten!';
      window.location.href = 'mailto:info@dedollebrouwers.be?subject=' + encodeURIComponent(subject) + '&body=' + body;
    }
  </script>
</div>



<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script is:inline>
  var places = [
    {name:"OAK Napoli - Wine And Craft Beer", city:"Napels, Italië", lat:40.8471822, lng:14.2503033},
    {name:"Station 1280", city:"Antwerpen, België", lat:51.2163096, lng:4.403731},
    {name:"Café Pardaf - Craft Beer Heaven", city:"Antwerpen, België", lat:51.2210924, lng:4.397253},
    {name:"Nüetnigenough", city:"Brussel, België", lat:50.8458556, lng:4.3498444},
    {name:"The Glengarry", city:"Gent, België", lat:51.0531387, lng:3.7254729},
    {name:"Brasserie De Pikardijn", city:"Sint-Lievens-Houtem, België", lat:50.9080682, lng:3.853362},
    {name:"HERMAN Belgian Bar", city:"Berlijn, Duitsland", lat:52.5324042, lng:13.4121625},
    {name:"Dekkera", city:"Brussel (Vorst), België", lat:50.8225667, lng:4.3292506},
    {name:"Moeder Lambic Fontainas", city:"Brussel, België", lat:50.8451368, lng:4.3469668},
    {name:"Alsem 1900 J.P. (Houtwijk)", city:"Den Haag, Nederland", lat:52.0545992, lng:4.2498911},
    {name:"Alsem 1900 J.P.", city:"Den Haag, Nederland", lat:52.070708, lng:4.283149},
    {name:"Apollon Platebar", city:"Bergen, Noorwegen", lat:60.3895874, lng:5.3232465},
    {name:"Internationella Pressklubben", city:"Stockholm, Zweden", lat:59.3344386, lng:18.0562107},
    {name:"Nisha craft beer bar", city:"Kaunas, Litouwen", lat:54.8978366, lng:23.8913426},
    {name:"The Sickle", city:"Bath, Verenigd Koninkrijk", lat:51.3891526, lng:-2.3587346},
    {name:"The Lucky Anchor", city:"Londen, Verenigd Koninkrijk", lat:51.4755203, lng:-0.0257555},
    {name:"waterintobeer", city:"Ramsgate, Verenigd Koninkrijk", lat:51.3346848, lng:1.4207374},
    {name:"Karreman Biermeesters", city:"Rotterdam, Nederland", lat:51.9225788, lng:4.4931184},
    {name:"Café de Koppelpaarden", city:"Assen, Nederland", lat:52.9937487, lng:6.5606692},
    {name:"Beerlovers Bar", city:"Antwerpen, België", lat:51.222062, lng:4.4207667},
    {name:"Dranken Geers NV (Prik & Tik)", city:"Oostakker (Gent), België", lat:51.1003608, lng:3.7611593},
    {name:"De Hopduvel", city:"Gent, België", lat:51.0664222, lng:3.7329654},
    {name:"Trappistenhuis", city:"Achel (Hamont-Achel), België", lat:51.2984254, lng:5.4884006},
    {name:"Café Beermoth · Craft Beer Bar", city:"Manchester, Verenigd Koninkrijk", lat:53.4813121, lng:-2.2418715},
    {name:"Gainsbar", city:"Kortrijk, België", lat:50.8257161, lng:3.267813},
    {name:"De Ware Jacob", city:"Gent, België", lat:51.057458, lng:3.7257211},
    {name:"Billie's Bier Kafétaria", city:"Antwerpen, België", lat:51.2183896, lng:4.400223},
    {name:"Dr. Beer", city:"Antwerpen, België", lat:51.2276794, lng:4.4043895},
    {name:"Bier Central Antwerpen", city:"Antwerpen, België", lat:51.2177747, lng:4.4183896},
    {name:"Bier Central Gent", city:"Gent, België", lat:51.0539228, lng:3.7255628},
    {name:"Defoo", city:"Gent, België", lat:51.0432962, lng:3.724612},
    {name:"Dulle Griet", city:"Gent, België", lat:51.0565719, lng:3.7252779},
    {name:"Café Botteltje", city:"Oostende, België", lat:51.2334787, lng:2.9170765},
    {name:"'t Brugs Beertje", city:"Brugge, België", lat:51.2068237, lng:3.2217179},
    {name:"Verkooppunt Portland", city:"Portland, ME, VS", lat:43.6567355, lng:-70.2556862},
    {name:"Verkooppunt Rome", city:"Rome, Italië", lat:41.8936532, lng:12.5566602},
    {name:"Verkooppunt Utrecht", city:"Utrecht, Nederland", lat:52.0948542, lng:5.1195872},
    {name:"Ma Che Siete Venuti A Fà", city:"Rome, Italië", lat:41.8917811, lng:12.4692175},
    {name:"The Drunken Duck - Spaccisti Birrai", city:"Bolzano Vicentino, Italië", lat:45.5877456, lng:11.6276741},
    {name:"Streekbierencafé", city:"Grimbergen, België", lat:50.9344654, lng:4.3692829},
    {name:"Threefold Beer & Pizza", city:"Vancouver, Canada", lat:49.2834076, lng:-123.073608},
    {name:"Blind Lady Ale House", city:"San Diego, VS", lat:32.7634973, lng:-117.1202861},
    {name:"Nisha Craft Capital", city:"Vilnius, Litouwen", lat:54.6840878, lng:25.2840588},
    {name:"Le Trappiste", city:"Brugge, België", lat:51.210838, lng:3.222809}
  ];

  // ---- Venue list (text fallback + SEO-friendly content) ----
  var listEl = document.getElementById('venueList');
  places.forEach(function(p){
    var row = document.createElement('div');
    row.innerHTML = '<strong>' + p.name + '</strong><span>' + p.city + '</span>';
    listEl.appendChild(row);
  });

  // ---- 3D globe ----
  var wrap = document.getElementById('globeWrap');
  var canvas = document.getElementById('globeCanvas');
  var label = document.getElementById('globeLabel');
  var loading = document.getElementById('globeLoading');

  var W = wrap.clientWidth, H = wrap.clientHeight;
  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(45, W / H, 0.1, 100);
  camera.position.set(0, 0, 6.2);

  var renderer = new THREE.WebGLRenderer({canvas: canvas, antialias: true, alpha: true});
  renderer.setSize(W, H);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  // Lighting
  scene.add(new THREE.AmbientLight(0xfff3d6, 0.85));
  var sun = new THREE.DirectionalLight(0xffffff, 0.65);
  sun.position.set(4, 3, 5);
  scene.add(sun);

  // Globe sphere — real world map texture (land/water), in brand colors
  var globeGeo = new THREE.SphereGeometry(2, 64, 48);
  var textureLoader = new THREE.TextureLoader();
  var worldTexture = textureLoader.load('data:image/jpeg;base64,');
  worldTexture.anisotropy = 4;
  var globeMat = new THREE.MeshPhongMaterial({map: worldTexture, shininess: 6, specular: 0x2a2118});
  var globe = new THREE.Mesh(globeGeo, globeMat);
  scene.add(globe);

  // Subtle graticule (lat/long grid) overlay, brand ink color
  var gridGeo = new THREE.SphereGeometry(2.006, 24, 16);
  var gridMat = new THREE.MeshBasicMaterial({color: 0x201607, wireframe: true, transparent: true, opacity: 0.07});
  var grid = new THREE.Mesh(gridGeo, gridMat);
  scene.add(grid);

  // Faint outer glow rim
  var rimGeo = new THREE.SphereGeometry(2.05, 48, 36);
  var rimMat = new THREE.MeshBasicMaterial({color: 0xF7B500, transparent: true, opacity: 0.06, side: THREE.BackSide});
  scene.add(new THREE.Mesh(rimGeo, rimMat));

  function latLngToVector3(lat, lng, radius){
    var phi = (90 - lat) * (Math.PI / 180);
    var theta = (lng + 180) * (Math.PI / 180);
    return new THREE.Vector3(
      -radius * Math.sin(phi) * Math.cos(theta),
      radius * Math.cos(phi),
      radius * Math.sin(phi) * Math.sin(theta)
    );
  }

  // Markers: rust dot with a cream halo ring for contrast against both land and water,
  // plus an invisible larger hit-sphere for easy tapping
  var markerGroup = new THREE.Group();
  scene.add(markerGroup);
  var markerMeshes = [];

  var haloGeo = new THREE.SphereGeometry(0.05, 10, 8);
  var haloMat = new THREE.MeshBasicMaterial({color: 0xFFFDF7});
  var pinGeo = new THREE.SphereGeometry(0.03, 10, 8);
  var pinMat = new THREE.MeshPhongMaterial({color: 0xB5451B, emissive: 0x5a1d0a, emissiveIntensity: 0.4});
  var hitGeo = new THREE.SphereGeometry(0.11, 8, 8);
  var hitMat = new THREE.MeshBasicMaterial({visible: false});

  places.forEach(function(p){
    var pos = latLngToVector3(p.lat, p.lng, 2.03);
    var posOuter = latLngToVector3(p.lat, p.lng, 2.035);

    var halo = new THREE.Mesh(haloGeo, haloMat);
    halo.position.copy(pos);
    markerGroup.add(halo);

    var pin = new THREE.Mesh(pinGeo, pinMat);
    pin.position.copy(posOuter);
    markerGroup.add(pin);

    var hit = new THREE.Mesh(hitGeo, hitMat);
    hit.position.copy(posOuter);
    hit.userData = p;
    markerGroup.add(hit);
    markerMeshes.push(hit);
  });

  // Controls
  var controls = new THREE.OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.dampingFactor = 0.08;
  controls.rotateSpeed = 0.45;
  controls.minDistance = 3.2;
  controls.maxDistance = 10;
  controls.autoRotate = true;
  controls.autoRotateSpeed = 0.6;
  controls.enablePan = false;

  // Start facing Europe
  globe.rotation.y = -1.4;
  grid.rotation.y = -1.4;
  markerGroup.rotation.y = -1.4;

  // Raycasting for clicks/taps
  var raycaster = new THREE.Raycaster();
  var pointer = new THREE.Vector2();
  var labelTimeout;

  function onPointerDown(clientX, clientY){
    var rect = wrap.getBoundingClientRect();
    pointer.x = ((clientX - rect.left) / rect.width) * 2 - 1;
    pointer.y = -((clientY - rect.top) / rect.height) * 2 + 1;
    raycaster.setFromCamera(pointer, camera);
    var hits = raycaster.intersectObjects(markerMeshes);
    if(hits.length > 0){
      var p = hits[0].object.userData;
      label.innerHTML = p.name + '<span>' + p.city + '</span>';
      label.style.display = 'block';
      controls.autoRotate = false;
      clearTimeout(labelTimeout);
      labelTimeout = setTimeout(function(){ controls.autoRotate = true; }, 6000);
    }
  }
  renderer.domElement.addEventListener('click', function(e){ onPointerDown(e.clientX, e.clientY); });

  function onResize(){
    W = wrap.clientWidth; H = wrap.clientHeight;
    camera.aspect = W / H;
    camera.updateProjectionMatrix();
    renderer.setSize(W, H);
  }
  window.addEventListener('resize', onResize);

  loading.style.display = 'none';

  function animate(){
    requestAnimationFrame(animate);
    controls.update();
    renderer.render(scene, camera);
  }
  animate();
</script>
</Base>

<style is:global>
  :root{
    --yellow:#F7B500; --yellow-deep:#E0A200; --yellow-pale:#FDE9AE;
    --ink:#201607; --rust:#B5451B; --cream:#FBF6E9; --white:#FFFDF7;
  }
  *{box-sizing:border-box;}
  body{margin:0; background:var(--cream); color:var(--ink); font-family:'Public Sans', sans-serif; font-size:16px; line-height:1.6;}
  h1,h2,h3{font-family:'Fraunces', serif; font-weight:700; margin:0; color:var(--ink);}
  a{color:inherit;}
  .wrap{max-width:1180px; margin:0 auto; padding:0 32px;}

  nav{position:sticky; top:0; z-index:999; background:var(--cream); border-bottom:2px solid var(--ink);}
  nav .wrap{display:flex; align-items:center; justify-content:space-between; padding:16px 32px;}
  .brandmark{display:flex; align-items:center; gap:10px; font-family:'Fraunces', serif; font-weight:700; font-size:19px; text-decoration:none; color:var(--ink);}
  .brandmark .glyph{width:40px; height:40px; display:flex; align-items:center; justify-content:center;}
  .brandmark .glyph img{width:100%; height:100%; object-fit:contain;}
  .brandmark .wordmark{height:36px; width:auto; display:block;}
  nav a.nav-link{text-decoration:none; color:var(--ink); font-size:14.5px; font-weight:600;}
  nav a.nav-link:hover{color:var(--rust);}

  header{padding:56px 0 36px;}
  header .tag{font-size:13.5px; font-weight:700; color:var(--rust); display:block; margin-bottom:10px;}
  header h1{font-size:clamp(32px,4.5vw,52px); max-width:640px;}
  header p{font-size:16px; color:#413623; max-width:560px; margin-top:16px;}
  .stats{display:flex; gap:36px; margin-top:26px; flex-wrap:wrap;}
  .stats div{font-family:'Fraunces',serif; font-size:26px; font-weight:700;}
  .stats span{display:block; font-family:'Public Sans',sans-serif; font-size:12.5px; font-weight:600; color:#6b5a3a; margin-top:2px;}

  #globeWrap{
    position:relative; width:100%; height:620px; border-radius:20px; border:2px solid var(--ink);
    margin-bottom:16px; overflow:hidden; background:radial-gradient(circle at 50% 40%, #FDF6E3 0%, #F2E6C8 60%, #E9DBB4 100%);
    cursor:grab;
  }
  #globeWrap:active{cursor:grabbing;}
  #globeCanvas{display:block; width:100%; height:100%;}
  .globe-hint{
    position:absolute; top:16px; left:16px; background:rgba(32,22,7,0.85); color:var(--yellow-pale);
    font-size:12.5px; padding:8px 14px; border-radius:20px; pointer-events:none;
  }
  .globe-label{
    position:absolute; bottom:20px; left:20px; right:20px; background:var(--ink); color:var(--yellow);
    padding:14px 20px; border-radius:14px; font-family:'Fraunces',serif; font-size:16px; font-weight:700;
    display:none; box-shadow:0 6px 18px rgba(0,0,0,0.3);
  }
  .globe-label span{display:block; font-family:'Public Sans',sans-serif; font-weight:600; font-size:12.5px; color:#cbbe97; margin-top:3px;}
  .globe-loading{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    font-family:'Fraunces',serif; font-style:italic; color:#6b5a3a; font-size:14px;
  }
  .map-note{font-size:13px; color:#6b5a3a; margin-bottom:50px;}

  .venue-list{
    columns:3; column-gap:32px; margin-bottom:70px; font-size:13.5px;
  }
  .venue-list div{break-inside:avoid; padding:6px 0; border-bottom:1px solid rgba(32,22,7,0.08);}
  .venue-list strong{font-weight:700;}
  .venue-list span{display:block; color:#6b5a3a; font-size:12px;}
  @media(max-width:760px){.venue-list{columns:1;} #globeWrap{height:440px;}}

  .suggest-box{background:var(--white); border-radius:20px; padding:44px; margin-bottom:60px;}
  .suggest-box h2{font-size:clamp(24px,3vw,32px); margin-bottom:10px;}
  .suggest-box p{font-size:14.5px; color:#413623; max-width:520px; margin-bottom:24px;}
  .suggest-grid{display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-bottom:20px;}
  .suggest-field{display:flex; flex-direction:column; gap:6px;}
  .suggest-field.full{grid-column:1/-1;}
  .suggest-field label{font-size:13px; font-weight:600; color:#6b5a3a;}
  .suggest-field input{
    border:2px solid #e4d9bd; border-radius:10px; padding:11px 14px; font-size:15px;
    font-family:'Public Sans',sans-serif; background:var(--cream); color:var(--ink);
  }
  .suggest-field input:focus{outline:none; border-color:var(--yellow-deep);}
  .suggest-btn{
    background:var(--rust); color:var(--white); border:none; text-decoration:none;
    padding:14px 26px; border-radius:30px; font-weight:700; font-size:14.5px; cursor:pointer;
    font-family:'Public Sans',sans-serif;
  }
  @media(max-width:600px){.suggest-grid{grid-template-columns:1fr;} .suggest-box{padding:28px;}}

  footer{background:var(--ink); color:#cbbe97; padding:40px 0;}
  footer .wrap{display:flex; justify-content:space-between; font-size:12.5px; flex-wrap:wrap; gap:12px;}
</style>
