---
import Base from '../layouts/Base.astro';
import VerkoopKaart from '../components/VerkoopKaart.astro';
import Polaroid from '../components/Polaroid.astro';
import places from '../data/verkooppunten.json';
import flesHop from '../assets/foto/fles-hop.jpg';

const countries = new Set(places.map((p) => p.country)).size;
---

<Base
  title="Verkooppunten | Waar drink je een De Dolle Brouwers-biertje?"
  description="Vind De Dolle Brouwers en Oerbier bij cafés en bierwinkels: van Antwerpen en Brussel tot Rome, Stockholm, Kaunas, Vancouver en San Diego."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://www.oerbier.be/verkooppunten-kaart" />
    <meta property="og:title" content="Waar drink je een De Dolle Brouwers-biertje?" />
    <meta property="og:description" content="Cafés en bierwinkels met onze bieren, van Esen tot ver over de oceaan." />
    <meta property="og:locale" content="nl_BE" />
  </Fragment>

  <section class="intro">
    <div class="wrap intro-grid">
      <div>
        <p class="hand">Van Esen tot ver over de oceaan</p>
        <h1>Waar drink je een<br /><em>De Dolle Brouwers-biertje?</em></h1>
        <p class="lead">
          Onze bieren reizen verder dan wijzelf. Hieronder de cafés en bierwinkels die we kennen. Klik op een adres of een gele
          stip om in te zoomen.
        </p>
        <ul class="stats">
          <li><strong>{places.length}</strong> adressen</li>
          <li><strong>{countries}</strong> landen</li>
          <li><strong>1</strong> brouwerij, in Esen</li>
        </ul>
      </div>
      <Polaroid src={flesHop} alt="Een fles Oerbier tussen verse hop" caption="Overal even nat en straf" tilt={3} ratio="4 / 5" width={520} taped />
    </div>
  </section>

  <section class="map-section">
    <div class="wrap">
      <VerkoopKaart />
      <p class="note">Locaties bij benadering. Check openingsuren en assortiment vooraf bij de zaak zelf.</p>
    </div>
  </section>

  <section class="section suggest">
    <div class="wrap">
      <div class="card suggest-card">
        <div>
          <h2>Ontbreekt er een café?</h2>
          <p>
            Deze lijst is verre van compleet. We weten zelf niet overal waar onze bieren getapt of verkocht worden. Ken je een
            plek die er niet bij staat? Laat het ons weten, dan zetten we ze erbij.
          </p>
        </div>
        <form class="suggest-form" id="suggest">
          <label>Naam van het café of de winkel<input name="naam" placeholder="Bv. Café De Gouden Leeuw" required /></label>
          <label>Stad &amp; land<input name="plaats" placeholder="Bv. Gent, België" required /></label>
          <label>Jouw naam <span>(optioneel)</span><input name="jij" /></label>
          <label>Je e-mailadres <span>(optioneel)</span><input name="email" type="email" /></label>
          <button class="btn" type="submit">Stel dit adres voor</button>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  document.getElementById('suggest')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement);
    const v = (k: string) => String(f.get(k) || '-');
    const body = [
      'Hallo,',
      '',
      'Ik wil een café of winkel voorstellen voor de verkooppuntenkaart:',
      '',
      `Naam: ${v('naam')}`,
      `Stad & land: ${v('plaats')}`,
      '',
      `Mijn naam: ${v('jij')}`,
      `Mijn e-mail: ${v('email')}`,
    ].join('\n');
    location.href = `mailto:info@dedollebrouwers.be?subject=${encodeURIComponent('Verkooppunt-tip: ' + v('naam'))}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .intro {
    padding: clamp(40px, 6vw, 80px) 0 50px;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1.5fr 0.6fr;
    gap: clamp(30px, 6vw, 80px);
    align-items: center;
  }
  .intro .hand {
    margin-bottom: 14px;
  }
  h1 {
    font-size: clamp(2.5rem, 5.5vw, 4.6rem);
    margin-bottom: 22px;
  }
  h1 em {
    font-weight: 400;
  }
  .stats {
    list-style: none;
    padding: 0;
    margin: 30px 0 0;
    display: flex;
    gap: 34px;
    flex-wrap: wrap;
  }
  .stats li {
    display: grid;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .stats strong {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--ink);
  }
  .map-section {
    padding-bottom: 20px;
  }
  .note {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-top: 18px;
  }
  .suggest-card {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 40px;
    align-items: start;
  }
  .suggest-card h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 14px;
  }
  .suggest-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .suggest-form label {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .suggest-form label span {
    font-weight: 400;
    color: var(--ink-soft);
  }
  .suggest-form input {
    font: inherit;
    font-weight: 400;
    padding: 0.65em 0.9em;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--paper);
  }
  .suggest-form input:focus {
    outline: 3px solid var(--yellow);
    outline-offset: 1px;
  }
  .suggest-form .btn {
    grid-column: 1 / -1;
    justify-self: start;
  }
  @media (max-width: 900px) {
    .intro-grid,
    .suggest-card {
      grid-template-columns: 1fr;
    }
    .intro :global(.polaroid) {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .suggest-form {
      grid-template-columns: 1fr;
    }
  }
</style>
