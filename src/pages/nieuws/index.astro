---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Krantkop from '../../components/nieuws/Krantkop.astro';
import Polaroid from '../../components/Polaroid.astro';
import { edities, maand, kleuren } from '../../lib/nieuws';
import krant1990 from '../../assets/archief/krant-1990.jpg';

const lijst = (await edities()).reverse();
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Oerbier Fake Nieuws',
  url: 'https://www.oerbier.be/nieuws',
  inLanguage: 'nl-BE',
  publisher: { '@type': 'Organization', name: 'De Dolle Brouwers' },
  blogPost: lijst.map((e) => ({
    '@type': 'BlogPosting',
    headline: e.data.titel,
    datePublished: e.data.datum.toISOString(),
    url: `https://www.oerbier.be/nieuws/${e.id}`,
  })),
};
---

<Base
  title="Oerbier Fake Nieuws | Nieuws uit de brouwerij van De Dolle Brouwers"
  description="Het Oerbier Fake Nieuws: elke maand nieuws uit de brouwerij van De Dolle Brouwers in Esen. Nieuwe Reserva's, nieuwe brouwsels en wat er gebeurt in de brouwerij."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://www.oerbier.be/nieuws" />
    <meta property="og:title" content="Oerbier Fake Nieuws | De Dolle Brouwers" />
    <meta property="og:locale" content="nl_BE" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
  </Fragment>

  <section class="section">
    <div class="wrap">
      <div class="krant kop">
        <Krantkop hoofd regel="Nieuws uit de brouwerij, elke maand" />
      </div>

      <div class="intro">
        <div>
          <p class="lead">
            Nieuwe Reserva's, nieuwe brouwsels en wat er gebeurt in de brouwerij in Esen. Elke maand een nieuwe editie.
          </p>
          <p>
            Het Oerbier Nieuws is niet nieuw. Op deze krantenfoto van vrijdag 20 april 1990 hangt het al aan de muur, tussen de flessen
            Arabier.
          </p>
        </div>
        <Polaroid src={krant1990} alt="Krantenknipsel van 20 april 1990 met het Oerbier Nieuws aan de muur" caption="20 april 1990" tilt={3} ratio="4 / 5" width={420} taped />
      </div>

      <div class="edities">
        {
          lijst.map((e, i) => (
            <a class:list={['editie', { eerste: i === 0 }]} href={`/nieuws/${e.id}`} style={`--kleur:${kleuren[e.data.kleur].bg}; --op:${kleuren[e.data.kleur].on}`}>
              <Image src={e.data.foto} alt={e.data.fotoAlt} width={i === 0 ? 900 : 600} />
              <span class="tekst">
                <span class="meta">
                  Editie {e.nummer} · {maand(e.data.datum)}
                </span>
                <span class="titel">{e.data.titel}</span>
                <span class="lead-kort">{e.data.lead}</span>
                <span class="lees">Lees de editie →</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .krant.kop {
    max-width: 920px;
    margin: 0 auto;
    border: var(--line);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .intro {
    max-width: 920px;
    margin: clamp(30px, 5vw, 56px) auto;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(24px, 5vw, 56px);
    align-items: center;
  }
  .edities {
    max-width: 920px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .editie {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--paper-light);
    border: var(--line);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--shadow);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .editie:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
  }
  .editie.eerste {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
  }
  .editie :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .tekst {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 22px 24px 24px;
    background: var(--kleur) var(--grain);
    color: var(--op);
    border-top: var(--line);
  }
  .eerste .tekst {
    border-top: 0;
    border-left: var(--line);
    align-content: center;
  }
  .meta {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .titel {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
  }
  .lead-kort {
    font-size: 0.98rem;
  }
  .lees {
    font-weight: 700;
    margin-top: 6px;
  }
  @media (max-width: 760px) {
    .intro,
    .edities,
    .editie.eerste {
      grid-template-columns: 1fr;
    }
    .eerste .tekst {
      border-left: 0;
      border-top: var(--line);
    }
  }
</style>
