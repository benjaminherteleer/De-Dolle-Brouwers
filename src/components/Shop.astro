---
import { Image } from 'astro:assets';
import MannetjeSvg from './MannetjeSvg.astro';
import { getProducts, type Product } from '../lib/shopify';
import { CUSTOM, sortProducts, gallery, priceLabel, realOptions, shopifyImage } from '../lib/shop';

interface Props {
  /** On the shop page itself the heading is the page title. */
  page?: boolean;
}
const { page = false } = Astro.props;

// Products, prices, sizes and stock come from Shopify; our own photos are used where we have them.
let products: Product[] = [];
try {
  products = sortProducts(await getProducts());
} catch (e) {
  console.warn('Shopify niet bereikbaar, Oershop zonder producten gebouwd', e);
}
const price = priceLabel;
---

  <section class="section shop" id="shop">
    <div class="wrap">
      <div class="shop-head">
        {page ? <h1>Oershop.</h1> : <h2>Oershop.</h2>}
        <p class="lead">
          Truien, T-shirts, een pet, het Oerbier-mannetje, glazen en metalen borden met de bende erop. We versturen tot ver over
          de grens, of je haalt het gratis af in de Oerbar. Staat jouw land er bij het afrekenen niet tussen?
          <a href="mailto:info@dedollebrouwers.be">Mail ons even</a>.
        </p>
      </div>
      {
        products.length === 0 && (
          <p class="lead">
            De webshop is even niet bereikbaar. Bestellen kan via{' '}
            <a href="mailto:boniface@dedollebrouwers.be">boniface@dedollebrouwers.be</a>.
          </p>
        )
      }
      <div class="shop-grid">
        {
          products.map((p) =>
            p.handle === CUSTOM ? (
              <a class="shop-item shop-link" href="/oerbier-mannetje">
                <span class="maker-art" role="img" aria-label="Drie zelf samengestelde Oerbier-mannetjes in verschillende kleuren">
                  <MannetjeSvg class="m1" head="#f6bf1c" flag="be" text="jouw naam" />
                  <MannetjeSvg class="m2" head="#3d7bd4" arms="#f6bf1c" feet="#1f1b17" glass="#f6bf1c" scarf="#1f1b17" text="Jan 50" bril />
                  <MannetjeSvg class="m3" head="#f3a7c3" body="#f3a7c3" arms="#d6337f" feet="#c9a13b" scarf="#d6337f" text="Greta" strik />
                </span>
                <span class="cap">
                  <b>Stel je eigen mannetje samen →</b>
                  <span>{price(p)}</span>
                </span>
              </a>
            ) : (
              <figure class="shop-item" data-product={p.handle} data-variants={JSON.stringify(p.variants.nodes)}>
                <a class="photo" href={`/oershop/${p.handle}`} aria-label={`${p.title}: meer foto's en info`}>
                  {gallery(p.handle)[0] ? (
                    <Image src={gallery(p.handle)[0]} alt={p.featuredImage?.altText ?? p.title} width={700} />
                  ) : p.featuredImage ? (
                    <img src={shopifyImage(p.featuredImage.url, 700)} alt={p.featuredImage.altText ?? p.title} width="700" height="875" loading="lazy" />
                  ) : null}
                  {gallery(p.handle).length > 1 && <span class="more">{gallery(p.handle).length} foto's</span>}
                </a>
                <figcaption>
                  <span class="row">
                    <a class="name" href={`/oershop/${p.handle}`}>{p.title}</a>
                    <span class="price" data-price>{price(p)}</span>
                  </span>
                  <span class="buy">
                    {realOptions(p).map((o) => (
                      <select data-option={o.name} aria-label={o.name}>
                        {o.optionValues.map((v) => (
                          <option value={v.name}>{v.name}</option>
                        ))}
                      </select>
                    ))}
                    <button type="button" class="btn add" data-add disabled={!p.availableForSale}>
                      {p.availableForSale ? 'In mandje' : 'Uitverkocht'}
                    </button>
                  </span>
                </figcaption>
              </figure>
            ),
          )
        }
      </div>
    </div>
  </section>

<script>
  import '../lib/buy';
</script>

<style>
  /* OERSHOP */
  .shop {
    padding-bottom: 40px;
  }
  .shop-head {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 20px 60px;
    align-items: end;
    margin-bottom: 40px;
  }
  .shop-head .lead {
    margin: 0;
  }
  .shop-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  .shop-item {
    margin: 0;
    background: var(--paper-light);
    border: var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  figure.shop-item {
    display: flex;
    flex-direction: column;
  }
  figure.shop-item figcaption {
    flex: 1;
    align-content: space-between;
  }
  .shop-item :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .shop-item:hover :global(img) {
    transform: scale(1.04);
  }
  .shop-item figcaption {
    display: grid;
    gap: 10px;
    padding: 14px 18px 16px;
    border-top: var(--line);
  }
  .shop-item .photo {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .shop-item .more {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--paper-light);
    border: 2px solid var(--ink);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .shop-item .name {
    font-weight: 700;
    text-decoration: none;
  }
  .shop-item .name:hover {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 3px;
  }
  .shop-item .row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-family: var(--font-display);
  }
  .shop-item .price {
    font-style: italic;
    white-space: nowrap;
  }
  .shop-item .buy {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .shop-item select {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.45em 0.7em;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--paper);
    min-width: 0;
    flex: 1 1 110px;
  }
  .shop-item .add {
    font-size: 0.9rem;
    padding: 0.5em 1em;
    margin-left: auto;
  }
  .shop-item .add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }
  .shop-item figcaption.signs {
    flex-direction: column;
    gap: 4px;
  }
  .shop-item .signs .row {
    display: flex;
    justify-content: space-between;
    font-style: normal;
  }
  .shop-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .shop-link:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
  }
  .maker-art {
    display: block;
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--yellow-soft) var(--grain);
    overflow: hidden;
  }
  .maker-art :global(svg) {
    position: absolute;
    width: 62%;
    transition: transform 0.3s ease;
  }
  .maker-art :global(.m1) {
    left: 20%;
    top: 4%;
    z-index: 2;
  }
  .maker-art :global(.m2) {
    left: -8%;
    bottom: -2%;
    width: 52%;
    transform: rotate(-8deg);
  }
  .maker-art :global(.m3) {
    right: -8%;
    bottom: -2%;
    width: 52%;
    transform: rotate(8deg);
  }
  .shop-link:hover .maker-art :global(.m1) {
    transform: translateY(-6px) rotate(-3deg);
  }
  .shop-link .cap {
    flex: 1;
    align-items: flex-start;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 18px;
    border-top: var(--line);
    font-family: var(--font-display);
    background: var(--yellow);
  }
  .shop-link .cap > span {
    font-style: italic;
  }
  .shop-item .signs .list {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .shop-item .signs s {
    text-decoration-thickness: 2px;
  }

  .shop-head h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.95;
  }
  @media (max-width: 980px) {
    .shop-head {
      grid-template-columns: 1fr;
    }
    .shop-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .shop-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
