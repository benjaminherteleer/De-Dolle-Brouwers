---
/**
 * Light snowfall during the Stille Nacht period. Starts a week before the first weekend and stops
 * after the last day; add ?kerst to any address to preview it. No snow for visitors who prefer less motion.
 */
import data from '../data/stillenacht.json';
---

<canvas id="sneeuw" aria-hidden="true"></canvas>
<script is:inline define:vars={{ start: data.start, einde: data.einde }}>
  (function () {
    var d = new Date(start + 'T12:00:00Z');
    d.setUTCDate(d.getUTCDate() - 9);
    var vandaag = new Date().toISOString().slice(0, 10);
    var test = /[?&]kerst\b/.test(location.search);
    if (!test && (vandaag < d.toISOString().slice(0, 10) || vandaag > einde)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var c = document.getElementById('sneeuw');
    var x = c.getContext('2d');
    var w, h, vlokken = [];
    function maat() {
      w = c.width = innerWidth;
      h = c.height = innerHeight;
    }
    maat();
    addEventListener('resize', maat);
    var n = w < 700 ? 22 : 40;
    for (var i = 0; i < n; i++) vlokken.push({ x: Math.random() * w, y: Math.random() * h, r: 1.5 + Math.random() * 2.5, v: 0.4 + Math.random() * 0.8, f: Math.random() * 6.3 });
    function teken() {
      x.clearRect(0, 0, w, h);
      x.fillStyle = 'rgba(255,255,255,0.9)';
      x.strokeStyle = 'rgba(33,23,12,0.25)';
      vlokken.forEach(function (v) {
        v.y += v.v;
        v.f += 0.01;
        v.x += Math.sin(v.f) * 0.4;
        if (v.y > h + 5) { v.y = -5; v.x = Math.random() * w; }
        x.beginPath();
        x.arc(v.x, v.y, v.r, 0, 6.3);
        x.fill();
        x.stroke();
      });
      requestAnimationFrame(teken);
    }
    c.style.display = 'block';
    teken();
  })();
</script>

<style>
  #sneeuw {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 50;
  }
</style>
