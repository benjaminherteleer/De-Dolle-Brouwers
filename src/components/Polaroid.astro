---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  tilt?: number;
  ratio?: string;
  taped?: boolean;
  width?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, caption, tilt = -2, ratio = '4 / 5', taped = false, width = 700, class: cls = '', loading = 'lazy' } = Astro.props;
---

<figure class:list={['polaroid', { taped }, cls]} style={`--tilt:${tilt}deg; --ratio:${ratio};`}>
  <Image
    src={src}
    alt={alt}
    width={width}
    widths={[360, 540, width].filter((w, i, a) => w <= width && a.indexOf(w) === i)}
    sizes={`(max-width: 760px) 86vw, ${width}px`}
    loading={loading}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
