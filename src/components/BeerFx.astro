---
/**
 * A little scene behind each beer character, drawn after its label.
 * Plays while the parent `.fx-host` is hovered, or always with `live`.
 */
interface Props {
  slug: string;
  live?: boolean;
}

const { slug, live = false } = Astro.props;
const kind = slug.replace(/-reserva$/, '');

// deterministic "random" so builds stay stable
const rnd = (i: number, salt = 1) => {
  const x = Math.sin(i * 12.9898 + salt * 78.233) * 43758.5453;
  return x - Math.floor(x);
};
const many = (n: number) => Array.from({ length: n }, (_, i) => i);

const eggColors = ['#f6b1c3', '#a8d8f0', '#f9e27d', '#b9e4a6', '#d7b8f2', '#ffc58f'];
---

{
  kind === 'boskeun' && (
    <div class="scene" aria-hidden="true">
      <svg class="comb" viewBox="0 0 120 60" preserveAspectRatio="xMidYMin slice">
        <defs>
          <pattern id="honing-raat" width="15" height="26" patternUnits="userSpaceOnUse" patternTransform="scale(0.9)">
            <path d="M7.5 0 L15 4.3 V13 L7.5 17.3 L0 13 V4.3 Z M7.5 17.3 V26 M0 13 L-7.5 17.3 M15 13 L22.5 17.3" fill="none" stroke="#f7b500" stroke-width="1.6" />
          </pattern>
          <linearGradient id="honing-fade" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity="1" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </linearGradient>
          <mask id="honing-mask"><rect width="120" height="60" fill="url(#honing-fade)" /></mask>
        </defs>
        <rect width="120" height="60" fill="url(#honing-raat)" mask="url(#honing-mask)" opacity="0.55" />
      </svg>
      <svg class="drip" viewBox="0 0 200 40" preserveAspectRatio="none">
        <path
          d="M0 0 H200 V10 C192 10 190 14 190 22 C190 30 182 30 182 22 C182 14 176 12 168 12 C150 12 150 18 148 26 C146 36 136 36 136 26 C136 16 128 12 112 12 C96 12 94 16 92 20 C90 28 82 28 82 20 C82 14 72 11 60 11 C46 11 44 18 42 30 C40 40 30 40 30 30 C30 18 22 12 12 12 C4 12 0 14 0 14 Z"
          fill="#f7b500"
          stroke="#21170c"
          stroke-width="2"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        />
      </svg>
      <svg class="grass" viewBox="0 0 200 40" preserveAspectRatio="none">
        <path
          d="M0 40 V26 L6 14 L10 26 L16 8 L20 25 L27 16 L31 27 L38 6 L42 24 L49 14 L53 26 L60 10 L64 25 L71 17 L75 27 L82 5 L86 24 L93 15 L97 26 L104 9 L108 25 L115 16 L119 27 L126 7 L130 24 L137 14 L141 26 L148 10 L152 25 L159 17 L163 27 L170 6 L174 24 L181 15 L185 26 L192 9 L196 25 L200 18 V40 Z"
          fill="#2c7f36"
          stroke="#21170c"
          stroke-width="2"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        />
      </svg>
    </div>
  )
}

{
  kind === 'oeral' && (
    <div class="scene" aria-hidden="true">
      <svg class="sky" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
        <circle cx="18" cy="20" r="9" fill="#e2412b" stroke="#21170c" stroke-width="1.2" />
        <ellipse cx="18" cy="20" rx="15" ry="4" fill="none" stroke="#21170c" stroke-width="1.2" transform="rotate(-18 18 20)" />
        <circle cx="84" cy="14" r="4" fill="#fffdf7" stroke="#21170c" stroke-width="1" />
        <circle cx="70" cy="36" r="2.4" fill="#5b8fd6" stroke="#21170c" stroke-width="0.8" />
        {[
          [35, 10], [55, 22], [92, 40], [8, 44], [44, 34], [76, 54], [28, 58], [62, 8],
        ].map(([x, y]) => (
          <path d={`M${x} ${y - 2.2} L${x + 0.7} ${y - 0.7} L${x + 2.2} ${y} L${x + 0.7} ${y + 0.7} L${x} ${y + 2.2} L${x - 0.7} ${y + 0.7} L${x - 2.2} ${y} L${x - 0.7} ${y - 0.7} Z`} fill="#21170c" />
        ))}
      </svg>
      <svg class="mountains" viewBox="0 0 200 60" preserveAspectRatio="none">
        <path d="M0 60 V44 L22 26 L38 38 L62 12 L84 34 L104 20 L126 40 L150 16 L174 36 L190 28 L200 34 V60 Z" fill="#3d6fb8" stroke="#21170c" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
        <path d="M54 19 L62 12 L70 20 L65 18 L62 22 L58 18 Z M143 22 L150 16 L157 23 L153 21 L150 25 L147 21 Z" fill="#fffdf7" stroke="#21170c" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
        <path d="M0 60 V52 L30 42 L58 50 L92 38 L120 50 L150 44 L180 52 L200 46 V60 Z" fill="#2a4f8a" stroke="#21170c" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
      </svg>
    </div>
  )
}

<div class:list={['fx', `fx-${kind}`, { live }]} aria-hidden="true">
  {
    kind === 'stille-nacht' &&
      many(60).map((i) => (
        <span
          class="flake"
          style={`--x:${(rnd(i) * 100).toFixed(1)}%; --s:${(4 + rnd(i, 2) * 8).toFixed(1)}px; --d:${(3 + rnd(i, 3) * 4).toFixed(2)}s; --delay:-${(rnd(i, 4) * 6).toFixed(2)}s; --drift:${(rnd(i, 5) * 30 - 15).toFixed(0)}px`}
        />
      ))
  }

  {
    kind === 'boskeun' &&
      many(9).map((i) => (
        <svg
          class="egg"
          viewBox="0 0 30 38"
          style={`--x:${8 + i * 10.5}%; --delay:-${(rnd(i) * 2.4).toFixed(2)}s; --h:${(30 + rnd(i, 2) * 35).toFixed(0)}cqh; --r:${(rnd(i, 3) * 40 - 20).toFixed(0)}deg`}
        >
          <ellipse cx="15" cy="20" rx="13" ry="17" fill={eggColors[i % eggColors.length]} stroke="#21170c" stroke-width="2" />
          <path d="M3 18 l6 -4 6 4 6 -4 6 4" fill="none" stroke="#21170c" stroke-width="1.6" stroke-linejoin="round" />
          <circle cx="10" cy="27" r="2" fill="#21170c" /><circle cx="20" cy="27" r="2" fill="#21170c" />
        </svg>
      ))
  }

  {
    kind === 'oeral' &&
      many(14).map((i) => (
        <svg
          class="twinkle"
          viewBox="0 0 20 20"
          style={`--x:${(4 + rnd(i) * 90).toFixed(0)}%; --y:${(4 + rnd(i, 2) * 60).toFixed(0)}%; --s:${(10 + rnd(i, 3) * 12).toFixed(0)}px; --delay:-${(rnd(i, 4) * 2).toFixed(2)}s`}
        >
          <path d="M10 0 L12.5 7.5 L20 10 L12.5 12.5 L10 20 L7.5 12.5 L0 10 L7.5 7.5 Z" fill="#fffdf7" stroke="#21170c" stroke-width="1.5" stroke-linejoin="round" />
        </svg>
      ))
  }
  {
    kind === 'oeral' &&
      many(3).map((i) => (
        <svg class="comet" viewBox="0 0 60 20" style={`--y:${[12, 34, 22][i]}%; --d:${[4.5, 6, 5.2][i]}s; --delay:-${[0, 2.2, 3.8][i]}s`}>
          <path d="M4 10 H40" stroke="#21170c" stroke-width="1.5" stroke-dasharray="3 3" />
          <circle cx="48" cy="10" r="6" fill="#f7b500" stroke="#21170c" stroke-width="2" />
        </svg>
      ))
  }

  {
    kind === 'dulle-teve' &&
      many(6).map((i) => (
        <svg
          class="bolt"
          viewBox="0 0 40 80"
          style={`--x:${[6, 78, 14, 84, 46, 70][i]}%; --y:${[8, 12, 58, 55, 4, 78][i]}%; --delay:${(i * 0.37).toFixed(2)}s; --r:${[-14, 12, 8, -10, 3, -6][i]}deg; --s:${[1, 0.8, 0.7, 0.9, 0.6, 0.55][i]}`}
        >
          <path d="M24 2 L6 44 H20 L12 78 L36 30 H22 L32 2 Z" fill="#f7b500" stroke="#21170c" stroke-width="3" stroke-linejoin="round" />
        </svg>
      ))
  }

  {
    kind === 'oerbier' && (
      <>
        <svg class="rays" viewBox="-100 -100 200 200">
          {many(16).map((i) => (
            <path d={`M0 0 L${(Math.cos(((i * 22.5 - 5) * Math.PI) / 180) * 150).toFixed(1)} ${(Math.sin(((i * 22.5 - 5) * Math.PI) / 180) * 150).toFixed(1)} L${(Math.cos(((i * 22.5 + 5) * Math.PI) / 180) * 150).toFixed(1)} ${(Math.sin(((i * 22.5 + 5) * Math.PI) / 180) * 150).toFixed(1)}Z`} />
          ))}
        </svg>
        {many(14).map((i) => (
          <span
            class="bubble"
            style={`--x:${(10 + rnd(i) * 80).toFixed(1)}%; --s:${(6 + rnd(i, 2) * 12).toFixed(0)}px; --d:${(2.4 + rnd(i, 3) * 2.4).toFixed(2)}s; --delay:-${(rnd(i, 4) * 4).toFixed(2)}s`}
          />
        ))}
      </>
    )
  }

  {
    kind === 'arabier' &&
      many(10).map((i) => (
        <svg
          class="hop"
          viewBox="0 0 30 40"
          style={`--x:${(5 + rnd(i) * 90).toFixed(1)}%; --d:${(3.2 + rnd(i, 3) * 2.5).toFixed(2)}s; --delay:-${(rnd(i, 4) * 5).toFixed(2)}s; --r:${(rnd(i, 5) * 360).toFixed(0)}deg; --sz:${(20 + rnd(i, 2) * 16).toFixed(0)}px`}
        >
          <path d="M15 2 v6" stroke="#21170c" stroke-width="2" />
          <path d="M15 7 C 4 10, 3 26, 15 38 C 27 26, 26 10, 15 7 Z" fill="#9cc95a" stroke="#21170c" stroke-width="2" />
          <path d="M8 16 Q15 21 22 16 M7 23 Q15 28 23 23 M10 30 Q15 34 20 30" fill="none" stroke="#21170c" stroke-width="1.4" />
        </svg>
      ))
  }

  {
    kind === 'lichtervelds-blond' && (
      <div class="sea">
        {many(3).map((i) => (
          <svg class="wave" viewBox="0 0 400 40" preserveAspectRatio="none" style={`--i:${i}`}>
            <path d="M0 20 Q25 0 50 20 T100 20 T150 20 T200 20 T250 20 T300 20 T350 20 T400 20 V40 H0Z" />
          </svg>
        ))}
      </div>
    )
  }

  {
    kind === 'export-stout' &&
      many(5).map((i) => (
        <svg class="steam" viewBox="0 0 20 80" style={`--x:${14 + i * 18}%; --delay:-${(i * 0.7).toFixed(1)}s`}>
          <path d="M10 78 C 0 64, 20 52, 10 40 S 0 16, 10 2" fill="none" stroke="#fffdf7" stroke-width="4" stroke-linecap="round" />
        </svg>
      ))
  }
</div>

<style>
  /* Static backdrops, always visible behind the character */
  .scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .scene :global(svg) {
    position: absolute;
    left: 0;
    width: 100%;
  }
  .scene :global(.comb) {
    top: 0;
    height: 70%;
  }
  .scene :global(.drip) {
    top: 0;
    height: 16%;
  }
  .scene :global(.grass) {
    bottom: 0;
    height: 18%;
  }
  .scene :global(.sky) {
    inset: 0;
    height: 100%;
  }
  .scene :global(.mountains) {
    bottom: 0;
    height: 34%;
  }
  .fx {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .fx * {
    animation-play-state: paused;
  }
  :global(.fx-host:hover) .fx,
  :global(.fx-host:focus-visible) .fx,
  .fx.live {
    opacity: 1;
  }
  :global(.fx-host:hover) .fx *,
  :global(.fx-host:focus-visible) .fx *,
  .fx.live * {
    animation-play-state: running;
  }

  /* Stille Nacht: snow */
  .flake {
    position: absolute;
    top: -10px;
    left: var(--x);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 1.5px rgba(33, 23, 12, 0.35);
    animation: snow var(--d) linear infinite var(--delay);
  }
  @keyframes snow {
    to {
      transform: translate(var(--drift), 115cqh);
    }
  }

  /* Boskeun: easter eggs hopping up */
  .egg {
    position: absolute;
    bottom: -40px;
    left: var(--x);
    width: 30px;
    animation: hop 2.4s cubic-bezier(0.3, 0.7, 0.4, 1) infinite var(--delay);
  }
  @keyframes hop {
    0%,
    100% {
      transform: translateY(0) rotate(0);
    }
    45% {
      transform: translateY(calc(var(--h) * -1)) rotate(var(--r));
    }
    55% {
      transform: translateY(calc(var(--h) * -1)) rotate(var(--r));
    }
  }

  /* Oeral: stars and little comets, like the label */
  .twinkle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    animation: twinkle 1.8s ease-in-out infinite var(--delay);
  }
  @keyframes twinkle {
    0%,
    100% {
      transform: scale(0.4) rotate(0);
      opacity: 0.3;
    }
    50% {
      transform: scale(1) rotate(45deg);
      opacity: 1;
    }
  }
  .comet {
    position: absolute;
    top: var(--y);
    left: 100%;
    width: 70px;
    animation: comet var(--d) linear infinite var(--delay);
  }
  @keyframes comet {
    to {
      transform: translate(calc(-100cqw - 120px), 40px);
    }
  }

  /* Dulle Teve: lightning, like the label */
  .bolt {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(46px * var(--s));
    transform: rotate(var(--r));
    animation: flash 1.6s steps(1) infinite var(--delay);
  }
  @keyframes flash {
    0%,
    100% {
      opacity: 0;
    }
    8%,
    20% {
      opacity: 1;
    }
    12% {
      opacity: 0.2;
    }
  }

  /* Oerbier: sunburst and bubbles */
  .rays {
    position: absolute;
    inset: -30%;
    width: 160%;
    height: 160%;
    fill: rgba(255, 253, 247, 0.35);
    animation: spin 18s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .bubble {
    position: absolute;
    bottom: -20px;
    left: var(--x);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    border: 2px solid rgba(33, 23, 12, 0.55);
    background: rgba(255, 253, 247, 0.5);
    animation: rise var(--d) ease-in infinite var(--delay);
  }
  @keyframes rise {
    to {
      transform: translateY(-115cqh);
    }
  }

  /* Arabier: dry hopping */
  .hop {
    position: absolute;
    top: -40px;
    left: var(--x);
    width: var(--sz);
    animation: hopfall var(--d) linear infinite var(--delay);
  }
  @keyframes hopfall {
    from {
      transform: translateY(0) rotate(var(--r));
    }
    to {
      transform: translateY(115cqh) rotate(calc(var(--r) + 220deg));
    }
  }

  /* Lichtervelds Blond (De Hoop): waves under the anchor */
  .sea {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30%;
  }
  .wave {
    position: absolute;
    left: 0;
    bottom: calc(var(--i) * -8px);
    width: 200%;
    height: 60%;
    fill: rgba(44, 90, 160, calc(0.25 + var(--i) * 0.2));
    animation: wave calc(4s + var(--i) * 1.5s) linear infinite;
  }
  @keyframes wave {
    to {
      transform: translateX(-50%);
    }
  }

  /* Export Stout: coffee steam */
  .steam {
    position: absolute;
    bottom: 6%;
    left: var(--x);
    width: 18px;
    opacity: 0;
    animation: steam 3s ease-in-out infinite var(--delay);
  }
  @keyframes steam {
    0% {
      transform: translateY(20px) scaleY(0.6);
      opacity: 0;
    }
    40% {
      opacity: 0.8;
    }
    100% {
      transform: translateY(-60%) scaleY(1.1);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fx {
      display: none;
    }
  }
</style>
