---
import { getImage } from 'astro:assets';
import { getPlaces, placesIn, provincies, provincieIn } from '../lib/verkooppunten';
import { langOf } from '../i18n';
import mascot from '../assets/logo/logo-full.png';

const lang = langOf(Astro.url);
const en = lang === 'en';
const tr = (nl: string, enText: string) => (en ? enText : nl);

const raw = await getPlaces();
const prov = await provincies(raw);
const places = placesIn(raw, lang).map((p, i) => ({ ...p, i, prov: prov[i] ? provincieIn(prov[i], lang) : '' }));

type P = (typeof places)[number];
const group = (list: P[], key: (p: P) => string) =>
  Object.entries(list.reduce<Record<string, P[]>>((acc, p) => ((acc[key(p)] ??= []).push(p), acc), {})).sort(
    (a, b) => b[1].length - a[1].length,
  );
const byCountry = group(places, (p) => p.country).map(([country, list]) => ({
  country,
  list: list.sort((a, b) => a.city.localeCompare(b.city)),
  // Belgium is split up by province
  provs: list.some((p) => p.prov) ? group(list, (p) => p.prov).sort((a, b) => (a[0] === 'Overig' || a[0] === 'Other' ? 1 : b[0] === 'Overig' || b[0] === 'Other' ? -1 : b[1].length - a[1].length)) : null,
}));

const mascotImg = await getImage({ src: mascot, width: 120 });
const data = {
  places: places.map(({ name, city, country, lat, lng }) => ({ name, city, country, lat, lng })),
  mascot: mascotImg.src,
  route: tr('Route', 'Directions'),
};
---

<div class="kaart" data-kaart={JSON.stringify(data)}>
  <div class="map-frame">
    <div class="map" role="region" aria-label={tr('Kaart met de verkooppunten van De Dolle Brouwers', 'Map of places that serve or sell De Dolle Brouwers')}></div>
    <div class="presets" role="group" aria-label={tr('Inzoomen op', 'Zoom to')}>
      <button type="button" data-view="wereld">{tr('Wereld', 'World')}</button>
      <button type="button" data-view="europa">{tr('Europa', 'Europe')}</button>
      <button type="button" data-view="benelux">{tr('België & Nederland', 'Belgium & Netherlands')}</button>
      <button type="button" data-view="belgie" class="on">{tr('België', 'Belgium')}</button>
    </div>
  </div>

  <aside class="list">
    <p class="count"><strong>{places.length}</strong> {tr('adressen in', 'places in')} <strong>{byCountry.length}</strong> {tr('landen', 'countries')}</p>
    {
      byCountry.map(({ country, list, provs }, ci) => (
        <details open={ci < 2}>
          <summary>
            {country} <span>{list.length}</span>
          </summary>
          {provs ? (
            provs.map(([name, sub]) => (
              <div class="prov">
                <h4>
                  {name} <small>{sub.length}</small>
                </h4>
                <ul>
                  {sub
                    .sort((a, b) => a.city.localeCompare(b.city))
                    .map((p) => (
                      <li>
                        <button type="button" data-i={p.i}>
                          <b>{p.name}</b>
                          <small>{p.city}</small>
                        </button>
                      </li>
                    ))}
                </ul>
              </div>
            ))
          ) : (
            <ul>
              {list.map((p) => (
                <li>
                  <button type="button" data-i={p.i}>
                    <b>{p.name}</b>
                    <small>{p.city}</small>
                  </button>
                </li>
              ))}
            </ul>
          )}
        </details>
      ))
    }
  </aside>
</div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type Place = { name: string; city: string; country: string; lat: number; lng: number };
  const root = document.querySelector<HTMLElement>('.kaart')!;
  const { places, mascot, route } = JSON.parse(root.dataset.kaart!) as { places: Place[]; mascot: string; route: string };
  const ESEN: L.LatLngTuple = [51.0279, 2.9032];

  const map = L.map(root.querySelector<HTMLElement>('.map')!, { zoomControl: false, scrollWheelZoom: false, worldCopyJump: true });
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);
  L.control.zoom({ position: 'bottomright' }).addTo(map);
  // Scroll-wheel zoom only once someone clicks the map, so the page keeps scrolling normally
  map.on('click focus', () => map.scrollWheelZoom.enable());
  map.getContainer().addEventListener('mouseleave', () => map.scrollWheelZoom.disable());

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const markers = places.map((p) =>
    L.circleMarker([p.lat, p.lng], { radius: 8, color: '#21170c', weight: 2.5, fillColor: '#f7b500', fillOpacity: 1 })
      .bindPopup(
        `<strong>${esc(p.name)}</strong><span>${esc(p.city)}, ${esc(p.country)}</span>` +
          `<a href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(p.name + ' ' + p.city)}" target="_blank" rel="noopener">${route} ↗</a>`,
        { className: 'pin-card', closeButton: true },
      )
      .addTo(map),
  );
  L.marker(ESEN, {
    icon: L.divIcon({ className: 'esen-pin', html: `<img src="${mascot}" alt="" /><span>Esen</span>`, iconSize: [48, 50], iconAnchor: [24, 50] }),
    keyboard: false,
    zIndexOffset: 1000,
  }).addTo(map);

  const views: Record<string, L.LatLngBoundsExpression> = {
    wereld: L.latLngBounds(places.map((p) => [p.lat, p.lng] as L.LatLngTuple)).pad(0.05),
    europa: [[37, -11], [62, 27]],
    benelux: [[49.5, 2.5], [53.5, 7.2]],
    // Belgium: framed around the Belgian cafés (most are in the west)
    belgie: L.latLngBounds(places.filter((p) => /^Belgi/.test(p.country)).map((p) => [p.lat, p.lng] as L.LatLngTuple)).pad(0.12),
  };
  const buttons = root.querySelectorAll<HTMLButtonElement>('[data-view]');
  const setPreset = (name: string | null) => buttons.forEach((b) => b.classList.toggle('on', b.dataset.view === name));
  map.fitBounds(views.belgie);
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      map.closePopup();
      setPreset(b.dataset.view!);
      map.flyToBounds(views[b.dataset.view!], { duration: 0.8 });
    }),
  );
  map.on('dragstart', () => setPreset(null));

  const listButtons = root.querySelectorAll<HTMLButtonElement>('.list button');
  listButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const i = +b.dataset.i!;
      listButtons.forEach((x) => x.classList.toggle('on', x === b));
      setPreset(null);
      // On phones the list sits below the map: bring the map back into view
      if (matchMedia('(max-width: 960px)').matches) root.querySelector('.map-frame')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
      map.flyTo([places[i].lat, places[i].lng], 16, { duration: 0.8 });
      map.once('moveend', () => markers[i].openPopup());
    }),
  );
</script>

<style>
  .kaart {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 28px;
    align-items: start;
  }
  .map-frame {
    position: relative;
    border: var(--line);
    border-radius: 22px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    background: #dfe7e4;
    isolation: isolate;
  }
  .map {
    height: 640px;
    background: #dfe7e4;
  }
  /* Soften the street map so it sits with the paper look */
  .map :global(.leaflet-tile-pane) {
    filter: saturate(0.6) sepia(0.12);
  }
  .map :global(.esen-pin) {
    display: grid;
    justify-items: center;
  }
  .map :global(.esen-pin img) {
    width: 48px;
    height: auto;
    filter: drop-shadow(2px 2px 0 rgba(33, 23, 12, 0.35));
  }
  .map :global(.esen-pin span) {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
    text-shadow: 0 0 3px #fff, 0 0 3px #fff;
  }
  .map :global(.pin-card .leaflet-popup-content-wrapper) {
    background: var(--paper-light);
    border: 2px solid var(--ink);
    border-radius: 14px;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .map :global(.pin-card .leaflet-popup-tip) {
    background: var(--ink);
  }
  .map :global(.pin-card .leaflet-popup-content) {
    margin: 12px 30px 12px 14px;
    display: grid;
    gap: 2px;
    font-family: inherit;
  }
  .map :global(.pin-card strong) {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.1rem;
    line-height: 1.15;
  }
  .map :global(.pin-card span) {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-bottom: 4px;
  }
  .map :global(.pin-card a) {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink);
  }
  .map :global(.leaflet-control-zoom) {
    border: 2px solid var(--ink);
    border-radius: 12px;
    box-shadow: 3px 3px 0 var(--ink);
    overflow: hidden;
  }
  .map :global(.leaflet-control-zoom a) {
    background: var(--paper-light);
    color: var(--ink);
    font-family: var(--font-display);
  }
  .map :global(.leaflet-control-zoom a:hover) {
    background: var(--yellow);
  }

  .presets {
    position: absolute;
    left: 14px;
    top: 14px;
    z-index: 500;
    display: flex;
    flex-wrap: wrap;
    background: var(--paper-light);
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 3px;
    box-shadow: 3px 3px 0 var(--ink);
    max-width: calc(100% - 28px);
  }
  .presets button {
    font: inherit;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    border: 0;
    background: none;
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
    color: var(--ink);
  }
  .presets button.on,
  .presets button:hover {
    background: var(--yellow);
  }

  .list {
    background: var(--paper-light);
    border: var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow);
    padding: 18px 18px 8px;
    max-height: 640px;
    overflow: auto;
  }
  .count {
    font-size: 0.95rem;
    margin: 0 0 12px;
  }
  details {
    border-top: 1px solid rgba(33, 23, 12, 0.15);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 2px;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.15rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    font-size: 0.8rem;
    background: var(--yellow);
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    min-width: 28px;
    text-align: center;
    padding: 1px 8px;
  }
  .prov h4 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 6px 8px 2px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 650;
    font-style: italic;
    color: var(--ink-soft);
  }
  .prov h4 small {
    font-style: normal;
    font-size: 0.78rem;
  }
  details ul {
    list-style: none;
    margin: 0 0 10px;
    padding: 0;
  }
  details button {
    width: 100%;
    text-align: left;
    border: 0;
    background: none;
    padding: 7px 8px;
    border-radius: 8px;
    cursor: pointer;
    font: inherit;
    display: grid;
    color: var(--ink);
  }
  details button b {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.25;
  }
  details button small {
    color: var(--ink-soft);
    font-size: 0.82rem;
  }
  details button:hover,
  details button.on {
    background: var(--yellow-soft);
  }

  @media (max-width: 960px) {
    .kaart {
      grid-template-columns: 1fr;
    }
    .list {
      max-height: none;
    }
    .map {
      height: 70vh;
      max-height: 560px;
    }
  }
  @media (max-width: 560px) {
    .presets button {
      padding: 6px 10px;
      font-size: 0.8rem;
    }
  }
</style>
