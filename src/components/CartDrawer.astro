---
import { Image } from 'astro:assets';
import kar from '../assets/logo/mannetje-kar.png';
import { langOf, link } from '../i18n';

const en = langOf(Astro.url) === 'en';
---

<div class="cart-shade" id="cart-shade" hidden></div>
<aside class="cart" id="cart" aria-label={en ? 'Your cart' : 'Je mandje'} aria-hidden="true">
  <header class="cart-head">
    <Image src={kar} alt="" width={160} class="cart-kar" />
    <h2>{en ? 'Your cart' : 'Je mandje'}</h2>
    <button type="button" class="cart-close" id="cart-close" aria-label={en ? 'Close cart' : 'Mandje sluiten'}>×</button>
  </header>
  <ul class="cart-lines" id="cart-lines"></ul>
  <p class="cart-empty" id="cart-empty">
    {en ? 'Your cart is still empty. Have a look in the ' : 'Je mandje is nog leeg. Kijk eens in de '}<a href={link(en ? 'en' : 'nl', '/oershop')}>{en ? 'shop' : 'Oershop'}</a>.
  </p>
  <footer class="cart-foot" id="cart-foot" hidden>
    <p class="cart-total"><span>{en ? 'Subtotal' : 'Subtotaal'}</span><b id="cart-total"></b></p>
    <p class="cart-note">
      {en ? 'Shipping is calculated at the next step. Pick-up at the brewery taproom is free.' : 'Verzending reken je af bij de volgende stap. Afhalen in de Oerbar kan gratis.'}
    </p>
    <a class="btn dark cart-checkout" id="cart-checkout" href="#">{en ? 'Checkout →' : 'Afrekenen →'}</a>
  </footer>
</aside>

<script>
  import { loadCart, setQuantity, getCart, type Cart, type CartLine } from '../lib/cart';

  const TOESLAG = 'mannetje-extra';
  import { euro } from '../lib/shopify';

  const panel = document.getElementById('cart')!;
  const shade = document.getElementById('cart-shade')!;
  const list = document.getElementById('cart-lines')!;
  const empty = document.getElementById('cart-empty')!;
  const foot = document.getElementById('cart-foot')!;
  const total = document.getElementById('cart-total')!;
  const checkout = document.getElementById('cart-checkout') as HTMLAnchorElement;

  const en = document.documentElement.lang === 'en';
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const open = () => {
    panel.classList.add('open');
    panel.setAttribute('aria-hidden', 'false');
    shade.hidden = false;
  };
  const close = () => {
    panel.classList.remove('open');
    panel.setAttribute('aria-hidden', 'true');
    shade.hidden = true;
  };

  const draw = (cart: Cart | null) => {
    const lines = cart?.lines.nodes ?? [];
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
      el.textContent = String(cart?.totalQuantity ?? 0);
      el.closest<HTMLElement>('[data-cart-button]')!.hidden = !cart;
    });
    empty.hidden = lines.length > 0;
    foot.hidden = lines.length === 0;
    if (!cart) {
      list.innerHTML = '';
      return;
    }
    total.textContent = euro(cart.cost.subtotalAmount);
    // Shopify shows its checkout in English with locale=en
    checkout.href = en ? cart.checkoutUrl + (cart.checkoutUrl.includes('?') ? '&' : '?') + 'locale=en' : cart.checkoutUrl;
    const ontwerpVan = (l: CartLine) => l.attributes.find((a) => a.key === 'Ontwerp')?.value;
    // Each figure followed by its own surcharges
    const isToeslag = (l: CartLine) => l.merchandise.product.handle === TOESLAG;
    const geordend = lines.filter((l) => !isToeslag(l)).flatMap((l) => [l, ...lines.filter((x) => isToeslag(x) && ontwerpVan(l) && ontwerpVan(x) === ontwerpVan(l))]);
    geordend.push(...lines.filter((x) => !geordend.includes(x)));
    list.innerHTML = geordend
      .map((l) => {
        const m = l.merchandise;
        // Surcharges for a personalised figure: a fixed sub-line under the figure, no own controls
        if (m.product.handle === TOESLAG) {
          return `<li class="toeslag" data-line="${esc(l.id)}">
            <span class="ph plus">+</span>
            <div class="info"><b>${esc(m.title)}${l.quantity > 1 ? ` × ${l.quantity}` : ''}</b><small>${en ? 'for your figure' : 'voor je mannetje'}</small></div>
            <span class="price">${euro(l.cost.totalAmount)}</span>
          </li>`;
        }
        const heeftToeslag = ontwerpVan(l) && lines.some((x) => x.merchandise.product.handle === TOESLAG && ontwerpVan(x) === ontwerpVan(l));
        const variant = m.title === 'Default Title' ? '' : `<small>${esc(m.title)}</small>`;
        const extra = l.attributes.length
          ? `<details><summary>${en ? 'Your choices' : 'Jouw keuzes'}</summary><dl>${l.attributes
              .map((a) => `<dt>${esc(a.key)}</dt><dd>${/^https?:/.test(a.value) ? `<a href="${esc(a.value)}" target="_blank" rel="noopener">${en ? 'view' : 'bekijk'}</a>` : esc(a.value)}</dd>`)
              .join('')}</dl></details>`
          : '';
        return `<li data-line="${esc(l.id)}">
          ${m.image ? `<img src="${esc(m.image.url + (m.image.url.includes('?') ? '&' : '?') + 'width=160')}" alt="" width="64" height="64" />` : '<span class="ph"></span>'}
          <div class="info"><b>${esc(m.product.title)}</b>${variant}${extra}</div>
          ${
            heeftToeslag
              ? `<div class="qty"><button type="button" class="weg" data-remove aria-label="${en ? 'Remove' : 'Verwijderen'}">×</button></div>`
              : `<div class="qty">
            <button type="button" data-step="-1" aria-label="${en ? 'One less' : 'Eén minder'}">−</button>
            <span>${l.quantity}</span>
            <button type="button" data-step="1" aria-label="${en ? 'One more' : 'Eén meer'}">+</button>
          </div>`
          }
          <span class="price">${euro(l.cost.totalAmount)}</span>
        </li>`;
      })
      .join('');
  };

  list.addEventListener('click', async (e) => {
    // Removing a personalised figure also removes its surcharges
    const weg = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-remove]');
    if (weg) {
      const li = weg.closest<HTMLElement>('li')!;
      const all = getCart()?.lines.nodes ?? [];
      const line = all.find((l) => l.id === li.dataset.line);
      if (!line) return;
      const id = line.attributes.find((a) => a.key === 'Ontwerp')?.value;
      li.classList.add('busy');
      try {
        for (const x of all.filter((x) => x.merchandise.product.handle === TOESLAG && x.attributes.some((a) => a.key === 'Ontwerp' && a.value === id))) {
          await setQuantity(x.id, 0);
        }
        await setQuantity(line.id, 0);
      } catch {
        li.classList.remove('busy');
      }
      return;
    }
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-step]');
    if (!btn) return;
    const li = btn.closest<HTMLElement>('li')!;
    const line = getCart()?.lines.nodes.find((l) => l.id === li.dataset.line);
    if (!line) return;
    li.classList.add('busy');
    try {
      await setQuantity(line.id, line.quantity + Number(btn.dataset.step));
    } catch {
      li.classList.remove('busy');
    }
  });

  window.addEventListener('cart:change', (e) => draw((e as CustomEvent<Cart | null>).detail));
  window.addEventListener('cart:open', open);
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-cart-button]')) open();
  });
  document.getElementById('cart-close')!.addEventListener('click', close);
  shade.addEventListener('click', close);
  document.addEventListener('keydown', (e) => e.key === 'Escape' && close());

  loadCart();
</script>

<style>
  .cart-shade {
    position: fixed;
    inset: 0;
    background: rgba(33, 23, 12, 0.35);
    z-index: 200;
  }
  .cart {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(420px, 100vw);
    background: var(--paper) var(--grain);
    border-left: var(--line);
    z-index: 201;
    display: flex;
    flex-direction: column;
    transform: translateX(105%);
    transition: transform 0.3s ease;
    visibility: hidden;
  }
  .cart.open {
    transform: none;
    visibility: visible;
  }
  .cart-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    border-bottom: var(--line);
  }
  .cart-head :global(.cart-kar) {
    width: 64px;
    height: auto;
  }
  .cart-head h2 {
    font-size: 1.7rem;
    margin: 0;
    flex: 1;
  }
  .cart-close {
    font: inherit;
    font-size: 2rem;
    line-height: 1;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--ink);
  }
  .cart-lines {
    list-style: none;
    margin: 0;
    padding: 6px 20px;
    overflow: auto;
    flex: 1;
  }
  .cart-lines :global(li) {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    grid-template-areas: 'img info price' 'img qty qty';
    gap: 6px 12px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(33, 23, 12, 0.15);
  }
  .cart-lines :global(li.toeslag) {
    padding: 6px 0;
    grid-template-areas: 'img info price';
  }
  .cart-lines :global(.ph.plus) {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    justify-self: center;
    font-weight: 700;
  }
  .cart-lines :global(.weg) {
    font-size: 1.2rem;
  }
  .cart-lines :global(li.busy) {
    opacity: 0.5;
  }
  .cart-lines :global(img),
  .cart-lines :global(.ph) {
    grid-area: img;
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 10px;
    border: 2px solid var(--ink);
    background: var(--paper-light);
  }
  .cart-lines :global(.info) {
    grid-area: info;
    display: grid;
    gap: 2px;
  }
  .cart-lines :global(.info small) {
    color: var(--ink-soft);
  }
  .cart-lines :global(details) {
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
  .cart-lines :global(dl) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 8px;
    margin: 6px 0 0;
  }
  .cart-lines :global(dd) {
    margin: 0;
  }
  .cart-lines :global(.qty) {
    grid-area: qty;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cart-lines :global(.qty button) {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--paper-light);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .cart-lines :global(.price) {
    grid-area: price;
    font-family: var(--font-display);
    font-weight: 650;
  }
  .cart-empty {
    padding: 24px 20px;
    color: var(--ink-soft);
  }
  .cart-foot {
    padding: 18px 20px 22px;
    border-top: var(--line);
    background: var(--paper-light);
  }
  .cart-total {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 6px;
  }
  .cart-note {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0 0 14px;
  }
  .cart-checkout {
    display: block;
    text-align: center;
  }
</style>
