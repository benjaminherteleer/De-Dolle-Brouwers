---
import { Image } from 'astro:assets';
import mascot from '../assets/logo/logo-full.png';
import wordmark from '../assets/logo/ddb-wordmark.png';
import kar from '../assets/logo/mannetje-kar.png';
import { langOf, link, counterpart } from '../i18n';

interface Props {
  back?: { href: string; label: string };
}

const { back } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '');
const lang = langOf(Astro.url);
const en = lang === 'en';
const L = (href: string) => link(lang, href);

const links = [
  { href: L('/#bieren'), label: en ? 'Beers' : 'Bieren' },
  { href: L('/brouwerij'), label: en ? 'Visit' : 'Bezoek' },
  { href: L('/verhaal'), label: en ? 'Our story' : 'Ons verhaal' },
  { href: L('/brouwproces'), label: en ? 'Brewing' : 'Brouwproces' },
  { href: L('/oershop'), label: en ? 'Shop' : 'Oershop' },
  { href: L('/nieuws'), label: en ? 'News' : 'Nieuws' },
  { href: L('/verkooppunten-kaart'), label: en ? 'Where to drink' : 'Verkooppunten' },
];
const faq = L('/faq');
const contact = L('/contact');
// Language switch: same page in the other language, else that language's home page
const switchTo = counterpart(path) ?? (en ? '/' : '/en');
---

<header class="site-nav">
  <div class="bar">
    <a class="brand" href={en ? '/en' : '/'} aria-label={en ? 'De Dolle Brouwers, home' : 'De Dolle Brouwers, naar de homepage'}>
      <Image src={mascot} alt="" width={96} class="brand-mascot" loading="eager" />
      <span class="brand-word"><Image src={wordmark} alt="De Dolle Brouwers" width={200} loading="eager" /></span>
    </a>

    {
      back ? (
        <a class="back" href={back.href} set:html={back.label} />
      ) : (
        <>
          <input type="checkbox" id="navToggle" class="toggle" />
          <label for="navToggle" class="burger" aria-label="Menu">
            <span />
            <span />
            <span />
          </label>
          <nav class="menu" aria-label={en ? 'Main menu' : 'Hoofdmenu'}>
            <ul>
              {links.map((l) => (
                <li>
                  <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
            <div class="extra">
              <a href={faq} aria-current={path === faq ? 'page' : undefined}>{en ? 'FAQ' : 'Veelgestelde vragen'}</a>
              <a href={contact} aria-current={path === contact ? 'page' : undefined}>Contact</a>
            </div>
            <a class="kris" href="https://www.krisherteleer.com/nl" target="_blank" rel="noopener">Kris Herteleer ↗</a>
          </nav>
          <a class="lang" href={switchTo} hreflang={en ? 'nl' : 'en'} lang={en ? 'nl' : 'en'} aria-label={en ? 'Nederlands' : 'English'}>
            {en ? 'NL' : 'EN'}
          </a>
          <button type="button" class="cart-btn" data-cart-button hidden aria-label={en ? 'Open cart' : 'Mandje openen'}>
            <Image src={kar} alt="" width={80} loading="eager" />
            <span data-cart-count>0</span>
          </button>
          <a class="btn cta" href={L('/brouwerij')}>
            {en ? 'Visit us →' : 'Kom langs →'}
          </a>
        </>
      )
    }
  </div>
</header>

<script>
  // Slide the bar away while scrolling down, bring it back when scrolling up.
  // --nav-offset tells other sticky bars (like the brewing steps) where to sit.
  const nav = document.querySelector<HTMLElement>('.site-nav')!;
  const root = document.documentElement;
  const toggle = document.getElementById('navToggle') as HTMLInputElement | null;
  const setHeight = () => root.style.setProperty('--nav-h', `${nav.offsetHeight}px`);
  setHeight();
  addEventListener('resize', setHeight);
  let last = scrollY;
  let ticking = false;
  addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = scrollY;
        const down = y > last + 4;
        const up = y < last - 4;
        if (y < nav.offsetHeight + 20 || up || toggle?.checked) root.classList.remove('nav-up');
        else if (down) root.classList.add('nav-up');
        if (down || up) last = y;
        ticking = false;
      });
    },
    { passive: true },
  );
</script>

<style>
  :global(:root) {
    --nav-offset: var(--nav-h, 70px);
  }
  :global(html.nav-up) {
    --nav-offset: 0px;
  }
  :global(html.nav-up) .site-nav {
    transform: translateY(-100%);
  }
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    transition: transform 0.3s ease;
    background: var(--paper) var(--grain);
    border-bottom: var(--line);
  }
  .bar {
    max-width: 1320px;
    margin: 0 auto;
    padding: 10px var(--gutter);
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand :global(.brand-mascot) {
    width: 46px;
    height: auto;
    transition: transform 0.25s ease;
  }
  .brand:hover :global(.brand-mascot) {
    transform: rotate(-12deg) scale(1.08);
  }
  .brand-word {
    background: var(--yellow);
    border: 2px solid var(--ink);
    border-radius: 8px;
    padding: 4px 8px;
    transform: rotate(-3deg);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .brand-word :global(img) {
    width: 92px;
  }
  .menu {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-left: auto;
  }
  .menu ul {
    list-style: none;
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
  }
  .menu ul a {
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 700;
    font-variation-settings: 'SOFT' 0;
    font-size: 1.05rem;
    text-decoration: none;
    padding: 4px 2px;
    background: linear-gradient(var(--yellow), var(--yellow)) left bottom / 0 40% no-repeat;
    transition: background-size 0.2s ease;
  }
  .menu ul a:hover,
  .menu ul a[aria-current='page'] {
    background-size: 100% 40%;
  }
  .cart-btn {
    position: relative;
    display: flex;
    align-items: center;
    background: none;
    border: 0;
    padding: 0 6px 0 0;
    cursor: pointer;
  }
  .cart-btn[hidden] {
    display: none;
  }
  .cart-btn :global(img) {
    display: block;
    flex-shrink: 0;
    height: 46px;
    width: 38px;
    max-width: none;
    transition: transform 0.2s ease;
  }
  .cart-btn:hover :global(img) {
    transform: rotate(-6deg);
  }
  .cart-btn span {
    position: absolute;
    top: -2px;
    right: -4px;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    border-radius: 11px;
    background: var(--yellow);
    border: 2px solid var(--ink);
    font-weight: 700;
    font-size: 0.8rem;
    display: grid;
    place-items: center;
  }
  .cta {
    font-size: 0.95rem;
    padding: 0.55em 1.1em;
    white-space: nowrap;
  }
  .kris {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    text-decoration: none;
    white-space: nowrap;
  }
  @media (min-width: 1281px) and (max-width: 1500px) {
    .menu > .kris {
      display: none;
    }
  }
  .kris:hover {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 3px;
  }
  .lang {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.25em 0.6em;
    line-height: 1;
  }
  .lang:hover {
    background: var(--yellow);
  }
  /* FAQ and contact: only in the phone menu (they are in the footer on large screens) */
  .extra {
    display: none;
  }
  .back {
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }
  .toggle,
  .burger {
    display: none;
  }

  @media (min-width: 1121px) and (max-width: 1280px) {
    .bar {
      gap: 16px;
    }
    .menu,
    .menu ul {
      gap: 14px;
    }
    .menu ul a {
      font-size: 0.95rem;
    }
    .kris {
      display: none;
    }
  }
  /* Phones with something in the cart: logo, EN, cart, button and menu don't all fit, so the button gives way */
  @media (max-width: 480px) {
    .bar:has(.cart-btn:not([hidden])) .cta {
      display: none;
    }
  }
  @media (max-width: 400px) {
    .bar {
      gap: 6px;
    }
    .cta {
      padding: 0.5em 0.7em;
      font-size: 0.8rem;
    }
    /* Small phones: the wordmark alone, so the language switch, cart and button still fit */
    .brand :global(.brand-mascot) {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .bar {
      gap: 10px;
    }
    .brand :global(.brand-mascot) {
      width: 36px;
    }
    .brand-word :global(img) {
      width: 70px;
    }
  }
  @media (max-width: 1120px) {
    .lang {
      margin-left: auto;
    }
    .cart-btn,
    .cta {
      margin-left: 0;
    }
    .cta {
      font-size: 0.85rem;
      padding: 0.5em 0.9em;
    }
    .burger {
      order: 3;
      display: flex;
      flex-direction: column;
      gap: 5px;
      width: 44px;
      height: 44px;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      border: var(--line);
      border-radius: 10px;
      background: var(--yellow);
      box-shadow: 3px 3px 0 var(--ink);
    }
    .burger span {
      display: block;
      width: 20px;
      height: 3px;
      background: var(--ink);
      border-radius: 2px;
    }
    .menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      padding: 24px var(--gutter) 30px;
      background: var(--paper);
      border-bottom: var(--line);
    }
    .menu ul {
      flex-direction: column;
      gap: 12px;
    }
    .menu ul a {
      font-size: 1.6rem;
    }
    .toggle:checked ~ .menu {
      display: flex;
    }
    .extra {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 22px;
      padding-top: 16px;
      border-top: 2px solid var(--ink);
    }
    .extra a {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.15rem;
      text-decoration: none;
    }
    .extra a[aria-current='page'] {
      background: linear-gradient(var(--yellow), var(--yellow)) left bottom / 100% 40% no-repeat;
    }
  }
</style>
