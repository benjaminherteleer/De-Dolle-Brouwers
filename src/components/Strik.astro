---
/** The polka-dot bow from the bottle neck label, in the colour of each beer. */
interface Props {
  color: string;
  class?: string;
}
const { color, class: cls = '' } = Astro.props;
const id = `dots-${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox="0 0 160 76" class:list={['strik', cls]} aria-hidden="true">
  <defs>
    <pattern id={id} width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(20)">
      <rect width="9" height="9" fill={color}></rect>
      <circle cx="4.5" cy="4.5" r="1.3" fill="#fbfaf5"></circle>
    </pattern>
  </defs>
  <!-- black neck band behind the bow -->
  <path d="M4 18 Q80 40 156 18 L150 50 Q80 72 10 50 Z" fill="#1f1b17"></path>
  <!-- wings -->
  <path d="M78 38 L20 10 Q8 30 18 62 Z" fill={`url(#${id})`} stroke="#1f1b17" stroke-width="3" stroke-linejoin="round"></path>
  <path d="M82 38 L140 10 Q152 30 142 62 Z" fill={`url(#${id})`} stroke="#1f1b17" stroke-width="3" stroke-linejoin="round"></path>
  <!-- folds -->
  <path d="M40 30 L70 38 M42 48 L70 40 M120 30 L90 38 M118 48 L90 40" stroke="#1f1b17" stroke-width="2" fill="none" stroke-linecap="round"></path>
  <!-- knot -->
  <rect x="68" y="26" width="24" height="26" rx="7" fill={`url(#${id})`} stroke="#1f1b17" stroke-width="3"></rect>
</svg>
