---
import type { ImageMetadata } from 'astro';
import Polaroid from '../Polaroid.astro';

/** Kris's handwritten original, shown next to a short note. */
interface Props {
  foto: ImageMetadata;
  fotoAlt: string;
  bijschrift?: string;
}
const { foto, fotoAlt, bijschrift } = Astro.props;
---

<section class="origineel">
  <Polaroid src={foto} alt={fotoAlt} caption={bijschrift} tilt={-3} ratio="auto" width={420} taped />
  <div><slot /></div>
</section>

<style>
  .origineel {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(24px, 5vw, 56px);
    align-items: center;
    padding: clamp(36px, 5vw, 60px) clamp(20px, 5vw, 56px);
    border-top: 2px solid var(--ink);
  }
  .origineel :global(p:first-child) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin: 0 0 6px;
  }
  .origineel :global(p) {
    color: var(--ink-soft);
    margin: 0;
  }
  @media (max-width: 640px) {
    .origineel {
      grid-template-columns: 1fr;
    }
  }
</style>
