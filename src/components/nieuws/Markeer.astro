---
/** Yellow marker over a few words, as in the printed edition. */
---

<mark class="markeer"><slot /></mark>

<style>
  .markeer {
    background: linear-gradient(transparent 45%, var(--yellow) 45% 92%, transparent 92%);
    color: inherit;
    padding: 0 0.1em;
  }
  :global(.donker) .markeer {
    background: var(--yellow);
    color: var(--ink);
    font-weight: 700;
    padding: 0.1em 0.4em;
  }
</style>
