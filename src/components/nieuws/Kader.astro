---
/** Boxed side story inside an article. */
interface Props {
  titel?: string;
}
const { titel } = Astro.props;
---

<aside class="kader">
  {titel && <p class="kader-titel" set:html={titel} />}
  <slot />
</aside>

<style>
  .kader {
    margin: 1.6em 0 0.4em;
    padding: 22px 24px 8px;
    border: var(--line);
    border-radius: 16px;
    background: var(--paper-light);
    box-shadow: var(--shadow);
  }
  .kader-titel {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-soft);
    margin: 0 0 0.8em;
  }
</style>
