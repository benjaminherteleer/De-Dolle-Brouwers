---
/** The "for sale" box at the end of an edition, styled like a newspaper ad. */
interface Props {
  titel: string;
  sub?: string;
  items: { naam: string; detail?: string; prijs: string }[];
  noot?: string;
}
const { titel, sub, items, noot } = Astro.props;
---

<section class="prijzen" id="tekoop">
  <div class="advertentie">
    <h2 set:html={titel} />
    {sub && <p class="sub" set:html={sub} />}
    <ul>
      {
        items.map((i) => (
          <li>
            <span>
              <b>{i.naam}</b>
              {i.detail && <> · {i.detail}</>}
            </span>
            <span class="prijs">{i.prijs}</span>
          </li>
        ))
      }
    </ul>
    {noot && <p class="noot" set:html={noot} />}
    <p class="open">
      Open: <b>zaterdag &amp; zondag, 14:00 – 19:00</b><br />Roeselarestraat 12B, 8600 Esen
    </p>
  </div>
</section>

<style>
  .prijzen {
    padding: clamp(36px, 5vw, 60px) clamp(20px, 5vw, 56px);
    background: var(--yellow) var(--grain);
    border-top: 2px solid var(--ink);
  }
  h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    margin: 0;
  }
  .sub {
    font-style: italic;
    margin: 6px 0 20px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 6px 20px;
    background: var(--paper-light);
    border: var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow);
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 2px dashed rgba(33, 23, 12, 0.25);
  }
  li:last-child {
    border-bottom: 0;
  }
  .prijs {
    font-family: var(--font-display);
    font-weight: 700;
    white-space: nowrap;
  }
  .noot {
    display: inline-block;
    margin: 18px 0 0;
    padding: 4px 10px;
    background: var(--ink);
    color: var(--yellow);
    font-weight: 700;
  }
  .open {
    margin: 18px 0 0;
  }
</style>
