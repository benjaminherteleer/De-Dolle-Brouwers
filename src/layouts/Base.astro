---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Reveal from '../components/Reveal.astro';
import MailHulp from '../components/MailHulp.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import deelfoto from '../assets/foto/terras-lucht.jpg';
import { langOf, counterpart } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Replace the full menu with a single back link. */
  back?: { href: string; label: string };
  /** Picture shown when the page is shared (WhatsApp, Facebook…); a full URL or a local image. */
  image?: ImageMetadata | string;
}

const { title, description, back, image = deelfoto } = Astro.props;
// One canonical URL per page, always on the main domain and without .html
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = /^\/404\b/.test(path) ? undefined : new URL(path, Astro.site).href;
const lang = langOf(Astro.url);
const other = canonical ? counterpart(path) : undefined;
const alternates = other
  ? lang === 'nl'
    ? { nl: canonical!, en: new URL(other, Astro.site).href }
    : { nl: new URL(other, Astro.site).href, en: canonical! }
  : undefined;
const shareImage = new URL(
  typeof image === 'string' ? image : (await getImage({ src: image, width: 1200, format: image.format === 'png' ? 'png' : 'jpg' })).src,
  Astro.site,
).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Light design only: stops phones (Samsung, Chrome dark mode) from darkening yellow into brown -->
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content="#f7b500" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="nl" href={alternates.nl} />
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="x-default" href={alternates.nl} />
        </>
      )
    }
    <meta property="og:site_name" content="De Dolle Brouwers" />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'nl_BE'} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <!-- Fraunces is served from our own domain (public/fonts), so text doesn't wait on Google Fonts -->
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face {
      font-family: 'Fraunces';
      font-style: italic;
      font-weight: 300 900;
      font-display: swap;
      src: url(/fonts/fraunces-italic-latin-ext.woff2) format('woff2');
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
      font-family: 'Fraunces';
      font-style: italic;
      font-weight: 300 900;
      font-display: swap;
      src: url(/fonts/fraunces-italic-latin.woff2) format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
      font-family: 'Fraunces';
      font-style: normal;
      font-weight: 300 900;
      font-display: swap;
      src: url(/fonts/fraunces-latin-ext.woff2) format('woff2');
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
      font-family: 'Fraunces';
      font-style: normal;
      font-weight: 300 900;
      font-display: swap;
      src: url(/fonts/fraunces-latin.woff2) format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>
  </head>
  <body>
    <Nav back={back} />
    <main>
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <Reveal />
    <MailHulp />
    <!-- Cloudflare Web Analytics: visitor counts without cookies -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "d4a5c1b3f9a3484bbc620b8fd47b72b7"}'></script>
  </body>
</html>
