---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Reveal from '../components/Reveal.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import deelfoto from '../assets/foto/terras-lucht.jpg';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Replace the full menu with a single back link. */
  back?: { href: string; label: string };
  /** Picture shown when the page is shared (WhatsApp, Facebook…); a full URL or a local image. */
  image?: ImageMetadata | string;
}

const { title, description, back, image = deelfoto } = Astro.props;
const shareImage = new URL(
  typeof image === 'string' ? image : (await getImage({ src: image, width: 1200, format: 'jpg' })).src,
  Astro.site,
).href;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="De Dolle Brouwers" />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav back={back} />
    <main>
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <Reveal />
  </body>
</html>
