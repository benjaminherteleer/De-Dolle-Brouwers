---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Reveal from '../components/Reveal.astro';
import MailHulp from '../components/MailHulp.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import deelfoto from '../assets/foto/terras-lucht.jpg';
import { langOf, counterpart } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Replace the full menu with a single back link. */
  back?: { href: string; label: string };
  /** Picture shown when the page is shared (WhatsApp, Facebook…); a full URL or a local image. */
  image?: ImageMetadata | string;
}

const { title, description, back, image = deelfoto } = Astro.props;
// One canonical URL per page, always on the main domain and without .html
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = /^\/404\b/.test(path) ? undefined : new URL(path, Astro.site).href;
const lang = langOf(Astro.url);
const other = canonical ? counterpart(path) : undefined;
const alternates = other
  ? lang === 'nl'
    ? { nl: canonical!, en: new URL(other, Astro.site).href }
    : { nl: new URL(other, Astro.site).href, en: canonical! }
  : undefined;
const shareImage = new URL(
  typeof image === 'string' ? image : (await getImage({ src: image, width: 1200, format: 'jpg' })).src,
  Astro.site,
).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Light design only: stops phones (Samsung, Chrome dark mode) from darkening yellow into brown -->
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content="#f7b500" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="nl" href={alternates.nl} />
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="x-default" href={alternates.nl} />
        </>
      )
    }
    <meta property="og:site_name" content="De Dolle Brouwers" />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'nl_BE'} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav back={back} />
    <main>
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <Reveal />
    <MailHulp />
  </body>
</html>
